{%- comment -%}
  Authentic Retro TV Newsletter Modal Popup & Peeking Bottle
  Faithfully ported from client/src/components/layout/NewsletterModal.jsx & NewsletterModal.module.css
{%- endcomment -%}

<div id="RetroNewsletterModal" class="retro-modal-overlay" role="dialog" aria-modal="true" aria-label="Get 10% Off Promotion">
  <div class="retro-modal-stage">
    <!-- Top Peeking Bottle behind TV -->
    <div class="peeking-bottle">
      <img
        src="{{ 'USASQUIZYYFRONTcopy.jpg' | asset_url }}"
        alt="Squizyy Bottle"
        class="peeking-bottle-img"
        width="500"
        height="500"
        loading="lazy"
      >
    </div>

    <!-- TV Frame Stage -->
    <div class="tv-frame">
      <!-- Close Button on top-right -->
      <button type="button" id="RetroModalClose" class="retro-tv-close-btn" aria-label="Close dialog">✕</button>

      <!-- TV Screen Cutout Area (Form sits directly inside the screen) -->
      <div class="screen-cutout">
        <!-- Vintage Scanlines Overlay -->
        <div class="screen-scanlines"></div>

        <div class="screen-form-box">
          <h2 class="screen-title">GET 10% OFF YOUR FIRST SQUEEZE</h2>
          <p class="screen-subtitle">Join for new drops, exclusive deals and dangerously good peanut butter content.</p>

          {% form 'customer', class: 'retro-newsletter-form' %}
            <input type="hidden" name="contact[tags]" value="newsletter,popup">
            {%- if form.posted_successfully? -%}
              <div class="screen-success-box">
                <div class="screen-success-emoji">🎉</div>
                <h3 class="screen-success-title">YOU'RE IN!</h3>
                <div class="screen-discount-pill">
                  <span>USE CODE: <strong>WELCOME10</strong></span>
                  <button type="button" class="screen-copy-btn" onclick="navigator.clipboard.writeText('WELCOME10'); this.innerText='COPIED!';">COPY</button>
                </div>
                <p class="screen-fine-print">Copy code at checkout to save 10%.</p>
              </div>
            {%- else -%}
              {%- if form.errors -%}
                <p class="screen-form-error">{{ form.errors | default_errors }}</p>
              {%- endif -%}
              <div class="screen-form-fields">
                <input
                  type="email"
                  name="contact[email]"
                  placeholder="Email Address"
                  required
                  class="screen-input"
                  aria-label="Email Address"
                >
                <button type="submit" class="screen-submit-btn">GIVE ME 10% OFF!</button>
              </div>
              <button type="button" class="screen-dismiss-btn" id="RetroModalDismiss">NOT RIGHT NOW</button>
              <p class="screen-fine-print">Get 10% off on your first order. By subscribing you agree to receive marketing communications.</p>
            {%- endif -%}
          {% endform %}
        </div>
      </div>

      <!-- Vintage TV Graphic Overlay Frame -->
      <div class="tv-graphic-overlay">
        <img
          src="{{ 'story-tv.png' | asset_url }}"
          alt="Retro Squizyy TV"
          class="tv-graphic-img"
          width="1500"
          height="1065"
          loading="lazy"
        >
      </div>
    </div>
  </div>
</div>

<!-- Docked Bottom-Left Newsletter Launcher Tab (Authentic Squizyy UI) -->
<div class="newsletter-launcher-wrap">
  <button type="button" id="NewsletterLauncher" class="newsletter-launcher-tab" aria-label="Get 10% Off">
    <img src="{{ 'mascot-tiny_aecd74eb-a0fc-47ff-bf37-7ce347d869a5.svg' | asset_url }}" alt="" class="launcher-tab-mascot" width="16" height="22">
    <span class="launcher-tab-text">Get 10% Off</span>
  </button>
</div>

