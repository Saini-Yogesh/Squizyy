{%- comment -%}
  Retro TV Newsletter Modal Popup & Peeking Mascot Launcher
{%- endcomment -%}

<div id="RetroNewsletterModal" class="retro-modal-overlay">
  <div class="retro-modal-card">
    <button type="button" id="RetroModalClose" class="retro-modal-close" aria-label="Close modal">✕</button>
    
    <!-- TV Mascot Frame -->
    <div class="retro-tv-screen">
      <img src="{{ 'story-tv.png' | asset_url }}" alt="Retro Drizzy TV" class="retro-tv-img" width="1500" height="1065" loading="lazy">
    </div>

    <div class="retro-modal-body">
      <h3 class="retro-modal-title">Get 10% Off Your First Drizzle</h3>
      <p class="retro-modal-desc">
        Drop your email below for 10% off your first order, secret recipes, and early access to drops.
      </p>

      {% form 'customer', class: 'retro-newsletter-form' %}
        <input type="hidden" name="contact[tags]" value="newsletter,popup">
        {% if form.posted_successfully? %}
          <p class="retro-form-success">🎉 Sweet! Check your email for your 10% discount code.</p>
        {% else %}
          {% if form.errors %}
            <p class="retro-form-error">{{ form.errors | default_errors }}</p>
          {% endif %}
          <div class="retro-form-input-wrap">
            <input
              type="email"
              name="contact[email]"
              placeholder="Enter your email"
              required
              class="retro-form-input"
            >
            <button type="submit" class="button-primary retro-form-submit">Claim 10% Off</button>
          </div>
        {% endif %}
      {% endform %}
    </div>
  </div>
</div>

<!-- Docked Bottom-Left Newsletter Launcher Tab (Authentic Drizzy UI) -->
<div class="newsletter-launcher-wrap">
  <button type="button" id="NewsletterLauncher" class="newsletter-launcher-tab" aria-label="Get 10% Off">
    <img src="{{ 'mascot-tiny_aecd74eb-a0fc-47ff-bf37-7ce347d869a5.svg' | asset_url }}" alt="" class="launcher-tab-mascot" width="16" height="22">
    <span class="launcher-tab-text">Get 10% Off</span>
  </button>
</div>

<style>
.retro-modal-overlay {
  position: fixed;
  inset: 0;
  background-color: rgba(45, 15, 40, 0.7);
  backdrop-filter: blur(6px);
  z-index: 10000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1rem;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.3s ease, visibility 0.3s ease;
}
.retro-modal-overlay.active {
  opacity: 1;
  visibility: visible;
}
.retro-modal-card {
  position: relative;
  background-color: var(--color-cream, #fffbf2);
  border: 4px solid var(--color-foreground, #2d0f28);
  border-radius: var(--radius-2xl);
  box-shadow: 0 16px 0 var(--color-foreground, #2d0f28);
  max-width: 480px;
  width: 100%;
  padding: 2.5rem 2rem 2rem;
  text-align: center;
}
.retro-modal-close {
  position: absolute;
  top: 1rem;
  right: 1rem;
  background-color: var(--color-accent-purple, #ca9af1);
  border: 2px solid var(--color-foreground, #2d0f28);
  border-radius: var(--radius-full);
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 900;
  cursor: pointer;
}
.retro-tv-screen {
  max-width: 180px;
  margin: 0 auto 1.5rem;
}
.retro-tv-img {
  width: 100%;
  height: auto;
  object-fit: contain;
}
.retro-modal-title {
  font-family: var(--font-primary, 'Champ Black', serif);
  font-size: 1.75rem;
  line-height: 1.1;
  color: var(--color-foreground, #2d0f28);
  margin: 0 0 0.75rem 0;
}
.retro-modal-desc {
  font-size: 0.875rem;
  color: rgba(45, 15, 40, 0.8);
  margin: 0 0 1.5rem 0;
  line-height: 1.5;
}
.retro-form-input-wrap {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}
.retro-form-input {
  width: 100%;
  padding: 0.875rem 1.25rem;
  border-radius: var(--radius-full);
  border: 2px solid var(--color-foreground, #2d0f28);
  background-color: #ffffff;
  font-family: var(--font-secondary, 'Azeret Mono', monospace);
  font-size: 0.875rem;
  outline: none;
}
.retro-form-input:focus {
  border-color: var(--color-accent-purple, #ca9af1);
  box-shadow: 0 0 0 3px rgba(202, 154, 241, 0.4);
}
.retro-form-submit {
  width: 100%;
  padding: 0.875rem;
  font-size: 1.125rem;
}
.newsletter-launcher-wrap {
  position: fixed;
  bottom: 0;
  left: 1.25rem;
  z-index: 990;
}
.newsletter-launcher-tab {
  background-color: #ffffff;
  color: var(--color-foreground, #2d0f28);
  border: 2px solid var(--color-foreground, #2d0f28);
  border-bottom: none;
  border-top-left-radius: var(--radius-sm, 8px);
  border-top-right-radius: var(--radius-sm, 8px);
  padding: 0.5rem 1rem;
  font-family: var(--font-secondary, 'Azeret Mono', monospace);
  font-weight: 700;
  font-size: 0.8125rem;
  letter-spacing: 0.02em;
  box-shadow: 0 -2px 10px rgba(45, 15, 40, 0.1);
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  transition: transform 0.2s ease, background-color 0.2s ease;
  line-height: 1;
}
.newsletter-launcher-tab:hover {
  background-color: var(--color-cream, #fffbf2);
  transform: translateY(-2px);
}
.launcher-tab-mascot {
  width: 16px;
  height: auto;
  display: block;
}
.launcher-tab-text {
  display: inline-block;
}
</style>
