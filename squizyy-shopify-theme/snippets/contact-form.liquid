{%- comment -%}
  Squizyy Contact & User Feedback Form Snippet
  Includes direct support channels (WhatsApp, Email, Operating Hours)
  and native Shopify contact/feedback form.
{%- endcomment -%}

<section class="contact-section">
  <div class="contact-container">
    <!-- Section Header -->
    <div class="contact-header">
      <div class="contact-pill-badge">
        <span class="contact-pill-icon">💬</span>
        <span class="contact-pill-text">WE'D LOVE TO HEAR FROM YOU</span>
      </div>
      <h1 class="contact-title">SAY HELLO TO SQUIZYY</h1>
      <p class="contact-subtitle">
        Have a question about your order, want to share product feedback, or interested in wholesale partnerships? Send us a message or reach out directly below.
      </p>
    </div>

    <div class="contact-grid">
      <!-- Left Column: Direct Support Cards -->
      <div class="contact-info-col">
        <!-- Direct Support Channels -->
        <div class="contact-info-card">
          <h2 class="contact-info-heading">Direct Support</h2>
          
          <div class="contact-channels-list">
            <!-- WhatsApp Support -->
            <a
              href="https://wa.me/919876543210?text=Hi%20Squizyy%20Team!%20I%20have%20a%20question%20regarding%20my%20order..."
              target="_blank"
              rel="noopener noreferrer"
              class="contact-channel-item contact-channel-whatsapp"
            >
              <div class="contact-channel-icon-wrap" style="background-color: #25d366;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M17.472 14.382C17.112 14.202 15.344 13.332 15.014 13.212C14.684 13.092 14.444 13.032 14.204 13.392C13.964 13.752 13.274 14.562 13.064 14.802C12.854 15.042 12.644 15.072 12.284 14.892C11.924 14.712 10.764 14.332 9.384 13.102C8.304 12.142 7.574 10.952 7.364 10.592C7.154 10.232 7.344 10.042 7.524 9.862C7.684 9.702 7.884 9.442 8.064 9.232C8.244 9.022 8.304 8.872 8.424 8.632C8.544 8.392 8.484 8.182 8.394 8.002C8.304 7.822 7.584 6.052 7.284 5.332C6.994 4.632 6.694 4.732 6.474 4.722C6.264 4.712 6.024 4.712 5.784 4.712C5.544 4.712 5.154 4.802 4.824 5.162C4.494 5.522 3.564 6.392 3.564 8.162C3.564 9.932 4.854 11.642 5.034 11.882C5.214 12.122 7.574 15.762 11.194 17.322C12.054 17.692 12.724 17.922 13.254 18.092C14.124 18.372 14.914 18.332 15.544 18.242C16.244 18.142 17.694 17.362 17.994 16.512C18.294 15.662 18.294 14.942 18.204 14.792C18.124 14.642 17.884 14.562 17.472 14.382ZM12.044 21.802C10.364 21.802 8.714 21.352 7.264 20.492L6.924 20.292L2.834 21.362L3.924 17.382L3.704 17.032C2.754 15.522 2.254 13.772 2.254 11.972C2.254 6.572 6.644 2.182 12.054 2.182C14.674 2.182 17.134 3.202 18.984 5.062C20.834 6.922 21.854 9.382 21.854 12.002C21.844 17.412 17.454 21.802 12.044 21.802Z" fill="#ffffff"/>
                </svg>
              </div>
              <div class="contact-channel-body">
                <span class="contact-channel-label">WHATSAPP CHAT</span>
                <span class="contact-channel-value">+91 98765 43210</span>
                <span class="contact-channel-note">Click to chat instantly with support &rarr;</span>
              </div>
            </a>

            <!-- Email Support -->
            <a href="mailto:support@squizyy.in" class="contact-channel-item">
              <div class="contact-channel-icon-wrap" style="background-color: var(--color-accent-purple, #ca9af1);">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M4 4H20C21.1 4 22 4.9 22 6V18C22 19.1 21.1 20 20 20H4C2.9 20 2 19.1 2 18V6C2 4.9 2.9 4 4 4Z" stroke="#2D0F28" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M22 6L12 13L2 6" stroke="#2D0F28" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
              <div class="contact-channel-body">
                <span class="contact-channel-label">EMAIL US</span>
                <span class="contact-channel-value">support@squizyy.in</span>
                <span class="contact-channel-note">We respond within 24 business hours</span>
              </div>
            </a>
          </div>

          <hr class="contact-card-divider">

          <div class="contact-hours-block">
            <span class="contact-hours-title">🕒 Operating Hours</span>
            <p class="contact-hours-text">Monday – Saturday: 9:30 AM – 6:30 PM IST</p>
            <p class="contact-hours-sub">Pan-India customer service &amp; order fulfillment.</p>
          </div>
        </div>

        <!-- Headquarters & Brand Info -->
        <div class="contact-info-card">
          <h2 class="contact-info-heading">Brand Office</h2>
          <div class="contact-office-block">
            <strong class="contact-office-name">Squizyy Foods India Private Limited</strong>
            <p class="contact-office-address">
              Saurashtra, Gujarat — 360001, India
            </p>
            <div class="contact-badge-box">
              <span class="contact-origin-pill">🇮🇳 100% Indian Peanuts</span>
              <span class="contact-origin-pill">FSSAI Certified</span>
            </div>
          </div>
        </div>

        <!-- Quick FAQ Prompt -->
        <div class="contact-faq-banner">
          <div class="contact-faq-icon">💡</div>
          <div class="contact-faq-text">
            <strong>Have a quick question?</strong>
            <p>Check out our FAQ on storage, oil separation, and squeeze caps.</p>
            <a href="{{ routes.root_url }}pages/faq" class="contact-faq-link">View FAQ &rarr;</a>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive Contact & Feedback Form -->
      <div class="contact-form-col">
        <div class="contact-form-card">
          <h2 class="contact-form-title">Send a Message or Feedback</h2>
          <p class="contact-form-desc">
            Whether you want to track an order, give feedback, or say hi, fill out the form below. We read and respond to every message!
          </p>

          {%- form 'contact', id: 'SquizyyContactFormSnippet', class: 'contact-form-inner' -%}
            {%- if form.posted_successfully? -%}
              <div class="contact-success-box" role="status">
                <div class="contact-success-emoji">🎉</div>
                <h3 class="contact-success-heading">Message Sent Successfully!</h3>
                <p class="contact-success-desc">
                  Thank you for getting in touch with Squizyy! Our team has received your message and will get back to you shortly.
                </p>
                <div class="contact-success-action">
                  <a href="{{ routes.all_products_collection_url }}" class="button-primary contact-return-btn">CONTINUE SHOPPING</a>
                </div>
              </div>
            {%- else -%}
              {%- if form.errors -%}
                <div class="contact-error-box" role="alert">
                  {{ form.errors | default_errors }}
                </div>
              {%- endif -%}

              <!-- Hidden Lead Tags -->
              <input type="hidden" name="contact[tags]" value="customer-feedback,contact-page">

              <!-- Name & Email Row -->
              <div class="contact-form-row">
                <div class="contact-field-wrap">
                  <label for="Snippet-ContactForm-name" class="contact-label">Your Name *</label>
                  <input
                    type="text"
                    id="Snippet-ContactForm-name"
                    name="contact[name]"
                    value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                    placeholder="Enter your name"
                    required
                    class="contact-input"
                  >
                </div>

                <div class="contact-field-wrap">
                  <label for="Snippet-ContactForm-email" class="contact-label">Email Address *</label>
                  <input
                    type="email"
                    id="Snippet-ContactForm-email"
                    name="contact[email]"
                    value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                    placeholder="name@example.com"
                    required
                    class="contact-input"
                  >
                </div>
              </div>

              <!-- Phone & Topic Row -->
              <div class="contact-form-row">
                <div class="contact-field-wrap">
                  <label for="Snippet-ContactForm-phone" class="contact-label">Phone / WhatsApp Number *</label>
                  <input
                    type="tel"
                    id="Snippet-ContactForm-phone"
                    name="contact[phone]"
                    value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                    placeholder="+91 98765 43210"
                    required
                    class="contact-input"
                  >
                </div>

                <div class="contact-field-wrap">
                  <label for="Snippet-ContactForm-topic" class="contact-label">Topic / Department *</label>
                  <select id="Snippet-ContactForm-topic" name="contact[topic]" class="contact-select" required>
                    <option value="" disabled selected>Select a topic...</option>
                    <option value="Order & Delivery Tracking">📦 Order &amp; Delivery Tracking</option>
                    <option value="Product Feedback & Review">🥜 Product Feedback &amp; Review</option>
                    <option value="Damage / Replacement Request">⚠️ Damaged Item / Replacement</option>
                    <option value="Wholesale & Retail Inquiry">🏪 Wholesale &amp; Retail Inquiry</option>
                    <option value="Press & Collaboration">✨ Press &amp; Collaboration</option>
                    <option value="General Inquiry">💬 General Inquiry</option>
                  </select>
                </div>
              </div>

              <!-- Order Number Field -->
              <div class="contact-field-wrap">
                <label for="Snippet-ContactForm-order" class="contact-label">Order Number (Optional)</label>
                <input
                  type="text"
                  id="Snippet-ContactForm-order"
                  name="contact[order_number]"
                  placeholder="e.g. #1024 (if inquiring about an order)"
                  class="contact-input"
                >
              </div>

              <!-- Message / Feedback Field -->
              <div class="contact-field-wrap">
                <label for="Snippet-ContactForm-body" class="contact-label">Your Message or Feedback *</label>
                <textarea
                  rows="6"
                  id="Snippet-ContactForm-body"
                  name="contact[body]"
                  placeholder="Share your question, feedback, or thoughts here..."
                  required
                  class="contact-textarea"
                >{% if form.body %}{{ form.body }}{% endif %}</textarea>
              </div>

              <!-- Submit Button -->
              <div class="contact-submit-wrap">
                <button type="submit" class="button-primary contact-submit-btn">
                  SEND MESSAGE &rarr;
                </button>
              </div>
            {%- endif -%}
          {%- endform -%}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
.contact-section {
  width: 100%;
  background-color: var(--color-background, #fffaf3);
  padding: 3rem 1rem 5rem 1rem;
}
@media (min-width: 1024px) {
  .contact-section {
    padding: 4.5rem 1.5rem 7rem 1.5rem;
  }
}
.contact-container {
  max-width: 75rem;
  margin: 0 auto;
  box-sizing: border-box;
}
.contact-header {
  text-align: center;
  max-width: 44rem;
  margin: 0 auto 3rem auto;
}
.contact-pill-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  background-color: var(--color-accent-purple, #ca9af1);
  border: 2px solid var(--color-dark-brown, #2b1408);
  border-radius: var(--radius-full, 9999px);
  padding: 0.5rem 1.125rem;
  font-family: var(--font-secondary, 'Azeret Mono', monospace);
  font-size: 0.75rem;
  font-weight: 800;
  letter-spacing: 0.05em;
  color: var(--color-dark-brown, #2b1408);
  margin-bottom: 1.25rem;
  box-shadow: 0 4px 10px rgba(43, 20, 8, 0.08);
}
.contact-title {
  font-family: var(--font-primary, 'Champ Black', serif);
  font-size: 2.25rem;
  line-height: 1.05;
  text-transform: uppercase;
  color: var(--color-dark-brown, #2b1408);
  margin: 0 0 1rem 0;
}
@media (min-width: 640px) {
  .contact-title {
    font-size: 3rem;
  }
}
@media (min-width: 1024px) {
  .contact-title {
    font-size: 3.75rem;
  }
}
.contact-subtitle {
  font-family: var(--font-secondary, 'Azeret Mono', monospace);
  font-size: 0.875rem;
  line-height: 1.6;
  color: rgba(43, 20, 8, 0.85);
  margin: 0;
}
@media (min-width: 640px) {
  .contact-subtitle {
    font-size: 1rem;
  }
}
.contact-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 2rem;
  align-items: flex-start;
}
@media (min-width: 1024px) {
  .contact-grid {
    grid-template-columns: 380px 1fr;
    gap: 2.5rem;
  }
}
.contact-info-col {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}
.contact-info-card {
  background-color: var(--color-cream, #fffbf2);
  border: 4px solid var(--color-dark-brown, #2b1408);
  border-bottom-width: 8px;
  border-radius: var(--radius-2xl, 32px);
  padding: 1.75rem;
  box-shadow: 0 10px 30px rgba(43, 20, 8, 0.08);
}
.contact-info-heading {
  font-family: var(--font-primary, 'Champ Black', serif);
  font-size: 1.375rem;
  text-transform: uppercase;
  color: var(--color-dark-brown, #2b1408);
  margin: 0 0 1.25rem 0;
}
.contact-channels-list {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}
.contact-channel-item {
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 0.875rem 1rem;
  border: 2px solid var(--color-dark-brown, #2b1408);
  border-radius: var(--radius-lg, 16px);
  background-color: #ffffff;
  text-decoration: none;
  color: inherit;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}
.contact-channel-item:hover {
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(43, 20, 8, 0.1);
}
.contact-channel-icon-wrap {
  width: 44px;
  height: 44px;
  border-radius: 12px;
  border: 2px solid var(--color-dark-brown, #2b1408);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.contact-channel-body {
  display: flex;
  flex-direction: column;
  gap: 0.125rem;
  min-width: 0;
}
.contact-channel-label {
  font-family: var(--font-secondary, 'Azeret Mono', monospace);
  font-size: 0.6875rem;
  font-weight: 800;
  letter-spacing: 0.05em;
  color: rgba(43, 20, 8, 0.7);
}
.contact-channel-value {
  font-family: var(--font-secondary, 'Azeret Mono', monospace);
  font-size: 0.9375rem;
  font-weight: 700;
  color: var(--color-dark-brown, #2b1408);
}
.contact-channel-note {
  font-family: var(--font-secondary, 'Azeret Mono', monospace);
  font-size: 0.6875rem;
  color: rgba(43, 20, 8, 0.7);
}
.contact-card-divider {
  border: none;
  border-top: 2px dashed rgba(43, 20, 8, 0.2);
  margin: 1.5rem 0 1.25rem 0;
}
.contact-hours-block {
  font-family: var(--font-secondary, 'Azeret Mono', monospace);
}
.contact-hours-title {
  font-size: 0.8125rem;
  font-weight: 800;
  color: var(--color-dark-brown, #2b1408);
  display: block;
  margin-bottom: 0.375rem;
}
.contact-hours-text {
  font-size: 0.8125rem;
  font-weight: 600;
  color: var(--color-dark-brown, #2b1408);
  margin: 0 0 0.25rem 0;
}
.contact-hours-sub {
  font-size: 0.6875rem;
  color: rgba(43, 20, 8, 0.65);
  margin: 0;
}
.contact-office-block {
  font-family: var(--font-secondary, 'Azeret Mono', monospace);
}
.contact-office-name {
  font-size: 0.875rem;
  font-weight: 800;
  color: var(--color-dark-brown, #2b1408);
  display: block;
  margin-bottom: 0.375rem;
}
.contact-office-address {
  font-size: 0.8125rem;
  line-height: 1.5;
  color: rgba(43, 20, 8, 0.8);
  margin: 0 0 1rem 0;
}
.contact-badge-box {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}
.contact-origin-pill {
  display: inline-block;
  padding: 0.25rem 0.625rem;
  background-color: #ffffff;
  border: 1.5px solid var(--color-dark-brown, #2b1408);
  border-radius: var(--radius-full, 9999px);
  font-size: 0.6875rem;
  font-weight: 700;
  color: var(--color-dark-brown, #2b1408);
}
.contact-faq-banner {
  display: flex;
  gap: 1rem;
  background-color: var(--color-accent-purple, #ca9af1);
  border: 4px solid var(--color-dark-brown, #2b1408);
  border-bottom-width: 6px;
  border-radius: var(--radius-xl, 24px);
  padding: 1.25rem;
  box-shadow: 0 4px 12px rgba(43, 20, 8, 0.08);
  color: var(--color-dark-brown, #2b1408);
}
.contact-faq-icon {
  font-size: 1.75rem;
  line-height: 1;
}
.contact-faq-text {
  font-family: var(--font-secondary, 'Azeret Mono', monospace);
  font-size: 0.8125rem;
  line-height: 1.5;
}
.contact-faq-text strong {
  display: block;
  font-size: 0.875rem;
  margin-bottom: 0.25rem;
}
.contact-faq-text p {
  margin: 0 0 0.5rem 0;
  color: rgba(43, 20, 8, 0.85);
}
.contact-faq-link {
  font-weight: 800;
  color: var(--color-dark-brown, #2b1408);
  text-decoration: underline;
  display: inline-block;
}

/* Right Form Card */
.contact-form-card {
  background-color: var(--color-cream, #fffbf2);
  border: 4px solid var(--color-dark-brown, #2b1408);
  border-bottom-width: 8px;
  border-radius: var(--radius-2xl, 32px);
  padding: 2rem 1.5rem;
  box-shadow: 0 10px 30px rgba(43, 20, 8, 0.08);
  box-sizing: border-box;
}
@media (min-width: 640px) {
  .contact-form-card {
    padding: 2.5rem;
  }
}
.contact-form-title {
  font-family: var(--font-primary, 'Champ Black', serif);
  font-size: 1.75rem;
  text-transform: uppercase;
  color: var(--color-dark-brown, #2b1408);
  margin: 0 0 0.5rem 0;
}
@media (min-width: 640px) {
  .contact-form-title {
    font-size: 2.25rem;
  }
}
.contact-form-desc {
  font-family: var(--font-secondary, 'Azeret Mono', monospace);
  font-size: 0.8125rem;
  line-height: 1.6;
  color: rgba(43, 20, 8, 0.8);
  margin: 0 0 2rem 0;
}
.contact-form-inner {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}
.contact-form-row {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1.25rem;
}
@media (min-width: 640px) {
  .contact-form-row {
    grid-template-columns: 1fr 1fr;
  }
}
.contact-field-wrap {
  display: flex;
  flex-direction: column;
  gap: 0.375rem;
}
.contact-label {
  font-family: var(--font-secondary, 'Azeret Mono', monospace);
  font-size: 0.75rem;
  font-weight: 800;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: var(--color-dark-brown, #2b1408);
}
.contact-input,
.contact-select,
.contact-textarea {
  width: 100%;
  background-color: #ffffff;
  border: 2px solid var(--color-dark-brown, #2b1408);
  border-radius: var(--radius-sm, 8px);
  padding: 0.875rem 1rem;
  font-family: var(--font-secondary, 'Azeret Mono', monospace);
  font-size: 0.875rem;
  color: var(--color-dark-brown, #2b1408);
  box-sizing: border-box;
  outline: none;
  transition: border-color 0.15s ease, box-shadow 0.15s ease;
}
.contact-input::placeholder,
.contact-textarea::placeholder {
  color: rgba(43, 20, 8, 0.5);
}
.contact-input:focus,
.contact-select:focus,
.contact-textarea:focus {
  border-color: var(--color-accent-purple, #ca9af1);
  box-shadow: 0 0 0 3px rgba(202, 154, 241, 0.35);
}
.contact-select {
  cursor: pointer;
  appearance: auto;
}
.contact-textarea {
  resize: vertical;
  min-height: 120px;
}
.contact-submit-wrap {
  margin-top: 1rem;
}
.contact-submit-btn {
  width: 100%;
  padding: 1.125rem 2rem;
  font-size: 1.125rem;
  letter-spacing: 0.05em;
  text-align: center;
  border-radius: var(--radius-full, 9999px);
  cursor: pointer;
}
@media (min-width: 640px) {
  .contact-submit-btn {
    width: auto;
    min-width: 240px;
  }
}
.contact-success-box {
  background-color: #f0fdf4;
  border: 3px solid #16a34a;
  border-radius: var(--radius-xl, 24px);
  padding: 2.5rem 1.5rem;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.75rem;
}
.contact-success-emoji {
  font-size: 3rem;
  line-height: 1;
}
.contact-success-heading {
  font-family: var(--font-primary, 'Champ Black', serif);
  font-size: 1.75rem;
  text-transform: uppercase;
  color: #166534;
  margin: 0;
}
.contact-success-desc {
  font-family: var(--font-secondary, 'Azeret Mono', monospace);
  font-size: 0.875rem;
  color: #14532d;
  max-width: 30rem;
  margin: 0;
}
.contact-success-action {
  margin-top: 1rem;
}
.contact-error-box {
  background-color: #fef2f2;
  border: 2px solid #ef4444;
  border-radius: var(--radius-md, 12px);
  padding: 1rem;
  font-family: var(--font-secondary, 'Azeret Mono', monospace);
  font-size: 0.8125rem;
  color: #991b1b;
}
</style>
