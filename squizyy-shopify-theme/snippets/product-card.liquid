{%- comment -%}
  Authentic Drizzy Product Card
  Faithfully ported from client/src/components/product/ProductCard.jsx & ProductCard.module.css
  Accepts:
  - product: {Object} Shopify Product Liquid object
{%- endcomment -%}

{%- assign primary_img = 'DRIZZY12302.jpg' | asset_url -%}
{%- assign hover_img = 'USADRIZZYFRONTcopy.jpg' | asset_url -%}

{%- if product.handle contains 'case' or product.handle contains 'food-services' -%}
  {%- assign primary_img = 'Screenshot2026-08-13at2.48.55pm_0bac0419-b155-4cdf-ac7f-4842cf6b6824.png' | asset_url -%}
  {%- assign hover_img = 'Screenshot_2026-08-21_at_10.32.56_am.png' | asset_url -%}
{%- endif -%}

{%- if product != blank and product.featured_image != blank -%}
  {%- assign primary_img = product.featured_image | image_url: width: 700 -%}
  {%- if product.images[1] != blank -%}
    {%- assign hover_img = product.images[1] | image_url: width: 700 -%}
  {%- else -%}
    {%- assign hover_img = primary_img -%}
  {%- endif -%}
{%- endif -%}

{%- assign card_url = product.url | default: '/products/drizzy-squeezy-peanut-butter-19-4-oz' -%}
{%- assign card_title = product.title | default: 'Drizzy Squeezy Peanut Butter 19.4 Oz' -%}
{%- assign card_price = product.price | default: 999 | money -%}

<div class="product-card" data-product-card>
  <div class="product-card-inner">
    <!-- Card Image -->
    <a
      href="{{ card_url }}"
      class="product-card-image-link"
      aria-label="View details for {{ card_title | escape }}"
    >
      <div class="product-card-image-container">
        <img
          src="{{ primary_img }}"
          alt="{{ card_title | escape }}"
          class="product-card-primary-img"
          loading="eager"
          width="400"
          height="533"
        >
        <img
          src="{{ hover_img }}"
          alt=""
          class="product-card-hover-img"
          loading="lazy"
          width="400"
          height="533"
        >
      </div>
      {%- if product != blank and product.compare_at_price > product.price -%}
        <div class="product-card-badge-wrap">
          {% render 'product-badge', text: 'SALE', type: 'sale' %}
        </div>
      {%- endif -%}
    </a>

    <!-- Card Info -->
    <div class="product-card-info">
      <a href="{{ card_url }}" class="product-card-title">
        {{ card_title }}
      </a>
      <div class="product-card-price">
        {%- if product != blank -%}
          {% render 'price', product: product, show_badges: false %}
        {%- else -%}
          {{ card_price }}
        {%- endif -%}
      </div>
    </div>

    <!-- Add To Cart Button -->
    <div class="product-card-actions">
      <button
        type="button"
        class="button-primary product-card-btn"
        data-add-to-cart
        data-variant-id="{{ product.selected_or_first_available_variant.id | default: '44000000000000' }}"
        data-quantity="1"
        {% if product != blank and product.available == false %}disabled{% endif %}
      >
        <span>
          {%- if product != blank and product.available == false -%}
            SOLD OUT
          {%- else -%}
            ADD TO CART
          {%- endif -%}
        </span>
      </button>
    </div>
  </div>
</div>

<style>
.product-card {
  height: 100%;
  width: 100%;
  position: relative;
  box-sizing: border-box;
}
.product-card-inner {
  display: flex;
  height: 100%;
  width: 100%;
  flex-direction: column;
  gap: 0.75rem;
}
.product-card-image-link {
  width: 100%;
  aspect-ratio: 3 / 4;
  overflow: hidden;
  position: relative;
  z-index: 0;
  border: 2px solid var(--border-color, #2d0f28);
  border-radius: var(--radius-lg, 16px);
  background-color: #ffffff;
  box-shadow: var(--shadow-sm, 0 1px 3px rgba(45, 15, 40, 0.08));
  display: block;
  text-decoration: none;
  box-sizing: border-box;
}
@media (min-width: 640px) {
  .product-card-image-link {
    border-width: 3px;
    border-radius: 22px;
  }
}
.product-card-image-container {
  height: 100%;
  width: 100%;
  position: relative;
}
.product-card-primary-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  position: absolute;
  inset: 0;
  z-index: 2;
  transition: opacity 0.25s ease-in-out;
  opacity: 1;
  display: block;
}
.product-card-hover-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  position: absolute;
  inset: 0;
  z-index: 1;
  transition: opacity 0.25s ease-in-out;
  opacity: 0;
  display: block;
}
.product-card-image-link:hover .product-card-primary-img {
  opacity: 0;
}
.product-card-image-link:hover .product-card-hover-img {
  opacity: 1;
}
.product-card-info {
  display: flex;
  flex-direction: column;
  gap: 0.375rem;
  z-index: 2;
  margin-top: 0.25rem;
}
.product-card-title {
  font-family: var(--font-mono, var(--font-secondary, 'Azeret Mono', monospace));
  font-size: 0.875rem;
  font-weight: 700;
  color: var(--color-dark-brown, #2d0f28);
  text-decoration: none;
  line-height: 1.3;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
@media (min-width: 640px) {
  .product-card-title {
    font-size: 1rem;
  }
}
.product-card-title:hover {
  text-decoration: underline;
}
.product-card-price {
  font-family: var(--font-mono, var(--font-secondary, 'Azeret Mono', monospace));
  font-size: 0.875rem;
  font-weight: 700;
  color: var(--color-dark-brown, #2d0f28);
}
@media (min-width: 640px) {
  .product-card-price {
    font-size: 1rem;
  }
}
.product-card-actions {
  width: 100%;
  margin-top: auto;
  padding-top: 0.5rem;
}
.product-card-btn {
  width: 100%;
  padding: 0.75rem 1.25rem;
  font-size: 1rem;
  text-transform: uppercase;
  box-sizing: border-box;
}
@media (min-width: 640px) {
  .product-card-btn {
    padding: 0.875rem 1.5rem;
    font-size: 1.125rem;
  }
}
</style>
