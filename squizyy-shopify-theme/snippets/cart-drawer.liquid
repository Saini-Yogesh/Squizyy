{%- comment -%}
  Slide-out Ajax Cart Drawer with Free Shipping progress bar
{%- endcomment -%}

<div id="CartDrawerOverlay" class="cart-drawer-overlay"></div>

<aside id="CartDrawer" class="cart-drawer" role="dialog" aria-modal="true" aria-label="Shopping Cart">
  <div class="cart-drawer-header">
    <div class="cart-drawer-title-wrap">
      <h3 class="cart-drawer-title">YOUR CART</h3>
      <span class="cart-drawer-badge" data-cart-count>{{ cart.item_count }}</span>
    </div>
    <button type="button" class="cart-drawer-close" data-close-cart aria-label="Close cart">
      {% render 'icon', name: 'close' %}
    </button>
  </div>

  <!-- Free Shipping Meter -->
  <div class="cart-shipping-meter">
    <p id="ShippingProgressText" class="shipping-progress-text">
      Add <strong>$29.99</strong> more for <strong>FREE Shipping!</strong>
    </p>
    <div class="shipping-progress-track">
      <div id="ShippingProgressFill" class="shipping-progress-fill" style="width: 0%;"></div>
    </div>
  </div>

  <!-- Items Scroll Area -->
  <div id="CartDrawerItems" class="cart-drawer-items">
    <!-- Populated by cart.js -->
  </div>

  <!-- Footer with Subtotal & Checkout -->
  <div class="cart-drawer-footer">
    <div class="cart-drawer-subtotal-row">
      <span class="subtotal-label">Subtotal</span>
      <span id="CartDrawerSubtotal" class="subtotal-val">{{ cart.total_price | money }}</span>
    </div>
    <p class="cart-drawer-tax-note">Taxes and shipping calculated at checkout.</p>
    
    <div class="cart-drawer-actions">
      <a href="/checkout" class="button-primary cart-checkout-btn">
        <span>Proceed to Checkout</span>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
      <a href="{{ routes.cart_url }}" class="cart-view-link">View Full Cart</a>
    </div>
  </div>
</aside>

<style>
.cart-drawer-overlay {
  position: fixed;
  inset: 0;
  background-color: rgba(45, 15, 40, 0.6);
  backdrop-filter: blur(4px);
  z-index: 9998;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.3s ease, visibility 0.3s ease;
}
.cart-drawer-overlay.active {
  opacity: 1;
  visibility: visible;
}
.cart-drawer {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  max-width: 480px;
  background-color: var(--color-background, #f8ebd7);
  border-left: 4px solid var(--color-foreground, #2d0f28);
  box-shadow: -10px 0 30px rgba(45, 15, 40, 0.2);
  z-index: 9999;
  display: flex;
  flex-direction: column;
  transform: translateX(100%);
  transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
}
.cart-drawer.active {
  transform: translateX(0);
}
.cart-drawer-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1.5rem;
  border-bottom: 3px solid var(--color-foreground, #2d0f28);
  background-color: var(--color-cream, #fffbf2);
}
.cart-drawer-title-wrap {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}
.cart-drawer-title {
  font-family: var(--font-primary, 'Champ Black', serif);
  font-size: 1.5rem;
  margin: 0;
  color: var(--color-foreground, #2d0f28);
  letter-spacing: -0.02em;
}
.cart-drawer-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  border-radius: var(--radius-full);
  background-color: var(--color-accent-purple, #ca9af1);
  color: var(--color-foreground, #2d0f28);
  font-family: var(--font-secondary, 'Azeret Mono', monospace);
  font-weight: 700;
  font-size: 0.875rem;
  border: 2px solid var(--color-foreground, #2d0f28);
}
.cart-drawer-close {
  background: none;
  border: none;
  cursor: pointer;
  color: var(--color-foreground, #2d0f28);
  padding: 0.25rem;
  display: flex;
  align-items: center;
  justify-content: center;
}
.cart-shipping-meter {
  padding: 1rem 1.5rem;
  background-color: #ffffff;
  border-bottom: 2px solid var(--color-foreground, #2d0f28);
}
.shipping-progress-text {
  font-family: var(--font-secondary, 'Azeret Mono', monospace);
  font-size: 0.8125rem;
  margin: 0 0 0.5rem 0;
  color: var(--color-foreground, #2d0f28);
}
.shipping-progress-track {
  width: 100%;
  height: 12px;
  border-radius: var(--radius-full);
  background-color: var(--color-background, #f8ebd7);
  border: 2px solid var(--color-foreground, #2d0f28);
  overflow: hidden;
}
.shipping-progress-fill {
  height: 100%;
  background-color: var(--color-accent-purple, #ca9af1);
  transition: width 0.3s ease, background-color 0.3s ease;
}
.cart-drawer-items {
  flex: 1;
  overflow-y: auto;
  padding: 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}
.cart-drawer-empty {
  text-align: center;
  padding: 3rem 1rem;
}
.cart-drawer-empty-icon {
  font-size: 3.5rem;
  margin-bottom: 1rem;
}
.cart-drawer-empty-title {
  font-family: var(--font-primary, 'Champ Black', serif);
  font-size: 1.75rem;
  margin: 0 0 0.5rem 0;
  color: var(--color-foreground, #2d0f28);
}
.cart-drawer-empty-desc {
  font-size: 0.95rem;
  color: rgba(45, 15, 40, 0.7);
  margin: 0;
}
.cart-drawer-item {
  display: flex;
  gap: 1rem;
  background-color: var(--color-cream, #fffbf2);
  border: 2px solid var(--color-foreground, #2d0f28);
  border-radius: var(--radius-lg);
  padding: 1rem;
  box-shadow: 0 4px 0 var(--color-foreground, #2d0f28);
}
.cart-item-image {
  width: 80px;
  height: 80px;
  background-color: #ffffff;
  border-radius: var(--radius-md);
  border: 2px solid var(--color-foreground, #2d0f28);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.cart-item-image img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}
.cart-item-info {
  flex: 1;
}
.cart-item-title {
  font-family: var(--font-primary, 'Champ Black', serif);
  font-size: 1.125rem;
  margin: 0 0 0.25rem 0;
  color: var(--color-foreground, #2d0f28);
}
.cart-item-variant {
  font-size: 0.75rem;
  color: rgba(45, 15, 40, 0.7);
  margin: 0 0 0.5rem 0;
}
.cart-item-price {
  font-family: var(--font-secondary, 'Azeret Mono', monospace);
  font-weight: 700;
  font-size: 1rem;
  color: var(--color-foreground, #2d0f28);
  margin-bottom: 0.75rem;
}
.cart-item-controls {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.cart-qty-picker {
  display: inline-flex;
  align-items: center;
  border: 2px solid var(--color-foreground, #2d0f28);
  border-radius: var(--radius-full);
  background-color: #ffffff;
  overflow: hidden;
}
.cart-qty-btn {
  background: none;
  border: none;
  width: 28px;
  height: 28px;
  font-weight: 700;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
}
.cart-qty-val {
  font-size: 0.875rem;
  font-weight: 700;
  padding: 0 0.5rem;
}
.cart-item-remove {
  background: none;
  border: none;
  font-size: 0.75rem;
  text-decoration: underline;
  cursor: pointer;
  color: rgba(45, 15, 40, 0.6);
}
.cart-drawer-footer {
  padding: 1.5rem;
  border-top: 3px solid var(--color-foreground, #2d0f28);
  background-color: var(--color-cream, #fffbf2);
}
.cart-drawer-subtotal-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 0.5rem;
}
.subtotal-label {
  font-family: var(--font-primary, 'Champ Black', serif);
  font-size: 1.25rem;
}
.subtotal-val {
  font-family: var(--font-primary, 'Champ Black', serif);
  font-size: 1.5rem;
  color: var(--color-foreground, #2d0f28);
}
.cart-drawer-tax-note {
  font-size: 0.75rem;
  color: rgba(45, 15, 40, 0.6);
  margin: 0 0 1.25rem 0;
}
.cart-drawer-actions {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}
.cart-checkout-btn {
  width: 100%;
  font-size: 1.125rem;
  padding: 1rem;
}
.cart-view-link {
  text-align: center;
  font-size: 0.875rem;
  text-decoration: underline;
  font-weight: 700;
  color: var(--color-foreground, #2d0f28);
}
</style>
