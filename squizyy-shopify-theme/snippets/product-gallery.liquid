{%- comment -%}
  Renders the interactive Product Gallery with main image frame and thumbnail selector.
  Accepts:
  - product: {Object} Liquid product object
{%- endcomment -%}

<div class="product-gallery-snippet" data-product-gallery>
  <div class="gallery-main-frame">
    {%- if product.featured_image != blank -%}
      <img
        id="GalleryMainImageSnippet"
        src="{{ product.featured_image | image_url: width: 1000 }}"
        alt="{{ product.title | escape }}"
        class="gallery-main-img"
      >
    {%- else -%}
      <img
        id="GalleryMainImageSnippet"
        src="{{ 'bundle-1x.png' | asset_url }}"
        alt="{{ product.title | default: 'Drizzy Peanut Butter' | escape }}"
        class="gallery-main-img"
      >
    {%- endif -%}
  </div>

  {%- if product.images.size > 1 -%}
    <div class="gallery-thumbnails">
      {%- for image in product.images -%}
        <button
          type="button"
          class="gallery-thumb-btn {% if forloop.first %}active{% endif %}"
          data-image-src="{{ image | image_url: width: 1000 }}"
          onclick="var m = document.getElementById('GalleryMainImageSnippet'); if(m) m.src = this.dataset.imageSrc; document.querySelectorAll('.gallery-thumb-btn').forEach(function(b){ b.classList.remove('active'); }); this.classList.add('active');"
        >
          <img src="{{ image | image_url: width: 160, height: 160, crop: 'center' }}" alt="{{ image.alt | escape }}">
        </button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

<style>
.product-gallery-snippet {
  width: 100%;
}
.gallery-main-frame {
  width: 100%;
  aspect-ratio: 1 / 1;
  background-color: var(--color-cream, #fffbf2);
  border: 4px solid var(--color-dark-brown, #2b1408);
  border-bottom-width: 8px;
  border-radius: var(--radius-2xl, 32px);
  overflow: hidden;
  box-shadow: 0 20px 40px rgba(43, 20, 8, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1.5rem;
  box-sizing: border-box;
}
.gallery-main-img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}
.gallery-thumbnails {
  display: flex;
  gap: 0.75rem;
  margin-top: 1rem;
  overflow-x: auto;
  padding-bottom: 0.5rem;
}
.gallery-thumb-btn {
  width: 4.5rem;
  height: 4.5rem;
  border-radius: var(--radius-lg, 12px);
  border: 2px solid var(--color-dark-brown, #2b1408);
  background-color: var(--color-cream, #fffbf2);
  padding: 4px;
  cursor: pointer;
  flex-shrink: 0;
  transition: all 0.2s ease;
}
.gallery-thumb-btn.active {
  border-color: var(--color-accent-purple, #ca9af1);
  box-shadow: 0 0 0 2px var(--color-accent-purple, #ca9af1);
}
.gallery-thumb-btn img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}
</style>
