{%- comment -%}
  5-Star Verified Customer Reviews Carousel
{%- endcomment -%}

<section class="reviews-section" style="background-color: {{ section.settings.bg_color | default: '#f8ebd7' }};">
  <div class="reviews-container container">
    <div class="reviews-header">
      <div class="reviews-stars-top">★★★★★</div>
      <h2 class="reviews-title">{{ section.settings.heading | default: 'LOVED BY 1,000+ AUSSIES' }}</h2>
      <p class="reviews-sub">{{ section.settings.subheading | default: '4.9 / 5.0 Average Customer Rating Across 1,000+ Verified Buyers' }}</p>
    </div>

    <div class="reviews-cards-grid">
      <!-- Review 1 -->
      <div class="review-box">
        <div class="review-stars">★★★★★</div>
        <h3 class="review-headline">"Total game-changer for my morning oats!"</h3>
        <p class="review-quote">
          I was skeptical about a squeeze bottle peanut butter until I tried it. It's so smooth, tastes unreal, and I don't have to clean another sticky butter knife ever again.
        </p>
        <div class="review-author">
          <span class="author-name">Sarah M.</span>
          <span class="author-verified">✓ Verified Buyer</span>
        </div>
      </div>

      <!-- Review 2 -->
      <div class="review-box">
        <div class="review-stars">★★★★★</div>
        <h3 class="review-headline">"Kids can finally make their own snacks"</h3>
        <p class="review-quote">
          My toddlers used to destroy whole loaves of bread trying to spread hard peanut butter. Drizzy solved that overnight. Plus, no palm oil or junk gives me peace of mind.
        </p>
        <div class="review-author">
          <span class="author-name">David L.</span>
          <span class="author-verified">✓ Verified Buyer</span>
        </div>
      </div>

      <!-- Review 3 -->
      <div class="review-box">
        <div class="review-stars">★★★★★</div>
        <h3 class="review-headline">"Hands down the best PB I've ever tasted."</h3>
        <p class="review-quote">
          The natural sweetness of Aussie peanuts blows American supermarket brands completely out of the water. Already subscribed to the 6-pack bundle!
        </p>
        <div class="review-author">
          <span class="author-name">Liam T.</span>
          <span class="author-verified">✓ Verified Buyer</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
.reviews-section {
  padding: 6rem 0;
}
.reviews-header {
  text-align: center;
  margin-bottom: 3.5rem;
}
.reviews-stars-top {
  color: #ffb800;
  font-size: 1.5rem;
  letter-spacing: 2px;
  margin-bottom: 0.5rem;
}
.reviews-title {
  font-family: var(--font-primary, 'Champ Black', serif);
  font-size: clamp(2rem, 4vw, 3.25rem);
  color: var(--color-foreground, #2d0f28);
  margin: 0 0 0.75rem 0;
  text-transform: uppercase;
}
.reviews-sub {
  font-family: var(--font-secondary, 'Azeret Mono', monospace);
  font-size: 0.9375rem;
  opacity: 0.8;
  margin: 0;
}
.reviews-cards-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 2rem;
}
@media (min-width: 768px) {
  .reviews-cards-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}
.review-box {
  background-color: var(--color-cream, #fffbf2);
  border: 3px solid var(--color-foreground, #2d0f28);
  border-radius: var(--radius-2xl, 32px);
  padding: 2.5rem 2rem;
  box-shadow: 0 8px 0 var(--color-foreground, #2d0f28);
  display: flex;
  flex-direction: column;
}
.review-stars {
  color: #ffb800;
  font-size: 1.125rem;
  margin-bottom: 1rem;
}
.review-headline {
  font-family: var(--font-primary, 'Champ Black', serif);
  font-size: 1.25rem;
  line-height: 1.2;
  color: var(--color-foreground, #2d0f28);
  margin: 0 0 1rem 0;
}
.review-quote {
  font-size: 0.9375rem;
  line-height: 1.6;
  opacity: 0.85;
  margin: 0 0 1.5rem 0;
  flex: 1;
}
.review-author {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 1px solid rgba(45, 15, 40, 0.15);
  padding-top: 1rem;
  font-family: var(--font-secondary, 'Azeret Mono', monospace);
}
.author-name {
  font-weight: 700;
  font-size: 0.875rem;
}
.author-verified {
  font-size: 0.75rem;
  color: var(--color-accent-green, #036e2c);
  font-weight: 700;
}
</style>

{% schema %}
{
  "name": "Reviews Carousel",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "LOVED BY 1,000+ AUSSIES"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "4.9 / 5.0 Average Customer Rating Across 1,000+ Verified Buyers"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f8ebd7"
    }
  ],
  "presets": [
    {
      "name": "Reviews Carousel"
    }
  ]
}
{% endschema %}
