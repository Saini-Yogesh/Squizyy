  width: 100%;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
  gap: 2rem;
}
@media (min-width: 1024px) {
  .featured-layout-row {
    flex-direction: row;
    gap: 3.5rem;
  }
}
.featured-gallery-col {
  display: flex;
  width: 100%;
  align-items: center;
