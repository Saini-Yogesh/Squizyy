{%- comment -%}
  Homepage Featured Product Section — "The Ultimate Breakfast Power-Up"
  Faithfully ported from client/src/components/product/FeaturedProductSection.jsx & FeaturedProductSection.module.css
{%- endcomment -%}

{%- assign main_product = nil -%}
{%- if section.settings.featured_product != blank and all_products[section.settings.featured_product].title != blank -%}
  {%- assign main_product = all_products[section.settings.featured_product] -%}
{%- elsif all_products['drizzy-squeezy-peanut-butter-19-4-oz'].title != blank -%}
  {%- assign main_product = all_products['drizzy-squeezy-peanut-butter-19-4-oz'] -%}
{%- elsif all_products['drizzy-peanut-butter'].title != blank -%}
  {%- assign main_product = all_products['drizzy-peanut-butter'] -%}
{%- elsif collections.all.products.first != blank -%}
  {%- assign main_product = collections.all.products.first -%}
{%- endif -%}

{%- if main_product != blank and main_product.url != blank -%}
  {%- assign product_url = main_product.url -%}
  {%- assign product_price = main_product.price | money -%}
{%- else -%}
  {%- assign product_url = '/products/drizzy-squeezy-peanut-butter-19-4-oz' -%}
  {%- assign product_price = '$9.99' -%}
{%- endif -%}

<div class="featured-product-wrapper">
  <section class="featured-product-section" aria-label="Featured Product">
    <!-- Floating Peanuts Background Elements -->
    <div class="featured-peanut-1" aria-hidden="true">
      <img
        src="{{ 'drizzy-peanut-left.png' | asset_url }}"
        alt=""
        width="105"
        height="105"
        loading="lazy"
      >
    </div>
    <div class="featured-peanut-2" aria-hidden="true">
      <img
        src="{{ 'drizzy-peanut-left.png' | asset_url }}"
        alt=""
        width="137"
        height="137"
        loading="lazy"
      >
    </div>
    <div class="featured-peanut-3" aria-hidden="true">
      <img
        src="{{ 'peanut-small.png' | asset_url }}"
        alt=""
        width="67"
        height="67"
        loading="lazy"
      >
    </div>
    <div class="featured-peanut-4" aria-hidden="true">
      <img
        src="{{ 'peanut-small.png' | asset_url }}"
        alt=""
        width="90"
        height="90"
        loading="lazy"
      >
    </div>

    <!-- Main Product Content -->
    <div class="featured-product-content">
      <div class="featured-product-container">
        <div class="featured-layout-row">
          <!-- Left Column: Compact Media Gallery -->
          <div class="featured-gallery-col">
            <div class="compact-gallery-wrapper">
              <div class="compact-gallery-inner">
                <div class="compact-gallery-content">
                  <!-- Thumbnail Strip (left on desktop, bottom on mobile) -->
                  <div class="compact-thumb-strip">
                    {%- if main_product != blank and main_product.images.size > 0 -%}
                      {%- for img in main_product.images limit: 5 -%}
                        <button
                          type="button"
                          class="compact-thumb-btn {% if forloop.first %}thumb-active{% else %}thumb-inactive{% endif %}"
                          aria-label="Thumbnail {{ forloop.index }}"
                          onclick="changeFeaturedMainImage(this, '{{ img | image_url: width: 800 }}')"
                        >
                          <img
                            src="{{ img | image_url: width: 120, height: 120, crop: 'center' }}"
                            alt="{{ img.alt | default: 'Drizzy Bottle View' | escape }}"
                            class="compact-thumb-img"
                            width="64"
                            height="64"
                            loading="lazy"
                          >
                        </button>
                      {%- endfor -%}
                    {%- else -%}
                      <button
                        type="button"
                        class="compact-thumb-btn thumb-active"
                        aria-label="Thumbnail 1"
                        onclick="changeFeaturedMainImage(this, '{{ 'USADRIZZYFRONTcopy.jpg' | asset_url }}')"
                      >
                        <img
                          src="{{ 'USADRIZZYFRONTcopy.jpg' | asset_url }}"
                          alt="Drizzy Bottle Front"
                          class="compact-thumb-img"
                          width="64"
                          height="64"
                          loading="lazy"
                        >
                      </button>
                      <button
                        type="button"
                        class="compact-thumb-btn thumb-inactive"
                        aria-label="Thumbnail 2"
                        onclick="changeFeaturedMainImage(this, '{{ 'DRIZZY12302.jpg' | asset_url }}')"
                      >
                        <img
                          src="{{ 'DRIZZY12302.jpg' | asset_url }}"
                          alt="Drizzy On Kitchen Counter"
                          class="compact-thumb-img"
                          width="64"
                          height="64"
                          loading="lazy"
                        >
                      </button>
                      <button
                        type="button"
                        class="compact-thumb-btn thumb-inactive"
                        aria-label="Thumbnail 3"
                        onclick="changeFeaturedMainImage(this, '{{ 'DRIZZY13034.jpg' | asset_url }}')"
                      >
                        <img
                          src="{{ 'DRIZZY13034.jpg' | asset_url }}"
                          alt="Drizzy Drizzle Action"
                          class="compact-thumb-img"
                          width="64"
                          height="64"
                          loading="lazy"
                        >
                      </button>
                      <button
                        type="button"
                        class="compact-thumb-btn thumb-inactive"
                        aria-label="Thumbnail 4"
                        onclick="changeFeaturedMainImage(this, '{{ 'DRIZZY13132.jpg' | asset_url }}')"
                      >
                        <img
                          src="{{ 'DRIZZY13132.jpg' | asset_url }}"
                          alt="Drizzy Bottle Squeeze"
                          class="compact-thumb-img"
                          width="64"
                          height="64"
                          loading="lazy"
                        >
                      </button>
                      <button
                        type="button"
                        class="compact-thumb-btn thumb-inactive"
                        aria-label="Thumbnail 5"
                        onclick="changeFeaturedMainImage(this, '{{ 'DRIZZY12496.jpg' | asset_url }}')"
                      >
                        <img
                          src="{{ 'DRIZZY12496.jpg' | asset_url }}"
                          alt="Drizzy With Berries"
                          class="compact-thumb-img"
                          width="64"
                          height="64"
                          loading="lazy"
                        >
                      </button>
                    {%- endif -%}
                  </div>

                  <!-- Active Image Card -->
                  <div class="compact-main-card">
                    {%- if main_product != blank and main_product.featured_image -%}
                      <img
                        id="FeaturedSectionMainImg"
                        src="{{ main_product.featured_image | image_url: width: 800 }}"
                        alt="{{ main_product.title | escape }}"
                        class="compact-main-img"
                        width="800"
                        height="800"
                        loading="eager"
                      >
                    {%- else -%}
                      <img
                        id="FeaturedSectionMainImg"
                        src="{{ 'USADRIZZYFRONTcopy.jpg' | asset_url }}"
                        alt="Drizzy Squeezy Peanut Butter"
                        class="compact-main-img"
                        width="800"
                        height="800"
                        loading="eager"
                      >
                    {%- endif -%}
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Right Column: Authentic Buy Box -->
          <div class="featured-buybox-col">
            <!-- 5-Star Aussie Reviews -->
            <div class="featured-reviews-rating">
              <div class="featured-stars-row" aria-label="5 stars rating">
                {%- for i in (1..5) -%}
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                  </svg>
                {%- endfor -%}
              </div>
              <span class="featured-rating-text">5.0 Based on 984 Aussie Reviews</span>
            </div>

            <!-- Product Title & Serving Size -->
            <div class="featured-title-area">
              <h2 class="featured-product-title">
                The Ultimate<br>Breakfast Power-Up
              </h2>
              <div class="featured-serving-size">
                19.4 oz (550g)
              </div>
            </div>

            <!-- Dotted Divider -->
            <div class="featured-dashed-divider"></div>

            <!-- Price Display -->
            <div class="featured-price-display">
              <span>{{ product_price }}</span>
            </div>

            <!-- Dotted Divider -->
            <div class="featured-dashed-divider"></div>

            <!-- 3 Authentic Feature Bullet Items with Checkmarks -->
            <div class="featured-feature-list">
              <div class="featured-feature-item">
                <div class="featured-check-icon">
                  <svg width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path
                      d="M0.75 10.75C0.75 6.036 0.75 3.679 2.214 2.214C3.68 0.75 6.036 0.75 10.75 0.75C15.464 0.75 17.821 0.75 19.285 2.214C20.75 3.68 20.75 6.036 20.75 10.75C20.75 15.464 20.75 17.821 19.285 19.285C17.822 20.75 15.464 20.75 10.75 20.75C6.036 20.75 3.679 20.75 2.214 19.285C0.75 17.822 0.75 15.464 0.75 10.75Z"
                      stroke="#F8EBD7"
                      stroke-width="1.5"
                    />
                    <path d="M7.25 11.25L9.25 13.25L14.25 8.25" stroke="#F8EBD7" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </div>
                <div class="featured-feature-text">
                  Simply shake, squeeze and drizzle.
                </div>
              </div>

              <div class="featured-feature-item">
                <div class="featured-check-icon">
                  <svg width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path
                      d="M0.75 10.75C0.75 6.036 0.75 3.679 2.214 2.214C3.68 0.75 6.036 0.75 10.75 0.75C15.464 0.75 17.821 0.75 19.285 2.214C20.75 3.68 20.75 6.036 20.75 10.75C20.75 15.464 20.75 17.821 19.285 19.285C17.822 20.75 15.464 20.75 10.75 20.75C6.036 20.75 3.679 20.75 2.214 19.285C0.75 17.822 0.75 15.464 0.75 10.75Z"
                      stroke="#F8EBD7"
                      stroke-width="1.5"
                    />
                    <path d="M7.25 11.25L9.25 13.25L14.25 8.25" stroke="#F8EBD7" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </div>
                <div class="featured-feature-text">
                  100% Pure American roasted peanuts with a splash of peanut oil. No palm oil, no junk.
                </div>
              </div>

              <div class="featured-feature-item">
                <div class="featured-check-icon">
                  <svg width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path
                      d="M0.75 10.75C0.75 6.036 0.75 3.679 2.214 2.214C3.68 0.75 6.036 0.75 10.75 0.75C15.464 0.75 17.821 0.75 19.285 2.214C20.75 3.68 20.75 6.036 20.75 10.75C20.75 15.464 20.75 17.821 19.285 19.285C17.822 20.75 15.464 20.75 10.75 20.75C6.036 20.75 3.679 20.75 2.214 19.285C0.75 17.822 0.75 15.464 0.75 10.75Z"
                      stroke="#F8EBD7"
                      stroke-width="1.5"
                    />
                    <path d="M7.25 11.25L9.25 13.25L14.25 8.25" stroke="#F8EBD7" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </div>
                <div class="featured-feature-text">
                  7g of protein per serve for everything you love and anything you crave.
                </div>
              </div>
            </div>

            <!-- Add to Cart / Buy Now Action Button -->
            <a
              href="{{ product_url }}"
              class="button-primary featured-cta-link"
            >
              BUY DRIZZY PEANUT BUTTER NOW
            </a>

            <!-- Free Shipping Subtext -->
            <div class="featured-shipping-note">
              FREE SHIPPING ON ORDERS $49.99+
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>

<script>
  function changeFeaturedMainImage(btn, newSrc) {
    var mainImg = document.getElementById('FeaturedSectionMainImg');
    if (mainImg) {
      mainImg.src = newSrc;
    }
    var btns = document.querySelectorAll('.compact-thumb-btn');
    btns.forEach(function(b) {
      b.classList.remove('thumb-active');
      b.classList.add('thumb-inactive');
    });
    btn.classList.remove('thumb-inactive');
    btn.classList.add('thumb-active');
  }
</script>

<style>
