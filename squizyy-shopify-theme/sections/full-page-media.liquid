{%- comment -%}
  Full Page Media & Texas Sourcing Video Story Card
{%- endcomment -%}

<section class="media-story-section">
  <div class="media-story-container container">
    <div class="media-story-card">
      <div class="media-video-wrap">
        <img src="{{ 'texas-story.png' | asset_url }}" alt="Texas Sourcing Story" class="media-poster-img" width="1500" height="864" loading="lazy">
      </div>
      <div class="media-text-wrap">
        <span class="media-kicker">FROM HARVEST TO SQUEEZE</span>
        <h2 class="media-title">BORN IN AUSTRALIA. CRAFTED FOR CLEAN DRIZZLES.</h2>
        <p class="media-desc">
          We set out to fix the messiest food in America without compromising on taste or quality. By pairing Australia's finest high-oleic crop with precision precision squeeze bottles, Drizzy brings you liquid gold without the hassle.
        </p>
        <a href="/pages/our-story" class="button-primary media-btn">Read Our Story</a>
      </div>
    </div>
  </div>
</section>

<style>
.media-story-section {
  padding: 4rem 0;
}
.media-story-card {
  display: grid;
  grid-template-columns: 1fr;
  background-color: var(--color-foreground, #2d0f28);
  color: #ffffff;
  border-radius: var(--radius-2xl, 32px);
  overflow: hidden;
  box-shadow: 0 16px 0 var(--color-accent-purple, #ca9af1);
}
@media (min-width: 1024px) {
  .media-story-card {
    grid-template-columns: 1.2fr 1fr;
  }
}
.media-video-wrap {
  width: 100%;
  height: 100%;
  min-height: 340px;
}
.media-poster-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.media-text-wrap {
  padding: 3.5rem 2.5rem;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.media-kicker {
  font-family: var(--font-secondary, 'Azeret Mono', monospace);
  font-size: 0.8125rem;
  font-weight: 700;
  color: var(--color-accent-purple, #ca9af1);
  letter-spacing: 0.05em;
  margin-bottom: 0.75rem;
}
.media-title {
  font-family: var(--font-primary, 'Champ Black', serif);
  font-size: clamp(2rem, 3.5vw, 2.75rem);
  line-height: 1.05;
  margin: 0 0 1.25rem 0;
  text-transform: uppercase;
}
.media-desc {
  font-size: 1rem;
  line-height: 1.6;
  opacity: 0.85;
  margin: 0 0 2rem 0;
}
.media-btn {
  align-self: flex-start;
}
</style>

{% schema %}
{
  "name": "Full Page Media Story",
  "settings": [],
  "presets": [
    {
      "name": "Full Page Media Story"
    }
  ]
}
{% endschema %}
