{%- comment -%}
  Full Page Media & Texas Quality Sourcing Story with Overlaid Card
  Faithfully ported from client/src/components/sections/FullPageMedia.jsx & FullPageMedia.module.css
{%- endcomment -%}

{%- assign our_story_url = pages['our-story'].url | default: '/pages/our-story' -%}

<div id="shopify-section-full-page-media" class="shopify-section">
  <section class="media-section" aria-label="Texas Sourcing Story">
    <div class="media-frame">
      {%- assign media_video_url = section.settings.video_url | default: 'https://squizyy.co/cdn/shop/videos/c/vp/f8c9f00eee0542fe9b97a3f8467190b6/f8c9f00eee0542fe9b97a3f8467190b6.HD-1080p-4.8Mbps-91858336.mp4' -%}
      <!-- Background Media Video / Poster -->
      <video
        playsinline
        muted
        autoplay
        loop
        class="media-bg-video"
        poster="{{ 'f8c9f00eee0542fe9b97a3f8467190b6.thumbnail.0000000000_1.jpg' | asset_url }}"
      >
        <source
          src="{{ media_video_url }}"
          type="video/mp4"
        >
        <img
          src="{{ 'f8c9f00eee0542fe9b97a3f8467190b6.thumbnail.0000000000_1.jpg' | asset_url }}"
          alt="Squizyy Texas Peanut Harvesting"
          class="media-bg-video"
          width="1100"
          height="615"
          loading="lazy"
        >
      </video>

      <!-- Overlaid Quality Story Card -->
      <div class="media-overlay-container">
        <div class="media-story-card-wrapper">
          <div class="media-story-card">
            <h3 class="media-story-heading">
              {{ section.settings.heading | default: 'Made by People Who Take Quality Very Seriously' }}
            </h3>

            <p class="media-story-p">
              {{ section.settings.paragraph_1 | default: "We source exclusively from Texas for a deeper roast and a smoother drizzle you won't find in supermarket jars." }}
            </p>

            <h4 class="media-story-subheading">
              {{ section.settings.subheading | default: "Using the 'Runner' Peanut" }}
            </h4>

            <p class="media-story-p">
              {{ section.settings.paragraph_2 | default: "Known for its high oil content and rich flavor, it's the secret to our ultra-smooth, no-clog drizzle." }}
            </p>

            <div class="media-dashed-divider">
              SOURCED FROM TEXAS
            </div>

            <div class="media-dashed-divider">
              NEXT HARVESTING SEASON STARTING OCTOBER 2026
            </div>

            <a href="{{ section.settings.button_link | default: our_story_url }}" class="media-cta-link">
              {{ section.settings.button_label | default: 'Read Our Story' }}
            </a>
          </div>

          <!-- Floating Peanut Sticker on Card -->
          <div class="media-peanut-sticker animate-float" aria-hidden="true">
            <img
              src="{{ 'peanut-tiny_4d50f3b6-6cfe-4e9e-8328-52d5470a73a6.png' | asset_url }}"
              alt=""
              class="media-peanut-img"
              width="100"
              height="100"
              loading="lazy"
            >
          </div>
        </div>
      </div>
    </div>
  </section>
</div>

<style>
.media-section {
  background-color: var(--color-background, #f8ebd7);
  color: var(--color-foreground, #2d0f28);
  padding: 2.5rem 1rem;
  box-sizing: border-box;
}
@media (min-width: 1024px) {
  .media-section {
    padding: 1.5rem 2rem;
  }
}
.media-frame {
  position: relative;
  width: 100%;
  max-width: 1500px;
  margin: 0 auto;
  border-radius: var(--radius-2xl, 24px);
  overflow: hidden;
  height: 62.5rem;
}
@media (min-width: 1024px) {
  .media-frame {
    border-radius: 40px;
    height: 85vh;
    min-height: 550px;
  }
}
.media-bg-video {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.media-overlay-container {
  position: absolute;
  inset: 0;
  z-index: 2;
  display: flex;
  align-items: flex-end;
  padding: 1.5rem 1rem;
  box-sizing: border-box;
}
@media (min-width: 1024px) {
  .media-overlay-container {
    align-items: center;
    padding: 2.5rem 4rem;
  }
}
.media-story-card-wrapper {
  position: relative;
  width: 100%;
  max-width: 460px;
}
@media (min-width: 1024px) {
  .media-story-card-wrapper {
    max-width: 560px;
  }
}
.media-story-card {
  background-color: var(--color-cream, #fffbf2);
  border-radius: var(--radius-2xl, 32px);
  padding: 2rem 1.5rem;
  border: 2px solid var(--color-foreground, #2d0f28);
  box-shadow: 0 16px 36px rgba(45, 15, 40, 0.2);
  color: var(--color-foreground, #2d0f28);
  display: flex;
  flex-direction: column;
  gap: 1rem;
  box-sizing: border-box;
}
@media (min-width: 1024px) {
  .media-story-card {
    padding: 2.5rem;
    gap: 1.25rem;
  }
}
.media-story-heading {
  font-family: var(--font-primary, 'Champ Black', serif);
  color: var(--color-foreground, #2d0f28);
  font-size: 28px;
  line-height: 1.05;
  text-transform: uppercase;
  margin: 0;
  letter-spacing: -0.01em;
}
@media (min-width: 640px) {
  .media-story-heading {
    font-size: 34px;
  }
}
@media (min-width: 1024px) {
  .media-story-heading {
    font-size: 38px;
  }
}
.media-story-p {
  font-family: var(--font-secondary, 'Azeret Mono', monospace);
  font-size: 13px;
  color: rgba(45, 15, 40, 0.9);
  line-height: 1.6;
  margin: 0;
}
@media (min-width: 640px) {
  .media-story-p {
    font-size: 14px;
  }
}
.media-story-subheading {
  font-family: var(--font-primary, 'Champ Black', serif);
  font-size: 16px;
  text-transform: uppercase;
  color: var(--color-foreground, #2d0f28);
  margin: 0.25rem 0 0 0;
}
@media (min-width: 640px) {
  .media-story-subheading {
    font-size: 18px;
  }
}
.media-dashed-divider {
  border-top: 1px dashed rgba(45, 15, 40, 0.4);
  padding-top: 0.75rem;
  font-family: var(--font-secondary, 'Azeret Mono', monospace);
  font-size: 11px;
  text-transform: uppercase;
  color: var(--color-foreground, #2d0f28);
  font-weight: 700;
  letter-spacing: 0.05em;
  margin: 0;
}
@media (min-width: 640px) {
  .media-dashed-divider {
    font-size: 12px;
  }
}
.media-cta-link {
  display: inline-flex;
  white-space: nowrap;
  transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  align-items: center;
  justify-content: center;
  text-decoration: none;
  text-transform: uppercase;
  border-radius: var(--radius-full, 9999px);
  width: 100%;
  font-size: 15px;
  font-family: var(--font-primary, 'Champ Black', serif);
  line-height: 1;
  padding: 1rem 1.75rem;
  background-color: var(--color-accent-purple, #ca9af1);
  color: var(--color-foreground, #2d0f28);
  border: 2px solid var(--color-foreground, #2d0f28);
  box-shadow: 0 4px 0 var(--color-foreground, #2d0f28);
  cursor: pointer;
  margin-top: 0.5rem;
  box-sizing: border-box;
}
.media-cta-link:hover {
  background-color: var(--color-cream, #fffbf2);
  transform: translateY(-2px);
  box-shadow: 0 6px 0 var(--color-foreground, #2d0f28);
}
.media-cta-link:active {
  transform: translateY(1px);
  box-shadow: 0 2px 0 var(--color-foreground, #2d0f28);
}
@media (min-width: 640px) {
  .media-cta-link {
    width: auto;
    font-size: 16px;
  }
}
.media-peanut-sticker {
  position: absolute;
  aspect-ratio: 1 / 1;
  width: 100px;
  top: -70px;
  right: 10px;
  pointer-events: none;
  filter: drop-shadow(0 12px 20px rgba(0, 0, 0, 0.2));
  z-index: 5;
}
@media (min-width: 1024px) {
  .media-peanut-sticker {
    width: 140px;
    top: auto;
    bottom: 15%;
    right: -15%;
  }
}
.media-peanut-img {
  width: 100%;
  height: auto;
  object-fit: contain;
  display: block;
}
</style>

{% schema %}
{
  "name": "Full Page Media",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Card Heading",
      "default": "Made by People Who Take Quality Very Seriously"
    },
    {
      "type": "textarea",
      "id": "paragraph_1",
      "label": "Paragraph 1",
      "default": "We source exclusively from Texas for a deeper roast and a smoother drizzle you won't find in supermarket jars."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Using the 'Runner' Peanut"
    },
    {
      "type": "textarea",
      "id": "paragraph_2",
      "label": "Paragraph 2",
      "default": "Known for its high oil content and rich flavor, it's the secret to our ultra-smooth, no-clog drizzle."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Read Our Story"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Full Page Media"
    }
  ]
}
{% endschema %}
