<section class="wholesale-hero-section">
  <div class="wholesale-hero-stage">
    <div class="wholesale-hero-bg">
      {%- if section.settings.image_desktop != blank -%}
        {{ section.settings.image_desktop | image_url: width: 2000 | image_tag: class: 'wholesale-hero-img-desktop', alt: section.settings.heading }}
      {%- else -%}
        <img src="{{ 'wholesale-hero.png' | asset_url }}" alt="Wholesale banner" class="wholesale-hero-img-desktop" width="1500" height="467">
      {%- endif -%}
      {%- if section.settings.image_mobile != blank -%}
        {{ section.settings.image_mobile | image_url: width: 800 | image_tag: class: 'wholesale-hero-img-mobile', alt: section.settings.heading }}
      {%- else -%}
        <img src="{{ 'wholesale-hero-mobile.png' | asset_url }}" alt="Wholesale banner mobile" class="wholesale-hero-img-mobile" width="375" height="489">
      {%- endif -%}
    </div>

    <div class="wholesale-hero-card">
      <h1 class="wholesale-hero-title">{{ section.settings.heading | default: 'Partner with Drizzy' }}</h1>
      <p class="wholesale-hero-desc">{{ section.settings.description | default: "Partner with a brand that values quality and simplicity. Tell us about your store and let's grow together." }}</p>
      <div class="wholesale-hero-login">
        <p>Already a partner? <a href="#contact_form">Login</a></p>
      </div>
    </div>
  </div>
</section>

<!-- Ticker Sub-bar -->
<div class="wholesale-marquee-bar">
  <div class="wholesale-marquee-track">
    <div class="wholesale-marquee-content">
      {%- for i in (1..3) -%}
        <div class="wholesale-ticker-item">
          <img src="{{ 'aussie.png' | asset_url }}" alt="" class="wholesale-ticker-icon" width="57" height="60">
          <span>Aussie owned</span>
        </div>
        <div class="wholesale-ticker-item">
          <img src="{{ 'smile.png' | asset_url }}" alt="" class="wholesale-ticker-icon" width="57" height="60">
          <span>Ultra-Smooth Drizzle</span>
        </div>
        <div class="wholesale-ticker-item">
          <img src="{{ 'zero-sugar.png' | asset_url }}" alt="" class="wholesale-ticker-icon" width="57" height="60">
          <span>Zero added sugar</span>
        </div>
        <div class="wholesale-ticker-item">
          <img src="{{ 'natural-fuel.png' | asset_url }}" alt="" class="wholesale-ticker-icon" width="57" height="60">
          <span>Natural fuel</span>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
.wholesale-hero-section {
  background-color: var(--color-background, #fffaf3);
  color: var(--color-foreground, #2b1408);
  padding: 1.5rem 0.75rem 0 0.75rem;
}
@media (min-width: 1024px) {
  .wholesale-hero-section {
    padding: 1.5rem 1rem 0 1rem;
  }
}
.wholesale-hero-stage {
  position: relative;
  width: 100%;
  height: 28.125rem;
  margin-bottom: 4rem;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 0 0.75rem;
  max-width: 87.5rem;
  margin-left: auto;
  margin-right: auto;
  box-sizing: border-box;
}
@media (min-width: 1024px) {
  .wholesale-hero-stage {
    margin-bottom: 2rem;
  }
}
.wholesale-hero-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  border-radius: var(--radius-2xl, 24px);
  overflow: hidden;
  z-index: 0;
}
@media (min-width: 1024px) {
  .wholesale-hero-bg {
    border-radius: 40px;
  }
}
.wholesale-hero-img-desktop {
  display: none;
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.wholesale-hero-img-mobile {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}
@media (min-width: 1024px) {
  .wholesale-hero-img-desktop {
    display: block;
  }
  .wholesale-hero-img-mobile {
    display: none;
  }
}
.wholesale-hero-card {
  position: relative;
  z-index: 1;
  width: 100%;
  max-width: 932px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
  background-color: var(--color-cream, #fffbf2);
  gap: 0.75rem;
  border-radius: var(--radius-2xl, 32px);
  padding: 2rem 1.5rem;
  border: 4px solid var(--color-dark-brown, #2b1408);
  border-bottom-width: 8px;
  margin-bottom: -4rem;
  box-shadow: 0 20px 40px rgba(43, 20, 8, 0.15);
  color: var(--color-dark-brown, #2b1408);
  box-sizing: border-box;
}
.wholesale-hero-title {
  font-family: var(--font-primary, 'Champ Black', serif);
  font-size: 2.25rem;
  line-height: 1;
  text-transform: uppercase;
  color: var(--color-dark-brown, #2b1408);
  margin: 0;
}
@media (min-width: 640px) {
  .wholesale-hero-title {
    font-size: 3rem;
  }
}
@media (min-width: 1024px) {
  .wholesale-hero-title {
    font-size: 4rem;
  }
}
.wholesale-hero-desc {
  font-size: 0.95rem;
  line-height: 1.5;
  color: var(--color-dark-brown, #2b1408);
  max-width: 42ch;
  margin: 0;
}
@media (min-width: 640px) {
  .wholesale-hero-desc {
    font-size: 1.125rem;
  }
}
.wholesale-hero-login p {
  font-size: 12px;
  font-family: var(--font-secondary, 'Azeret Mono', monospace);
  color: rgba(43, 20, 8, 0.75);
  margin: 0;
}
.wholesale-hero-login a {
  font-weight: 700;
  color: var(--color-dark-brown, #2b1408);
  text-decoration: underline;
}
.wholesale-marquee-bar {
  color: var(--color-dark-brown, #2b1408);
  background-color: var(--color-cream, #fffbf2);
  padding-top: 3.5rem;
  padding-bottom: 2rem;
  overflow: hidden;
  border-bottom: 2px solid rgba(43, 20, 8, 0.15);
}
.wholesale-marquee-track {
  display: flex;
  overflow: hidden;
  user-select: none;
}
.wholesale-marquee-content {
  display: flex;
  justify-content: space-around;
  flex-shrink: 0;
  min-width: 100%;
  animation: marquee 25s linear infinite;
}
.wholesale-ticker-item {
  display: flex;
  align-items: center;
  gap: 1rem;
  padding-right: 60px;
}
.wholesale-ticker-icon {
  height: 3rem;
  width: 3rem;
  object-fit: contain;
}
.wholesale-ticker-item span {
  font-family: var(--font-primary, 'Champ Black', serif);
  font-size: 1.25rem;
  text-transform: uppercase;
  color: var(--color-dark-brown, #2b1408);
  margin: 0;
  white-space: nowrap;
}
</style>

{% schema %}
{
  "name": "Wholesale Hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Partner with Drizzy"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Partner with a brand that values quality and simplicity. Tell us about your store and let's grow together."
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Desktop Banner Image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile Banner Image"
    }
  ],
  "presets": [
    {
      "name": "Wholesale Hero"
    }
  ]
}
{% endschema %}
