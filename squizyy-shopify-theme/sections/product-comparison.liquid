{%- comment -%}
  "Kiss Your Jar Goodbye, Mwa!" Comparison Section
  Faithfully ported from client/src/components/product/ComparisonTable.jsx & ComparisonTable.module.css
{%- endcomment -%}

<div class="comparison-wrapper">
  <section class="comparison-section" aria-label="Product Comparison">
    <!-- Floating Peanut Left -->
    <div class="comparison-peanut-left" aria-hidden="true">
      <img
        src="{{ 'drizzy-peanut-left.png' | asset_url }}"
        alt=""
        width="512"
        height="512"
        loading="lazy"
      >
    </div>

    <!-- Product Bottle Left -->
    <div class="comparison-bottle-left" aria-hidden="true">
      <img
        src="{{ 'product-bottle-left.png' | asset_url }}"
        alt="Drizzy Bottle"
        width="750"
        height="1008"
        loading="lazy"
      >
    </div>

    <!-- Floating Peanut Right -->
    <div class="comparison-peanut-right" aria-hidden="true">
      <img
        src="{{ 'drizzy-peanut-left.png' | asset_url }}"
        alt=""
        width="512"
        height="512"
        loading="lazy"
      >
    </div>

    <!-- Other Product Right (Messy Jars) -->
    <div class="comparison-other-right" aria-hidden="true">
      <img
        src="{{ 'other-product-right.png' | asset_url }}"
        alt="Standard Peanut Butter Jars"
        width="900"
        height="759"
        loading="lazy"
      >
    </div>

    <div class="comparison-main-wrapper">
      <!-- Top Cream Dripping Graphic -->
      <div class="comparison-drip-top">
        <img
          src="{{ 'cream-drip.svg' | asset_url }}"
          alt=""
          class="comparison-drip-desktop"
          width="1408"
          height="275"
          loading="lazy"
        >
        <img
          src="{{ 'cream-drip-mobile.svg' | asset_url }}"
          alt=""
          class="comparison-drip-mobile"
          width="336"
          height="121"
          loading="lazy"
        >
      </div>

      <!-- Headline & Comparison Badges -->
      <div class="comparison-container">
        <h2 class="comparison-headline">
          {{ section.settings.headline | default: 'Kiss Your Jar Goodbye, Mwa!' }}
        </h2>

        <div class="comparison-vs-row">
          <!-- Left (Drizzy) Perks -->
          <div class="comparison-left-perks">
            <div class="comparison-pill-badge">PERFECTLY SMOOTH</div>
            <div class="comparison-pill-badge">SQUEEZE AND DRIZZLE</div>
            <div class="comparison-pill-badge">ZERO MESS</div>
          </div>

          <!-- Center VS Circle -->
          <div class="comparison-vs-circle" aria-hidden="true">
            VS
          </div>

          <!-- Right (Standard Jars) Pain Points -->
          <div class="comparison-right-pains">
            <div class="comparison-pill-badge">HARD TO STIR</div>
            <div class="comparison-pill-badge">SCOOP AND SCRAPE</div>
            <div class="comparison-pill-badge">SOMEHOW GET IT EVERYWHERE</div>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>

<style>
.comparison-wrapper {
  position: relative;
  width: 100%;
}
.comparison-section {
  position: relative;
  background-color: var(--color-accent-purple, #ca9af1);
  color: var(--color-foreground, #2d0f28);
  padding: 0;
  overflow: hidden;
}
.comparison-peanut-left {
  display: none;
  position: absolute;
  width: 17vw;
  transform: rotate(-60deg);
  left: -6vw;
  top: 16%;
  z-index: 2;
  pointer-events: none;
}
@media (min-width: 768px) {
  .comparison-peanut-left {
    display: block;
  }
}
@media (min-width: 1024px) {
  .comparison-peanut-left {
    top: 65%;
  }
}
.comparison-bottle-left {
  position: absolute;
  width: 58vw;
  left: 0;
  top: 20%;
  z-index: 1;
  pointer-events: none;
}
@media (min-width: 768px) {
  .comparison-bottle-left {
    width: 35vw;
    left: -2rem;
  }
}
.comparison-peanut-right {
  display: none;
  position: absolute;
  width: 6.25vw;
  transform: rotate(-14deg);
  right: -1.5%;
  top: 20%;
  z-index: 2;
  pointer-events: none;
}
@media (min-width: 768px) {
  .comparison-peanut-right {
    display: block;
  }
}
.comparison-other-right {
  position: absolute;
  width: 86vw;
  right: -10vw;
  bottom: 10%;
  z-index: 1;
  pointer-events: none;
}
@media (min-width: 768px) {
  .comparison-other-right {
    width: 35vw;
    right: -0.625rem;
    bottom: 25%;
  }
}
.comparison-main-wrapper {
  background-color: var(--color-accent-purple, #ca9af1);
  width: 100%;
}
.comparison-drip-top {
  width: 100%;
}
.comparison-drip-desktop {
  display: none;
  width: 100%;
  height: auto;
  object-fit: cover;
}
@media (min-width: 768px) {
  .comparison-drip-desktop {
    display: block;
  }
}
.comparison-drip-mobile {
  display: block;
  width: 100%;
  height: auto;
  object-fit: cover;
}
@media (min-width: 768px) {
  .comparison-drip-mobile {
    display: none;
  }
}
.comparison-container {
  position: relative;
  max-width: 925px;
  margin-left: auto;
  margin-right: auto;
  margin-top: 0.75rem;
  padding: 0 1rem 25vh;
  z-index: 3;
}
@media (min-width: 1024px) {
  .comparison-container {
    padding-bottom: 20vh;
  }
}
.comparison-headline {
  font-family: var(--font-primary, 'Champ Black', serif);
  color: var(--color-foreground, #2d0f28);
  font-size: 2.125rem;
  line-height: 1.05;
  text-align: center;
  margin-left: auto;
  margin-right: auto;
  max-width: 800px;
  text-transform: uppercase;
}
@media (min-width: 640px) {
  .comparison-headline {
    font-size: 2.75rem;
  }
}
@media (min-width: 1024px) {
  .comparison-headline {
    font-size: 3.375rem;
  }
}
.comparison-vs-row {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-direction: column;
  gap: 2rem;
  margin-top: 4rem;
}
@media (min-width: 768px) {
  .comparison-vs-row {
    flex-direction: row;
    gap: 0;
    margin-top: 4.25rem;
  }
}
.comparison-left-perks {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  align-items: center;
}
@media (min-width: 768px) {
  .comparison-left-perks {
    align-items: flex-start;
    flex-basis: 33.333%;
  }
}
.comparison-right-pains {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  align-items: center;
}
@media (min-width: 768px) {
  .comparison-right-pains {
    align-items: flex-end;
    flex-basis: 33.333%;
  }
}
.comparison-pill-badge {
  width: fit-content;
  font-family: var(--font-primary, 'Champ Black', serif);
  font-size: 0.8125rem;
  line-height: 1;
  text-transform: uppercase;
  padding: 0.625rem 1.25rem;
  background-color: var(--color-cream, #fffbf2);
  border-radius: var(--radius-pill, 9999px);
  border: 2px solid var(--color-foreground, #2d0f28);
  color: var(--color-foreground, #2d0f28);
  box-shadow: 0 1px 3px rgba(45, 15, 40, 0.08);
}
@media (min-width: 1024px) {
  .comparison-pill-badge {
    font-size: 1rem;
    padding: 0.75rem 1.5rem;
  }
}
.comparison-vs-circle {
  margin-top: 1rem;
  width: 5rem;
  height: 5rem;
  aspect-ratio: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 50%;
  background-color: var(--color-foreground, #2d0f28);
  color: var(--color-cream, #fffbf2);
  font-family: var(--font-primary, 'Champ Black', serif);
  font-size: 1.5rem;
  box-shadow: 0 4px 12px rgba(45, 15, 40, 0.12);
  border: 2px solid var(--color-foreground, #2d0f28);
  flex-shrink: 0;
}
@media (min-width: 768px) {
  .comparison-vs-circle {
    margin-top: 0;
  }
}
</style>

{% schema %}
{
  "name": "Product Comparison",
  "settings": [
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Kiss Your Jar Goodbye, Mwa!"
    }
  ],
  "presets": [
    {
      "name": "Product Comparison"
    }
  ]
}
{% endschema %}
