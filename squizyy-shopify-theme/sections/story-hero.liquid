{%- comment -%}
  Our Story Hero with Interactive Flight Route Map
{%- endcomment -%}

<section class="story-hero-section">
  <div class="story-hero-container container">
    <div class="story-hero-header">
      <span class="story-kicker">FROM SYDNEY TO TEXAS</span>
      <h1 class="story-title">THE STORY OF DRIZZY</h1>
      <p class="story-lead">
        Two peanut-butter-obsessed Aussies, tired of broken toast and messy knives, set out to bring the world's best peanuts to America in a bottle you can actually drizzle.
      </p>
    </div>

    <!-- Flight Map Card -->
    <div class="story-map-card">
      <img src="{{ 'map-v2.png' | asset_url }}" alt="Flight Path from Australia to USA" class="story-map-img">
      
      <!-- Australian Pin Badge -->
      <div class="map-pin pin-aus">
        <span class="pin-dot"></span>
        <span class="pin-label">Kingaroy, Australia</span>
      </div>

      <!-- USA Pin Badge -->
      <div class="map-pin pin-usa">
        <span class="pin-dot"></span>
        <span class="pin-label">Austin, Texas</span>
      </div>
    </div>
  </div>
</section>

<style>
.story-hero-section {
  padding: 4rem 0 5rem;
}
.story-hero-header {
  text-align: center;
  max-width: 720px;
  margin: 0 auto 3.5rem;
}
.story-kicker {
  font-family: var(--font-secondary, 'Azeret Mono', monospace);
  font-size: 0.8125rem;
  font-weight: 700;
  color: var(--color-accent-green, #036e2c);
  letter-spacing: 0.05em;
  display: block;
  margin-bottom: 0.5rem;
}
.story-title {
  font-family: var(--font-primary, 'Champ Black', serif);
  font-size: clamp(2.5rem, 5vw, 4rem);
  color: var(--color-foreground, #2d0f28);
  margin: 0 0 1rem 0;
  text-transform: uppercase;
}
.story-lead {
  font-size: 1.125rem;
  line-height: 1.6;
  opacity: 0.85;
  margin: 0;
}
.story-map-card {
  position: relative;
  border: 4px solid var(--color-foreground, #2d0f28);
  border-radius: var(--radius-2xl, 32px);
  overflow: hidden;
  box-shadow: 0 12px 0 var(--color-foreground, #2d0f28);
  background-color: var(--color-cream, #fffbf2);
}
.story-map-img {
  width: 100%;
  height: auto;
  display: block;
}
.map-pin {
  position: absolute;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  background-color: var(--color-foreground, #2d0f28);
  color: #ffffff;
  padding: 0.4rem 0.85rem;
  border-radius: var(--radius-full);
  font-family: var(--font-secondary, 'Azeret Mono', monospace);
  font-size: 0.75rem;
  font-weight: 700;
  box-shadow: 0 4px 8px rgba(0,0,0,0.2);
}
.pin-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background-color: var(--color-accent-purple, #ca9af1);
}
.pin-aus {
  bottom: 25%;
  left: 20%;
}
.pin-usa {
  top: 35%;
  right: 25%;
}
</style>

{% schema %}
{
  "name": "Story Hero",
  "settings": [],
  "presets": [
    {
      "name": "Story Hero"
    }
  ]
}
{% endschema %}
