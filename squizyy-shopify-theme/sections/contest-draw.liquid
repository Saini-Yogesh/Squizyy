<section class="contest-draw-section" id="draw-form">
  <div class="contest-draw-container">
    <div class="contest-draw-row">
      <!-- Mascot Illustration -->
      <div class="contest-draw-mascot-col">
        <img src="{{ 'man.svg' | asset_url }}" alt="Drizzy Mascot" class="contest-draw-mascot">
      </div>

      <!-- Form Column -->
      <div class="contest-draw-form-col">
        <div class="contest-draw-card">
          <h2 class="contest-draw-title">{{ section.settings.heading | default: 'Enter the Draw' }}</h2>

          {%- form 'contact', id: 'contest_form', class: 'contest-draw-inner' -%}
            {%- if form.posted_successfully? -%}
              <div class="contest-draw-success">
                <p class="contest-success-title">🎉 Entry Received!</p>
                <p class="contest-success-desc">Congratulations! You are officially entered into the draw to win flights to Australia.</p>
              </div>
            {%- else -%}
              {%- if form.errors -%}
                <div class="contest-draw-errors" role="alert">
                  {{ form.errors | default_errors }}
                </div>
              {%- endif -%}

              <!-- Hidden identifier tag for contest entry -->
              <input type="hidden" name="contact[tags]" value="contest-sprouts-australia">

              <!-- Name Fields -->
              <div class="contest-form-name-row">
                <div class="contest-field-group">
                  <label for="Contest-first-name" class="contest-field-label">First Name *</label>
                  <input
                    type="text"
                    id="Contest-first-name"
                    name="contact[first_name]"
                    placeholder="First Name"
                    required
                    class="contest-input"
                  >
                </div>
                <div class="contest-field-group">
                  <label for="Contest-last-name" class="contest-field-label">Last Name *</label>
                  <input
                    type="text"
                    id="Contest-last-name"
                    name="contact[last_name]"
                    placeholder="Last Name"
                    required
                    class="contest-input"
                  >
                </div>
              </div>

              <!-- Email Field -->
              <div class="contest-field-group">
                <label for="Contest-email" class="contest-field-label">Email Address *</label>
                <input
                  type="email"
                  id="Contest-email"
                  name="contact[email]"
                  placeholder="Your Sprouts-linked email address"
                  required
                  class="contest-input"
                >
              </div>

              <!-- Receipt File Dropzone -->
              <div class="contest-field-group">
                <div class="contest-dropzone-header">
                  <label class="contest-field-label" style="margin-bottom: 0;">Drop Your Receipt *</label>
                  <span id="contest-file-name" class="contest-file-badge" style="display: none;"></span>
                </div>

                <label class="contest-upload-dropzone" for="contest-file-input">
                  <div class="contest-dropzone-inner">
                    <svg class="contest-upload-icon" viewBox="0 0 24 24" fill="none">
                      <path d="M11 16V7.85L8.4 10.45L7 9L12 4L17 9L15.6 10.45L13 7.85V16H11ZM6 20C5.45 20 4.97933 19.8043 4.588 19.413C4.19667 19.0217 4.00067 18.5507 4 18V15H6V18H18V15H20V18C20 18.55 19.8043 19.021 19.413 19.413C19.0217 19.805 18.5507 20.0007 18 20H6Z" fill="#2d0f28"/>
                    </svg>
                    <span>click to upload receipt image or PDF</span>
                  </div>
                  <input
                    type="file"
                    id="contest-file-input"
                    name="contact[receipt_file]"
                    accept="image/*,.pdf"
                    style="display: none;"
                    onchange="if(this.files && this.files[0]) { var b = document.getElementById('contest-file-name'); b.innerText = '✓ ' + this.files[0].name; b.style.display = 'inline-block'; }"
                  >
                </label>
              </div>

              <!-- Checkboxes -->
              <div class="contest-checkboxes">
                <label class="contest-checkbox-label">
                  <input type="checkbox" required class="contest-checkbox">
                  <span>
                    I certify that I am 18+ and agree to the
                    <a href="{{ routes.root_url }}pages/rules" target="_blank" rel="noopener noreferrer">Official Rules</a>
                    and
                    <a href="{{ routes.root_url }}policies/privacy-policy" target="_blank" rel="noopener noreferrer">Privacy Policy</a>.
                  </span>
                </label>

                <label class="contest-checkbox-label">
                  <input type="checkbox" name="customer[accepts_marketing]" value="true" checked class="contest-checkbox">
                  <span>Sign me up to receive updates and sweet deals from Drizzy!</span>
                </label>
              </div>

              <!-- Submit Button -->
              <div class="contest-submit-wrap">
                <button type="submit" class="button-primary contest-submit-btn">
                  SUBMIT ENTRY
                </button>
              </div>
            {%- endif -%}
          {%- endform -%}
        </div>

        <!-- Rules Banner Box -->
        <div class="contest-rules-banner">
          <p class="contest-rules-links">
            <a href="{{ routes.root_url }}pages/rules" target="_blank" rel="noopener noreferrer">OFFICIAL RULES</a>
            |
            <a href="{{ routes.root_url }}policies/privacy-policy" target="_blank" rel="noopener noreferrer">PRIVACY POLICY</a>
          </p>
          <p class="contest-rules-text">
            <strong>NO PURCHASE NECESSARY; </strong>void where prohibited. Open to U.S. residents, 18+. Ends 9/20/26.
            <strong>Limit one (1) entry per person total. </strong>Two entry methods: (i) A qualifying purchase of Drizzy peanut butter at Sprouts Farmers Market, or (ii) mail-in entry. See Official Rules at
            <a href="{{ routes.root_url }}pages/rules">Official Rules</a> for details. Sponsor: Drizzy Holdings Inc., 90 Park Ave., NY, NY 10016.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
.contest-draw-section {
  background-color: var(--color-background, #fffaf3);
  padding: 4rem 1rem 6rem 1rem;
}
@media (min-width: 1024px) {
  .contest-draw-section {
    padding: 5rem 1.5rem 8rem 1.5rem;
  }
}
.contest-draw-container {
  max-width: 87.5rem;
  margin: 0 auto;
}
.contest-draw-row {
  display: flex;
  flex-direction: column;
  gap: 3rem;
  align-items: center;
}
@media (min-width: 1024px) {
  .contest-draw-row {
    flex-direction: row;
    align-items: flex-start;
    gap: 4rem;
  }
}
.contest-draw-mascot-col {
  width: 100%;
  display: flex;
  justify-content: center;
}
@media (min-width: 1024px) {
  .contest-draw-mascot-col {
    width: 40%;
    position: sticky;
    top: 6rem;
  }
}
.contest-draw-mascot {
  width: 100%;
  max-width: 380px;
  height: auto;
  object-fit: contain;
}
.contest-draw-form-col {
  width: 100%;
}
@media (min-width: 1024px) {
  .contest-draw-form-col {
    width: 60%;
  }
}
.contest-draw-card {
  background-color: var(--color-cream, #fffbf2);
  border: 4px solid var(--color-dark-brown, #2b1408);
  border-bottom-width: 8px;
  border-radius: var(--radius-2xl, 32px);
  padding: 2rem 1.5rem;
  box-shadow: 0 20px 40px rgba(43, 20, 8, 0.12);
  color: var(--color-dark-brown, #2b1408);
  box-sizing: border-box;
}
@media (min-width: 768px) {
  .contest-draw-card {
    padding: 3rem 2.5rem;
  }
}
.contest-draw-title {
  font-family: var(--font-primary, 'Champ Black', serif);
  font-size: 2.25rem;
  line-height: 1.05;
  text-transform: uppercase;
  color: var(--color-dark-brown, #2b1408);
  margin: 0 0 2rem 0;
  text-align: center;
}
@media (min-width: 640px) {
  .contest-draw-title {
    font-size: 3rem;
  }
}
.contest-draw-inner {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}
.contest-form-name-row {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1rem;
}
@media (min-width: 640px) {
  .contest-form-name-row {
    grid-template-columns: 1fr 1fr;
  }
}
.contest-field-group {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}
.contest-field-label {
  font-family: var(--font-secondary, 'Azeret Mono', monospace);
  font-size: 0.85rem;
  font-weight: 700;
  text-transform: uppercase;
  color: var(--color-dark-brown, #2b1408);
}
.contest-input {
  width: 100%;
  padding: 0.875rem 1.25rem;
  border-radius: var(--radius-full, 9999px);
  border: 2px solid var(--color-dark-brown, #2b1408);
  background-color: #fff;
  font-family: var(--font-secondary, 'Azeret Mono', monospace);
  font-size: 0.9rem;
  color: var(--color-dark-brown, #2b1408);
  outline: none;
  box-sizing: border-box;
  transition: box-shadow 0.2s ease;
}
.contest-input:focus {
  box-shadow: 0 0 0 3px rgba(202, 154, 241, 0.5);
}
.contest-dropzone-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.contest-file-badge {
  font-size: 12px;
  font-family: var(--font-secondary, 'Azeret Mono', monospace);
  font-weight: 700;
  color: var(--color-accent-green, #176537);
}
.contest-upload-dropzone {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1.5rem;
  border: 2px dashed var(--color-dark-brown, #2b1408);
  border-radius: 20px;
  background-color: rgba(255, 255, 255, 0.6);
  cursor: pointer;
  transition: background-color 0.2s ease;
}
.contest-upload-dropzone:hover {
  background-color: #fff;
}
.contest-dropzone-inner {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  color: var(--color-dark-brown, #2b1408);
  font-family: var(--font-secondary, 'Azeret Mono', monospace);
  font-size: 13px;
  font-weight: 700;
}
.contest-upload-icon {
  width: 1.5rem;
  height: 1.5rem;
}
.contest-checkboxes {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  padding-top: 0.5rem;
}
.contest-checkbox-label {
  display: flex;
  align-items: flex-start;
  gap: 0.75rem;
  cursor: pointer;
  font-size: 12px;
  font-family: var(--font-secondary, 'Azeret Mono', monospace);
  color: var(--color-dark-brown, #2b1408);
  line-height: 1.5;
}
.contest-checkbox-label a {
  text-decoration: underline;
  font-weight: 700;
  color: var(--color-dark-brown, #2b1408);
}
.contest-checkbox {
  margin-top: 3px;
  width: 1rem;
  height: 1rem;
  accent-color: var(--color-dark-brown, #2b1408);
}
.contest-submit-wrap {
  text-align: center;
  padding-top: 1rem;
}
.contest-submit-btn {
  width: 100%;
  max-width: 440px;
  padding: 1rem;
  font-size: 1.25rem;
  letter-spacing: 0.05em;
}
.contest-draw-success {
  padding: 2rem;
  background-color: rgba(202, 154, 241, 0.3);
  border: 3px solid var(--color-dark-brown, #2b1408);
  border-radius: 20px;
  text-align: center;
}
.contest-success-title {
  font-family: var(--font-primary, 'Champ Black', serif);
  font-size: 1.5rem;
  text-transform: uppercase;
  color: var(--color-dark-brown, #2b1408);
  margin: 0 0 0.5rem 0;
}
.contest-success-desc {
  font-family: var(--font-secondary, 'Azeret Mono', monospace);
  font-size: 0.875rem;
  color: var(--color-dark-brown, #2b1408);
  margin: 0;
}
.contest-rules-banner {
  background-color: var(--color-cream, #fffbf2);
  border: 4px solid var(--color-dark-brown, #2b1408);
  border-bottom-width: 8px;
  border-radius: var(--radius-2xl, 32px);
  padding: 1.5rem;
  margin-top: 2rem;
  box-shadow: 0 20px 40px rgba(43, 20, 8, 0.12);
  color: var(--color-dark-brown, #2b1408);
  box-sizing: border-box;
}
.contest-rules-links {
  font-family: var(--font-primary, 'Champ Black', serif);
  font-size: 14px;
  text-transform: uppercase;
  margin: 0 0 0.5rem 0;
}
.contest-rules-links a {
  color: inherit;
  text-decoration: underline;
}
.contest-rules-text {
  font-size: 11px;
  font-family: var(--font-secondary, 'Azeret Mono', monospace);
  line-height: 1.5;
  color: rgba(43, 20, 8, 0.8);
  margin: 0;
}
.contest-rules-text a {
  text-decoration: underline;
  font-weight: 700;
  color: var(--color-dark-brown, #2b1408);
}
</style>

{% schema %}
{
  "name": "Contest Draw Form",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Enter the Draw"
    }
  ],
  "presets": [
    {
      "name": "Contest Draw Form"
    }
  ]
}
{% endschema %}
