<style>
.ticker-section {
  background-color: var(--color-background, #f8ebd7);
  color: var(--color-foreground, #2d0f28);
  padding: 2rem 0;
  overflow: hidden;
  position: relative;
  border-top: 1px solid rgba(45, 15, 40, 0.08);
  border-bottom: 1px solid rgba(45, 15, 40, 0.08);
}
.ticker-wrapper {
  display: flex;
  overflow: hidden;
  user-select: none;
  width: 100%;
}
.ticker-track {
  display: flex;
  align-items: center;
  justify-content: space-around;
  flex-shrink: 0;
  min-width: 100%;
  animation: tickerLoop 28s linear infinite;
}
.ticker-wrapper:hover .ticker-track {
  animation-play-state: paused;
}
@keyframes tickerLoop {
  0% { transform: translateX(0%); }
  100% { transform: translateX(-100%); }
}
.ticker-item {
  display: flex;
  align-items: center;
  gap: 1rem;
  padding-right: 3.75rem;
}
.ticker-icon-wrapper {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 2.5rem;
  width: 2.5rem;
  flex-shrink: 0;
}
@media (min-width: 1024px) {
  .ticker-icon-wrapper {
    height: 3.5rem;
    width: 3.5rem;
  }
}
.ticker-icon-img {
  width: auto;
  height: 100%;
  max-width: 100%;
  object-fit: contain;
  display: block;
}
.ticker-item-title {
  font-family: var(--font-primary, 'Champ Black', serif);
  font-size: 1.125rem;
  line-height: 1.2;
  text-transform: uppercase;
  white-space: nowrap;
  letter-spacing: -0.01em;
  color: var(--color-foreground, #2d0f28);
  margin: 0;
}
@media (min-width: 1024px) {
  .ticker-item-title {
    font-size: 1.5rem;
  }
}
</style>

