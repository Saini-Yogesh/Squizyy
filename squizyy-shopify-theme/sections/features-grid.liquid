{%- comment -%}
  "Peanut Butter Needed This" 4-Card Features Grid
{%- endcomment -%}

<section class="features-grid-section">
  <div class="features-grid-container container">
    <div class="features-grid-header">
      <h2 class="features-grid-title">PEANUT BUTTER NEEDED THIS.</h2>
      <p class="features-grid-subtitle">Engineered for clean squeezes, effortless drizzles, and pure snacking joy.</p>
    </div>

    <div class="features-cards-wrapper">
      <!-- 4 Cards -->
      <div class="feature-pillar-card">
        <div class="pillar-icon-wrap">
          <img src="{{ 'featured-sticker-1.png' | asset_url }}" alt="" class="pillar-sticker" width="60" height="60">
        </div>
        <h3 class="pillar-title">100% AUSSIE PEANUTS</h3>
        <p class="pillar-desc">Sourced exclusively from Kingaroy, Queensland — the peanut capital of Australia known for rich soil and intense flavor.</p>
      </div>

      <div class="feature-pillar-card">
        <div class="pillar-icon-wrap">
          <img src="{{ 'featured-sticker-2.png' | asset_url }}" alt="" class="pillar-sticker" width="60" height="60">
        </div>
        <h3 class="pillar-title">HIGH-OLEIC HEALTH</h3>
        <p class="pillar-desc">Naturally rich in monounsaturated fats (the good stuff found in extra virgin olive oil) that stay fresh longer without hydrogenated oils.</p>
      </div>

      <div class="feature-pillar-card">
        <div class="pillar-icon-wrap">
          <img src="{{ 'featured-sticker-3.png' | asset_url }}" alt="" class="pillar-sticker" width="60" height="60">
        </div>
        <h3 class="pillar-title">SQUEEZE TECHNOLOGY</h3>
        <p class="pillar-desc">Custom valve cap prevents clogs, leaks, and oily crust. Enjoy consistent flow from the first squeeze to the very last drop.</p>
      </div>

      <div class="feature-pillar-card">
        <div class="pillar-icon-wrap">
          <img src="{{ 'featured-sticker-4.png' | asset_url }}" alt="" class="pillar-sticker" width="60" height="60">
        </div>
        <h3 class="pillar-title">ZERO PALM OIL OR SUGAR</h3>
        <p class="pillar-desc">Just peanuts and a pinch of Australian sea salt. No fillers, emulsifiers, or sweeteners to hide the real flavor.</p>
      </div>
    </div>
  </div>
</section>

<style>
.features-grid-section {
  padding: 6rem 0;
  background-color: var(--color-background, #f8ebd7);
}
.features-grid-header {
  text-align: center;
  max-width: 720px;
  margin: 0 auto 4rem;
}
.features-grid-title {
  font-family: var(--font-primary, 'Champ Black', serif);
  font-size: clamp(2.25rem, 4.5vw, 3.5rem);
  line-height: 1.05;
  color: var(--color-foreground, #2d0f28);
  margin: 0 0 1rem 0;
  text-transform: uppercase;
}
.features-grid-subtitle {
  font-size: 1.125rem;
  color: var(--color-foreground, #2d0f28);
  opacity: 0.85;
  margin: 0;
}
.features-cards-wrapper {
  display: grid;
  grid-template-columns: 1fr;
  gap: 2rem;
}
@media (min-width: 640px) {
  .features-cards-wrapper {
    grid-template-columns: repeat(2, 1fr);
  }
}
@media (min-width: 1024px) {
  .features-cards-wrapper {
    grid-template-columns: repeat(4, 1fr);
  }
}
.feature-pillar-card {
  background-color: var(--color-cream, #fffbf2);
  border: 4px solid var(--color-foreground, #2d0f28);
  border-radius: var(--radius-2xl, 32px);
  padding: 2.5rem 1.5rem;
  box-shadow: 0 8px 0 var(--color-foreground, #2d0f28);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  transition: transform 0.2s ease;
}
.feature-pillar-card:hover {
  transform: translateY(-4px);
}
.pillar-icon-wrap {
  width: 70px;
  height: 70px;
  margin-bottom: 1.5rem;
}
.pillar-sticker {
  width: 100%;
  height: 100%;
  object-fit: contain;
}
.pillar-title {
  font-family: var(--font-primary, 'Champ Black', serif);
  font-size: 1.25rem;
  line-height: 1.15;
  color: var(--color-foreground, #2d0f28);
  margin: 0 0 0.75rem 0;
  text-transform: uppercase;
}
.pillar-desc {
  font-size: 0.875rem;
  line-height: 1.5;
  color: rgba(45, 15, 40, 0.8);
  margin: 0;
}
</style>

{% schema %}
{
  "name": "Features Grid",
  "settings": [],
  "presets": [
    {
      "name": "Features Grid"
    }
  ]
}
{% endschema %}
