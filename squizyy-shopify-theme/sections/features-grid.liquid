{%- comment -%}
  "Peanut Butter Needed This" 2-Column Image With Text & Slogan Badge
  Faithfully ported from client/src/components/sections/FeaturesGrid.jsx & FeaturesGrid.module.css
{%- endcomment -%}

<div id="shopify-section-image-with-text" class="shopify-section">
  <section class="features-section" aria-label="Why Squizyy">
    <div class="features-container">
      <!-- Left: Image with Overlaid Slogan Badge -->
      <div class="features-image-col">
        <div class="features-image-frame">
          <img
            src="{{ 'drizzy-1.jpg' | asset_url }}"
            alt="Drizzy squeezy bottle in action"
            class="features-main-image"
            width="1500"
            height="2250"
            loading="lazy"
          >
        </div>

        <!-- Overlaid Rotated Slogan Badge -->
        <div class="features-slogan-badge">
          <img
            src="{{ 'Slogan_60f4524c-8b90-43e6-aad4-c9bbd67f0367.png' | asset_url }}"
            alt="Drizzy Slogan Badge"
            class="features-slogan-img"
            width="1500"
            height="577"
            loading="lazy"
          >
        </div>
      </div>

      <!-- Right: Feature Content -->
      <div class="features-content-col">
        <div class="features-content-wrapper">
          <h2 class="features-heading">
            {{ section.settings.heading | default: 'Peanut Butter Needed This' }}
          </h2>

          <div class="features-list">
            <!-- Feature 1 -->
            <div class="features-item">
              <div class="features-icon-box">
                <img src="{{ 'image_11_Vectorized_-2.svg' | asset_url }}" alt="" aria-hidden="true" class="features-icon" width="56" height="56" loading="lazy">
              </div>
              <div class="features-text-col">
                <h3 class="features-item-title">DRIZZLE MORE, MESS LESS</h3>
                <p class="features-item-desc">No sticky spoons, messy jars or peanut butter all over your kitchen.</p>
              </div>
            </div>

            <!-- Feature 2 -->
            <div class="features-item">
              <div class="features-icon-box">
                <img src="{{ 'image_11_Vectorized_f4cc9344-3c26-419e-86a0-e598718196ff.svg' | asset_url }}" alt="" aria-hidden="true" class="features-icon" width="56" height="56" loading="lazy">
              </div>
              <div class="features-text-col">
                <h3 class="features-item-title">FUEL FOR YOUR DAY</h3>
                <p class="features-item-desc">7g protein per serving. Perfect for your oats, bowls, smoothies and snacks.</p>
              </div>
            </div>

            <!-- Feature 3 -->
            <div class="features-item">
              <div class="features-icon-box">
                <img src="{{ 'Group_2.svg' | asset_url }}" alt="" aria-hidden="true" class="features-icon" width="56" height="56" loading="lazy">
              </div>
              <div class="features-text-col">
                <h3 class="features-item-title">100% NATURAL, 0% JUNK</h3>
                <p class="features-item-desc">Just clean ingredients that taste better because they are better.</p>
              </div>
            </div>

            <!-- Feature 4 -->
            <div class="features-item">
              <div class="features-icon-box">
                <img src="{{ 'image_11_Vectorized.svg' | asset_url }}" alt="" aria-hidden="true" class="features-icon" width="56" height="56" loading="lazy">
              </div>
              <div class="features-text-col">
                <h3 class="features-item-title">NO MORE SNACK REGRET</h3>
                <p class="features-item-desc">Our American peanuts are a good source of protein, fiber and healthy fats.</p>
              </div>
            </div>
          </div>

          <!-- Bottom CTA -->
          <div class="features-cta-box">
            <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="features-cta-button">
              {{ section.settings.button_label | default: 'SHOP NOW' }}
            </a>
            <p class="features-shipping-note">
              {{ section.settings.shipping_note | default: 'FREE SHIPPING ON ORDERS $49.99+' }}
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>

<style>
.features-section {
  display: block;
  background-color: var(--color-background, #f8ebd7);
  color: var(--color-foreground, #2d0f28);
  padding: 3rem 0;
}
@media (min-width: 1024px) {
  .features-section {
    padding: 5rem 0;
  }
}
.features-container {
  width: 100%;
  max-width: 1408px;
  margin: 0 auto;
  padding: 0 1.25rem;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: space-between;
  gap: 2.5rem;
  box-sizing: border-box;
}
@media (min-width: 1024px) {
  .features-container {
    flex-direction: row;
    gap: 3.75rem;
    padding: 0 3rem;
  }
}
.features-image-col {
  position: relative;
  width: 100%;
  height: 28rem;
}
@media (min-width: 640px) {
  .features-image-col {
    height: 34rem;
  }
}
@media (min-width: 1024px) {
  .features-image-col {
    width: 48%;
    height: 48rem;
  }
}
.features-image-frame {
  width: 100%;
  height: 100%;
  border-radius: var(--radius-2xl, 32px);
  border: 2px solid var(--color-foreground, #2d0f28);
  overflow: hidden;
  box-shadow: 0 8px 24px rgba(45, 15, 40, 0.08);
}
.features-main-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.features-slogan-badge {
  position: absolute;
  width: 180px;
  transform: rotate(-14deg);
  bottom: 1.5rem;
  left: -1rem;
  pointer-events: none;
  filter: drop-shadow(0 15px 25px rgba(0, 0, 0, 0.25));
  z-index: 10;
}
@media (min-width: 640px) {
  .features-slogan-badge {
    width: 210px;
    left: -1.5rem;
  }
}
@media (min-width: 1024px) {
  .features-slogan-badge {
    width: 240px;
    left: -2rem;
  }
}
.features-slogan-img {
  width: 100%;
  height: auto;
  object-fit: contain;
  display: block;
}
.features-content-col {
  width: 100%;
  display: flex;
  align-items: center;
}
@media (min-width: 1024px) {
  .features-content-col {
    width: 52%;
    min-height: 48rem;
  }
}
.features-content-wrapper {
  display: flex;
  flex-direction: column;
  gap: 1.75rem;
  align-items: flex-start;
  justify-content: center;
  width: 100%;
}
@media (min-width: 1024px) {
  .features-content-wrapper {
    gap: 2.25rem;
  }
}
.features-heading {
  font-family: var(--font-primary, 'Champ Black', serif);
  color: var(--color-foreground, #2d0f28);
  font-size: 34px;
  line-height: 1.05;
  text-transform: uppercase;
  margin: 0;
  letter-spacing: -0.02em;
}
@media (min-width: 640px) {
  .features-heading {
    font-size: 44px;
  }
}
@media (min-width: 1024px) {
  .features-heading {
    font-size: 54px;
  }
}
.features-list {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
  width: 100%;
}
.features-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 1rem;
}
@media (min-width: 1024px) {
  .features-item {
    gap: 1.5rem;
  }
}
.features-icon-box {
  flex-shrink: 0;
  width: 3rem;
  height: 3rem;
  display: flex;
  align-items: center;
  justify-content: center;
}
@media (min-width: 1024px) {
  .features-icon-box {
    width: 3.5rem;
    height: 3.5rem;
  }
}
.features-icon {
  width: 100%;
  height: 100%;
  object-fit: contain;
  display: block;
}
.features-text-col {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  flex: 1;
}
.features-item-title {
  font-family: var(--font-primary, 'Champ Black', serif);
  text-transform: uppercase;
  color: var(--color-foreground, #2d0f28);
  font-size: 18px;
  line-height: 1.15;
  margin: 0;
}
@media (min-width: 640px) {
  .features-item-title {
    font-size: 22px;
  }
}
@media (min-width: 1024px) {
  .features-item-title {
    font-size: 24px;
  }
}
.features-item-desc {
  font-family: var(--font-secondary, 'Azeret Mono', monospace);
  font-size: 12px;
  color: rgba(45, 15, 40, 0.85);
  line-height: 1.5;
  margin: 0;
}
@media (min-width: 640px) {
  .features-item-desc {
    font-size: 14px;
  }
}
.features-cta-box {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.65rem;
  padding-top: 0.5rem;
}
@media (min-width: 1024px) {
  .features-cta-box {
    width: auto;
    align-items: flex-start;
  }
}
.features-cta-button {
  display: inline-flex;
  white-space: nowrap;
  transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  align-items: center;
  justify-content: center;
  text-decoration: none;
  text-transform: uppercase;
  border-radius: var(--radius-full, 9999px);
  width: 100%;
  font-size: 16px;
  font-family: var(--font-primary, 'Champ Black', serif);
  line-height: 1;
  padding: 1.1rem 2.25rem;
  background-color: var(--color-accent-purple, #ca9af1);
  color: var(--color-foreground, #2d0f28);
  border: 2px solid var(--color-foreground, #2d0f28);
  box-shadow: 0 4px 0 var(--color-foreground, #2d0f28);
  cursor: pointer;
  box-sizing: border-box;
}
.features-cta-button:hover {
  background-color: var(--color-cream, #fffbf2);
  transform: translateY(-2px);
  box-shadow: 0 6px 0 var(--color-foreground, #2d0f28);
}
.features-cta-button:active {
  transform: translateY(1px);
  box-shadow: 0 2px 0 var(--color-foreground, #2d0f28);
}
@media (min-width: 768px) {
  .features-cta-button {
    width: auto;
  }
}
@media (min-width: 1024px) {
  .features-cta-button {
    font-size: 20px;
  }
}
.features-shipping-note {
  font-family: var(--font-secondary, 'Azeret Mono', monospace);
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--color-foreground, #2d0f28);
  font-weight: 700;
  margin: 0;
  text-align: center;
}
@media (min-width: 640px) {
  .features-shipping-note {
    font-size: 12px;
  }
}
</style>

{% schema %}
{
  "name": "Features Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Peanut Butter Needed This"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "text",
      "id": "shipping_note",
      "label": "Shipping Note",
      "default": "FREE SHIPPING ON ORDERS $49.99+"
    }
  ],
  "presets": [
    {
      "name": "Features Grid"
    }
  ]
}
{% endschema %}
