<section class="contest-instructions-section" id="instructions">
  <div class="contest-instructions-container">
    <!-- Left Image Frame -->
    <div class="contest-instructions-img-col">
      <div class="contest-instructions-frame">
        <img src="{{ 'shutterstock_2623398413.jpg' | asset_url }}" alt="Drizzy Fan with peanut butter">
      </div>
    </div>

    <!-- Right Card with Steps -->
    <div class="contest-instructions-card">
      <h2 class="contest-instructions-title">{{ section.settings.heading | default: 'How to Enter' }}</h2>

      <div class="contest-instructions-brand">
        <span>Buy Drizzy (In-store or via sprouts.com)</span>
        <img src="{{ 'Sprouts_Farmers_Market_Logo_4_Vectorized.svg' | asset_url }}" alt="Sprouts logo">
      </div>

      <!-- Step 1 -->
      <div class="contest-step-block">
        <h3 class="contest-step-heading">1. Sign up or sign in to Sprouts</h3>
        <p class="contest-step-body">Before you shop, create a Sprouts account or sign in to your existing account. You'll need your purchase linked to your account so we can verify your entry.</p>
      </div>

      <!-- Step 2 -->
      <div class="contest-step-block">
        <h3 class="contest-step-heading">2. Buy Drizzy at Sprouts</h3>
        <p class="contest-step-body">Purchase at least one bottle of Drizzy at Sprouts between August 24 and September 20, 2026.</p>
      </div>

      <!-- Step 3 -->
      <div class="contest-step-block">
        <h3 class="contest-step-heading">3. Keep your receipt</h3>
        <p class="contest-step-body">Hold onto your receipt! You'll need it to enter. If you purchased online, your digital receipt will be in your email inbox showing your Drizzy purchase.</p>
      </div>

      <!-- Step 4 -->
      <div class="contest-step-block">
        <h3 class="contest-step-heading">4. Upload & enter</h3>
        <p class="contest-step-body">Enter your name and email address below and upload a clear photo or screenshot of your Sprouts receipt. Use the same email address linked to your Sprouts account so we can verify your purchase.</p>
      </div>

      <!-- Step 5 -->
      <div class="contest-step-block">
        <h3 class="contest-step-heading">5. You're in!</h3>
        <p class="contest-step-body">Once your qualifying purchase and submission are verified, you'll officially be entered into the draw.</p>
      </div>

      <div class="contest-instructions-cta">
        <a href="#draw-form" class="button-primary contest-instructions-btn">ENTER</a>
      </div>
    </div>
  </div>
</section>

<style>
.contest-instructions-section {
  background-color: var(--color-background, #fffaf3);
  padding: 3rem 1rem;
}
@media (min-width: 1024px) {
  .contest-instructions-section {
    padding: 5rem 1.5rem;
  }
}
.contest-instructions-container {
  display: flex;
  flex-direction: column;
  gap: 2.5rem;
  max-width: 87.5rem;
  margin: 0 auto;
}
@media (min-width: 1024px) {
  .contest-instructions-container {
    flex-direction: row;
    align-items: flex-start;
    gap: 4rem;
  }
}
.contest-instructions-img-col {
  width: 100%;
}
@media (min-width: 1024px) {
  .contest-instructions-img-col {
    width: 45%;
    position: sticky;
    top: 6rem;
  }
}
.contest-instructions-frame {
  width: 100%;
  aspect-ratio: 4 / 5;
  border-radius: var(--radius-2xl, 32px);
  border: 4px solid var(--color-dark-brown, #2b1408);
  border-bottom-width: 8px;
  overflow: hidden;
  box-shadow: 0 20px 40px rgba(43, 20, 8, 0.12);
}
.contest-instructions-frame img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.contest-instructions-card {
  width: 100%;
  background-color: var(--color-cream, #fffbf2);
  border: 4px solid var(--color-dark-brown, #2b1408);
  border-bottom-width: 8px;
  border-radius: var(--radius-2xl, 32px);
  padding: 2rem 1.5rem;
  box-shadow: 0 20px 40px rgba(43, 20, 8, 0.12);
  color: var(--color-dark-brown, #2b1408);
  box-sizing: border-box;
}
@media (min-width: 768px) {
  .contest-instructions-card {
    padding: 3rem 2.5rem;
  }
}
@media (min-width: 1024px) {
  .contest-instructions-card {
    width: 55%;
  }
}
.contest-instructions-title {
  font-family: var(--font-primary, 'Champ Black', serif);
  font-size: 2.25rem;
  line-height: 1.05;
  text-transform: uppercase;
  color: var(--color-dark-brown, #2b1408);
  margin: 0;
}
@media (min-width: 640px) {
  .contest-instructions-title {
    font-size: 3rem;
  }
}
.contest-instructions-brand {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin: 1.5rem 0 2rem 0;
  font-family: var(--font-secondary, 'Azeret Mono', monospace);
  font-size: 0.95rem;
  font-weight: 700;
  color: var(--color-dark-brown, #2b1408);
}
.contest-instructions-brand img {
  height: 2.5rem;
  width: auto;
  object-fit: contain;
}
.contest-step-block {
  margin-bottom: 1.75rem;
  padding-bottom: 1.5rem;
  border-bottom: 2px dashed rgba(43, 20, 8, 0.15);
}
.contest-step-block:last-of-type {
  border-bottom: none;
  margin-bottom: 2rem;
  padding-bottom: 0;
}
.contest-step-heading {
  font-family: var(--font-primary, 'Champ Black', serif);
  font-size: 1.25rem;
  text-transform: uppercase;
  color: var(--color-dark-brown, #2b1408);
  margin: 0 0 0.5rem 0;
}
.contest-step-body {
  font-size: 0.95rem;
  line-height: 1.6;
  color: rgba(43, 20, 8, 0.85);
  margin: 0;
}
.contest-instructions-cta {
  margin-top: 2rem;
}
.contest-instructions-btn {
  display: block;
  width: 100%;
  max-width: 320px;
  padding: 1rem;
  font-size: 1.25rem;
  letter-spacing: 0.05em;
  text-align: center;
}
</style>

{% schema %}
{
  "name": "Contest Instructions",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How to Enter"
    }
  ],
  "presets": [
    {
      "name": "Contest Instructions"
    }
  ]
}
{% endschema %}
