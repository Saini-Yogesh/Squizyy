<section class="contest-instructions-section" id="instructions">
  <div class="contest-instructions-container">
    <!-- Left Image Frame -->
    <div class="contest-instructions-img-col">
      <div class="contest-instructions-frame">
        <img src="{{ 'shutterstock_2623398413.jpg' | asset_url }}" alt="Squizyy Fan with peanut butter" width="1500" height="2748" loading="lazy">
      </div>
    </div>

    <!-- Right Card with Steps -->
    <div class="contest-instructions-card">
      <h2 class="contest-instructions-title">{{ section.settings.heading | default: 'How to Enter' }}</h2>

      <div class="contest-instructions-brand">
        <span>Order Squizyy Online or at Authorized Retail Stores Across India</span>
      </div>

      <!-- Step 1 -->
      <div class="contest-step-block">
        <h3 class="contest-step-heading">1. Order Squizyy Peanut Butter</h3>
        <p class="contest-step-body">Purchase any bottle of Squizyy Peanut Butter on our website or through our authorized retail and delivery partners.</p>
      </div>

      <!-- Step 2 -->
      <div class="contest-step-block">
        <h3 class="contest-step-heading">2. Keep Your Order ID / Bill</h3>
        <p class="contest-step-body">Hold onto your order confirmation number (#XXXX) from your confirmation email/SMS, or keep a photo of your retail store purchase bill.</p>
      </div>

      <!-- Step 3 -->
      <div class="contest-step-block">
        <h3 class="contest-step-heading">3. Submit Your Entry Below</h3>
        <p class="contest-step-body">Enter your name, email, WhatsApp number, and Order ID (or upload a photo/screenshot of your purchase bill).</p>
      </div>

      <!-- Step 4 -->
      <div class="contest-step-block">
        <h3 class="contest-step-heading">4. You're In The Draw!</h3>
        <p class="contest-step-body">Once submitted, you'll receive your Lucky Draw confirmation. Winners are announced on our official Instagram and notified directly via WhatsApp &amp; Email!</p>
      </div>

      <div class="contest-instructions-cta">
        <a href="#draw-form" class="button-primary contest-instructions-btn">ENTER TO WIN</a>
      </div>
    </div>
  </div>
</section>

<style>
.contest-instructions-section {
  background-color: var(--color-background, #fffaf3);
  padding: 3rem 1rem;
}
@media (min-width: 1024px) {
  .contest-instructions-section {
    padding: 5rem 1.5rem;
  }
}
.contest-instructions-container {
  display: flex;
  flex-direction: column;
  gap: 2.5rem;
  max-width: 87.5rem;
  margin: 0 auto;
}
@media (min-width: 1024px) {
  .contest-instructions-container {
    flex-direction: row;
    align-items: flex-start;
    gap: 4rem;
  }
}
.contest-instructions-img-col {
  width: 100%;
}
@media (min-width: 1024px) {
  .contest-instructions-img-col {
    width: 45%;
    position: sticky;
    top: 6rem;
  }
}
.contest-instructions-frame {
  width: 100%;
  aspect-ratio: 4 / 5;
  border-radius: var(--radius-2xl, 32px);
  border: 4px solid var(--color-dark-brown, #2b1408);
  border-bottom-width: 8px;
  overflow: hidden;
  box-shadow: 0 20px 40px rgba(43, 20, 8, 0.12);
}
.contest-instructions-frame img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.contest-instructions-card {
  width: 100%;
  background-color: var(--color-cream, #fffbf2);
  border: 4px solid var(--color-dark-brown, #2b1408);
  border-bottom-width: 8px;
  border-radius: var(--radius-2xl, 32px);
  padding: 2rem 1.5rem;
  box-shadow: 0 20px 40px rgba(43, 20, 8, 0.12);
  color: var(--color-dark-brown, #2b1408);
  box-sizing: border-box;
}
@media (min-width: 768px) {
  .contest-instructions-card {
    padding: 3rem 2.5rem;
  }
}
@media (min-width: 1024px) {
  .contest-instructions-card {
    width: 55%;
  }
}
.contest-instructions-title {
  font-family: var(--font-primary, 'Champ Black', serif);
  font-size: 2.25rem;
  line-height: 1.05;
  text-transform: uppercase;
  color: var(--color-dark-brown, #2b1408);
  margin: 0;
}
@media (min-width: 640px) {
  .contest-instructions-title {
    font-size: 3rem;
  }
}
.contest-instructions-brand {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin: 1.5rem 0 2rem 0;
  font-family: var(--font-secondary, 'Azeret Mono', monospace);
  font-size: 0.95rem;
  font-weight: 700;
  color: var(--color-dark-brown, #2b1408);
}
.contest-instructions-brand img {
  height: 2.5rem;
  width: auto;
  object-fit: contain;
}
.contest-step-block {
  margin-bottom: 1.75rem;
  padding-bottom: 1.5rem;
  border-bottom: 2px dashed rgba(43, 20, 8, 0.15);
}
.contest-step-block:last-of-type {
  border-bottom: none;
  margin-bottom: 2rem;
  padding-bottom: 0;
}
.contest-step-heading {
  font-family: var(--font-primary, 'Champ Black', serif);
  font-size: 1.25rem;
  text-transform: uppercase;
  color: var(--color-dark-brown, #2b1408);
  margin: 0 0 0.5rem 0;
}
.contest-step-body {
  font-size: 0.95rem;
  line-height: 1.6;
  color: rgba(43, 20, 8, 0.85);
  margin: 0;
}
.contest-instructions-cta {
  margin-top: 2rem;
}
.contest-instructions-btn {
  display: block;
  width: 100%;
  max-width: 320px;
  padding: 1rem;
  font-size: 1.25rem;
  letter-spacing: 0.05em;
  text-align: center;
}
</style>

{% schema %}
{
  "name": "Contest Instructions",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How to Enter"
    }
  ],
  "presets": [
    {
      "name": "Contest Instructions"
    }
  ]
}
{% endschema %}
