{%- comment -%}
  Homepage Hero Section with Overlaid Rating, Heading, CTA, & Floating Badge
  Faithfully ported from client/src/components/sections/Hero.jsx & Hero.module.css
{%- endcomment -%}

{%- assign main_product = nil -%}
{%- if all_products['squizyy-squeezy-peanut-butter-19-4-oz'].title != blank -%}
  {%- assign main_product = all_products['squizyy-squeezy-peanut-butter-19-4-oz'] -%}
{%- elsif all_products['squizyy-peanut-butter'].title != blank -%}
  {%- assign main_product = all_products['squizyy-peanut-butter'] -%}
{%- elsif collections.all.products.first != blank -%}
  {%- assign main_product = collections.all.products.first -%}
{%- endif -%}

{%- if main_product != blank and main_product.url != blank -%}
  {%- assign buy_now_url = main_product.url -%}
{%- else -%}
  {%- assign buy_now_url = routes.all_products_collection_url -%}
{%- endif -%}

<div id="shopify-section-hero" class="shopify-section">
  <section class="hero-section">
    <div class="hero-container container">
      <!-- Main Hero Frame -->
      <div class="hero-frame">
        <!-- Desktop Hero Background Graphic -->
        <img
          src="{{ 'hero-bg.png' | asset_url }}"
          alt="Squizyy squeezy peanut butter hero banner"
          class="hero-bg-desktop"
          width="1440"
          height="600"
          loading="eager"
        >

        <!-- Mobile Hero Background Graphic -->
        <img
          src="{{ 'hero-bg-mobile.png' | asset_url }}"
          alt="Squizyy squeezy peanut butter hero mobile banner"
          class="hero-bg-mobile"
          width="600"
          height="800"
          loading="eager"
        >

        <!-- Floating Sticker Graphic -->
        <div class="hero-sticker-wrapper">
          <img
            src="{{ 'sticker.png' | asset_url }}"
            alt="100% natural Indian peanut butter badge"
            class="hero-sticker-img"
            width="512"
            height="512"
            loading="eager"
          >
        </div>

        <!-- Bottom Gradient Overlay -->
        <div class="hero-bottom-gradient"></div>

        <!-- Top Heading + Star Ratings Overlay -->
        <div class="hero-top-content">
          <div class="hero-rating-row">
            <div class="hero-stars-list" aria-label="5 star rating">
              {%- for i in (1..5) -%}
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path
                    d="M3.16089 13.5124C2.82276 13.6862 2.43989 13.3824 2.50796 12.9944L3.23397 8.8561L0.151933 5.91904C-0.1361 5.64456 0.0129997 5.14269 0.398865 5.08788L4.68503 4.47899L6.59614 0.693267C6.76829 0.352244 7.23464 0.352244 7.40679 0.693267L9.3179 4.47899L13.6041 5.08788C13.9899 5.14269 14.139 5.64456 13.851 5.91904L10.769 8.8561L11.495 12.9944C11.563 13.3824 11.1802 13.6862 10.842 13.5124L7.00146 11.5384L3.16089 13.5124Z"
                    fill="#CA9AF1"
                  />
                </svg>
              {%- endfor -%}
            </div>
            <p class="hero-rating-text">{{ section.settings.rating_text | default: 'Loved by Thousands Across India!' }}</p>
          </div>

          <h1 class="hero-heading">
            {{ section.settings.heading | default: 'All-Natural Peanut Butter You Can Squeeze' }}
          </h1>
        </div>

        <!-- Bottom CTA & Shipping Badge Overlay -->
        <div class="hero-bottom-content">
          <a href="{{ section.settings.button_link | default: buy_now_url }}" class="hero-cta-link">
            {{ section.settings.button_label | default: 'BUY SQUIZYY PEANUT BUTTER NOW' }}
          </a>
          <p class="hero-shipping-badge">
            {{ section.settings.shipping_text | default: 'FREE DELIVERY ACROSS INDIA ON ORDERS ₹499+' }}
          </p>
        </div>
      </div>
    </div>
  </section>
</div>

<style>
.hero-section {
  background-color: var(--color-background, #f8ebd7);
  color: var(--color-foreground, #2d0f28);
  padding-top: 0.5rem;
  padding-bottom: 1.5rem;
}
@media (min-width: 1024px) {
  .hero-section {
    padding-top: 1rem;
    padding-bottom: 2rem;
  }
}
.hero-container {
  width: 100%;
  max-width: 1500px;
  margin: 0 auto;
  padding: 0 1rem;
  box-sizing: border-box;
}
.hero-frame {
  position: relative;
  width: 100%;
  height: 620px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: center;
  padding: 2.5rem 1rem 1.5rem 1rem;
  border-radius: var(--radius-2xl, 32px);
  overflow: hidden;
  box-sizing: border-box;
}
@media (min-width: 640px) {
  .hero-frame {
    height: 700px;
    padding-top: 3rem;
    border-radius: 40px;
  }
}
@media (min-width: 1024px) {
  .hero-frame {
    height: 600px;
    padding-bottom: 2rem;
  }
}
.hero-bg-desktop {
  display: none;
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: 0;
}
.hero-bg-mobile {
  display: block;
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: 0;
}
@media (min-width: 768px) {
  .hero-bg-desktop {
    display: block;
  }
  .hero-bg-mobile {
    display: none;
  }
}
.hero-sticker-wrapper {
  position: absolute;
  width: 160px;
  aspect-ratio: 1 / 1;
  transform: rotate(10deg);
  top: 50%;
  right: 3%;
  z-index: 3;
  pointer-events: none;
  filter: drop-shadow(0 15px 20px rgba(0, 0, 0, 0.25));
  transition: transform 0.3s ease;
}
@media (min-width: 640px) {
  .hero-sticker-wrapper {
    width: 190px;
    top: 52%;
    right: 5%;
  }
}
@media (min-width: 1024px) {
  .hero-sticker-wrapper {
    width: 220px;
    top: 54%;
    right: 6%;
  }
}
.hero-sticker-img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  display: block;
}
.hero-bottom-gradient {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 35%;
  background: linear-gradient(to top, rgba(74, 40, 24, 0.95) 0%, rgba(74, 40, 24, 0.6) 50%, transparent 100%);
  z-index: 1;
  pointer-events: none;
}
.hero-top-content {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  align-items: center;
  text-align: center;
  z-index: 2;
}
.hero-rating-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 0.5rem;
}
.hero-stars-list {
  display: flex;
  align-items: center;
  gap: 3.5px;
}
.hero-rating-text {
  font-family: var(--font-secondary, 'Azeret Mono', monospace);
  font-size: 13px;
  font-weight: 700;
  color: var(--color-cream, #fffbf2);
  margin: 0;
}
@media (min-width: 640px) {
  .hero-rating-text {
    font-size: 14px;
  }
}
.hero-heading {
  font-family: var(--font-primary, 'Champ Black', serif);
  color: var(--color-cream, #fffbf2);
  font-size: 36px;
  line-height: 1.05;
  letter-spacing: -0.02em;
  max-width: 800px;
  margin: 0.25rem 0 0 0;
  text-align: center;
  text-shadow: 0 3px 6px rgba(0, 0, 0, 0.2);
}
@media (min-width: 640px) {
  .hero-heading {
    font-size: 50px;
    margin-top: 0.5rem;
  }
}
@media (min-width: 1024px) {
  .hero-heading {
    font-size: 58px;
  }
}
.hero-bottom-content {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 0.65rem;
  align-items: center;
  z-index: 2;
  width: 100%;
  max-width: 440px;
  padding-bottom: 0.5rem;
}
.hero-cta-link {
  display: inline-flex;
  white-space: nowrap;
  transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  align-items: center;
  justify-content: center;
  text-decoration: none;
  text-transform: uppercase;
  border-radius: var(--radius-full, 9999px);
  width: 100%;
  font-size: 16px;
  font-family: var(--font-primary, 'Champ Black', serif);
  line-height: 1;
  padding: 1rem 2rem;
  background-color: var(--color-accent-purple, #ca9af1);
  color: var(--color-foreground, #2d0f28);
  border: 2px solid var(--color-foreground, #2d0f28);
  box-shadow: 0 4px 0 var(--color-foreground, #2d0f28);
  cursor: pointer;
  box-sizing: border-box;
}
.hero-cta-link:hover {
  background-color: var(--color-cream, #fffbf2);
  transform: translateY(-2px);
  box-shadow: 0 6px 0 var(--color-foreground, #2d0f28);
}
.hero-cta-link:active {
  transform: translateY(1px);
  box-shadow: 0 2px 0 var(--color-foreground, #2d0f28);
}
@media (min-width: 640px) {
  .hero-cta-link {
    font-size: 18px;
    width: auto;
  }
}
@media (min-width: 1024px) {
  .hero-cta-link {
    font-size: 20px;
  }
}
.hero-shipping-badge {
  font-family: var(--font-secondary, 'Azeret Mono', monospace);
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--color-cream, #fffbf2);
  font-weight: 700;
  margin: 0;
  text-shadow: 0 1px 3px rgba(0, 0, 0, 0.3);
}
</style>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "All-Natural Peanut Butter You Can Squeeze"
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating Text",
      "default": "Loved by Thousands Across India!"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "BUY SQUIZYY PEANUT BUTTER NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "text",
      "id": "shipping_text",
      "label": "Shipping Text",
      "default": "FREE DELIVERY ACROSS INDIA ON ORDERS ₹499+"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
