{%- comment -%}
  Product Detail Main Section (PDP) with Gallery, Buy Box, Bundle Calculator, and Accordions
{%- endcomment -%}

<section class="pdp-main-section" data-product-buy-box data-base-price="{{ product.price | divided_by: 100.0 }}">
  <div class="pdp-container container">
    <div class="pdp-layout-grid">
      <!-- Gallery Column -->
      <div class="pdp-gallery-col">
        <div class="pdp-gallery-frame">
          <img
            src="{{ product.featured_image | image_url: width: 1000 }}"
            alt="{{ product.title | escape }}"
            class="pdp-main-img"
            data-pdp-main-image
          >
          <div class="pdp-floating-badge animate-float">
            <img src="{{ 'best-value-sticker.png' | asset_url }}" alt="Best Value" width="80" height="80">
          </div>
        </div>

        {%- if product.images.size > 1 -%}
          <div class="pdp-thumbnails-strip">
            {%- for image in product.images -%}
              <button
                type="button"
                class="pdp-thumb-btn {% if forloop.first %}active{% endif %}"
                data-pdp-thumb
                data-image-src="{{ image | image_url: width: 1000 }}"
              >
                <img src="{{ image | image_url: width: 150, height: 150, crop: 'center' }}" alt="{{ image.alt | escape }}" width="70" height="70">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <!-- Buy Box Column -->
      <div class="pdp-buy-col">
        <div class="pdp-badge-top">100% AUSTRALIAN HIGH-OLEIC PEANUTS</div>
        <h1 class="pdp-title">{{ product.title }}</h1>

        <div class="pdp-rating-row">
          <div class="pdp-stars">★★★★★</div>
          <span class="pdp-rating-score">4.9 / 5.0 (1,000+ Reviews)</span>
        </div>

        <div class="pdp-price-row">
          <span class="pdp-price" data-product-price>{{ product.price | money }}</span>
          <s class="pdp-compare-price" data-compare-price style="display: none;"></s>
          <span class="pdp-savings-badge" data-savings-badge style="display: none;"></span>
        </div>

        <div class="pdp-short-desc">
          {{ product.description }}
        </div>

        <!-- Quantity / Bottle Tier Selector -->
        <div class="pdp-bottle-selector">
          <div class="selector-heading-row">
            <span class="selector-title">Select Pack Size:</span>
            <span class="selector-hint">Stock up & save up to 20%</span>
          </div>

          <div class="bottle-grid">
            <button type="button" class="bottle-card-btn active" data-bottle-count="1">
              <span class="b-count">1-Pack</span>
              <span class="b-note">Standard</span>
            </button>
            <button type="button" class="bottle-card-btn" data-bottle-count="2">
              <span class="b-count">2-Pack</span>
              <span class="b-save">Save 10%</span>
            </button>
            <button type="button" class="bottle-card-btn" data-bottle-count="3">
              <span class="b-badge">Popular</span>
              <span class="b-count">3-Pack</span>
              <span class="b-save">Save 15%</span>
            </button>
            <button type="button" class="bottle-card-btn" data-bottle-count="6">
              <span class="b-badge val-badge">Best Value</span>
              <span class="b-count">6-Pack</span>
              <span class="b-save">Save 20%</span>
            </button>
          </div>
        </div>

        <!-- Purchase Subscription Toggle -->
        <div class="pdp-subscription-box">
          <label class="sub-radio-wrap">
            <input type="radio" name="purchase_type" value="onetime" checked>
            <span class="radio-label-text">
              <strong>One-Time Delivery</strong>
            </span>
          </label>
          <label class="sub-radio-wrap">
            <input type="radio" name="purchase_type" value="subscribe">
            <span class="radio-label-text">
              <strong>Subscribe & Save an Extra 15%</strong> (Cancel anytime)
            </span>
          </label>
        </div>

        <!-- Add to Cart CTA -->
        <button
          type="button"
          class="button-primary pdp-cta-btn"
          data-add-to-cart
          data-add-to-cart-main
          data-variant-id="{{ product.selected_or_first_available_variant.id }}"
          data-quantity="1"
        >
          <span>Add to Cart — {{ product.price | money }}</span>
        </button>

        <!-- Product Value Perks -->
        <div class="pdp-trust-perks">
          <div class="trust-perk-item">
            <span class="perk-icon">🚚</span>
            <span>Free Shipping Over $49.99</span>
          </div>
          <div class="trust-perk-item">
            <span class="perk-icon">✨</span>
            <span>Zero Stirring, Zero Mess Guaranteed</span>
          </div>
          <div class="trust-perk-item">
            <span class="perk-icon">🇦🇺</span>
            <span>100% Kingaroy Aussie Peanuts</span>
          </div>
        </div>

        <!-- Accordions -->
        <div class="pdp-accordions">
          <div class="accordion-item">
            <button type="button" class="accordion-toggle" data-accordion-toggle>
              <span>Ingredients & Nutrition</span>
              <span class="accordion-icon">+</span>
            </button>
            <div class="accordion-content">
              <p><strong>Ingredients:</strong> 100% Australian High-Oleic Peanuts (99.2%), Australian Sea Salt (0.8%).</p>
              <p><strong>Nutrition:</strong> 7g Protein per 2 Tbsp (32g). 0g Added Sugar. Gluten-Free. Vegan friendly.</p>
            </div>
          </div>

          <div class="accordion-item">
            <button type="button" class="accordion-toggle" data-accordion-toggle>
              <span>How To Drizzle</span>
              <span class="accordion-icon">+</span>
            </button>
            <div class="accordion-content">
              <p>Simply give the bottle a light shake, flip open the mess-free cap, and squeeze! Drizzle over warm pancakes, sliced apples, morning oats, ice cream, or straight into your mouth.</p>
            </div>
          </div>

          <div class="accordion-item">
            <button type="button" class="accordion-toggle" data-accordion-toggle>
              <span>Shipping & Returns</span>
              <span class="accordion-icon">+</span>
            </button>
            <div class="accordion-content">
              <p>Orders ship within 24-48 business hours via USPS / UPS. If you aren't 100% obsessed with your first bottle, let us know within 30 days for a full refund — no return required.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
.pdp-main-section {
  padding: 3rem 0 5rem;
}
.pdp-layout-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 3.5rem;
}
@media (min-width: 1024px) {
  .pdp-layout-grid {
    grid-template-columns: 1fr 1fr;
    align-items: start;
  }
}
.pdp-gallery-frame {
  position: relative;
  background-color: var(--color-cream, #fffbf2);
  border: 4px solid var(--color-foreground, #2d0f28);
  border-radius: var(--radius-2xl, 32px);
  padding: 3rem;
  box-shadow: 0 12px 0 var(--color-foreground, #2d0f28);
  display: flex;
  align-items: center;
  justify-content: center;
}
.pdp-main-img {
  max-width: 440px;
  width: 100%;
  height: auto;
  object-fit: contain;
}
.pdp-floating-badge {
  position: absolute;
  top: 1.5rem;
  right: 1.5rem;
  width: 80px;
}
.pdp-thumbnails-strip {
  display: flex;
  gap: 1rem;
  margin-top: 1.5rem;
  overflow-x: auto;
  padding-bottom: 0.5rem;
}
.pdp-thumb-btn {
  width: 76px;
  height: 76px;
  border-radius: var(--radius-lg);
  border: 2px solid var(--color-foreground, #2d0f28);
  background-color: #ffffff;
  padding: 0.25rem;
  cursor: pointer;
  flex-shrink: 0;
  transition: all 0.15s ease;
}
.pdp-thumb-btn.active {
  border-color: var(--color-accent-purple, #ca9af1);
  box-shadow: 0 0 0 2px var(--color-accent-purple, #ca9af1);
}
.pdp-thumb-btn img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}
.pdp-badge-top {
  font-family: var(--font-secondary, 'Azeret Mono', monospace);
  font-size: 0.75rem;
  font-weight: 700;
  color: var(--color-accent-green, #036e2c);
  letter-spacing: 0.05em;
  margin-bottom: 0.75rem;
}
.pdp-title {
  font-family: var(--font-primary, 'Champ Black', serif);
  font-size: clamp(2.25rem, 4vw, 3.25rem);
  line-height: 1.05;
  color: var(--color-foreground, #2d0f28);
  margin: 0 0 0.75rem 0;
  text-transform: uppercase;
}
.pdp-rating-row {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin-bottom: 1.25rem;
}
.pdp-stars {
  color: #ffb800;
  font-size: 1.125rem;
}
.pdp-rating-score {
  font-family: var(--font-secondary, 'Azeret Mono', monospace);
  font-size: 0.8125rem;
  font-weight: 700;
}
.pdp-price-row {
  display: flex;
  align-items: baseline;
  gap: 0.75rem;
  margin-bottom: 1.5rem;
}
.pdp-price {
  font-family: var(--font-primary, 'Champ Black', serif);
  font-size: 2.25rem;
  color: var(--color-foreground, #2d0f28);
}
.pdp-compare-price {
  font-family: var(--font-secondary, 'Azeret Mono', monospace);
  font-size: 1.25rem;
  color: rgba(45, 15, 40, 0.5);
}
.pdp-savings-badge {
  background-color: var(--color-accent-green, #036e2c);
  color: #ffffff;
  font-family: var(--font-secondary, 'Azeret Mono', monospace);
  font-size: 0.75rem;
  font-weight: 700;
  padding: 0.25rem 0.6rem;
  border-radius: var(--radius-full);
}
.pdp-short-desc {
  font-size: 1rem;
  line-height: 1.6;
  opacity: 0.85;
  margin-bottom: 2rem;
}
.selector-heading-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 0.75rem;
  font-size: 0.875rem;
}
.selector-title {
  font-family: var(--font-secondary, 'Azeret Mono', monospace);
  font-weight: 700;
}
.selector-hint {
  color: var(--color-accent-green, #036e2c);
  font-weight: 700;
}
.bottle-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 0.75rem;
  margin-bottom: 1.5rem;
}
@media (min-width: 480px) {
  .bottle-grid {
    grid-template-columns: repeat(4, 1fr);
  }
}
.bottle-card-btn {
  position: relative;
  background-color: var(--color-cream, #fffbf2);
  border: 2px solid var(--color-foreground, #2d0f28);
  border-radius: var(--radius-lg);
  padding: 1rem 0.5rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.15s ease;
}
.bottle-card-btn.active {
  background-color: var(--color-accent-purple, #ca9af1);
  box-shadow: 0 4px 0 var(--color-foreground, #2d0f28);
  transform: translateY(-2px);
}
.b-count {
  font-family: var(--font-primary, 'Champ Black', serif);
  font-size: 1.125rem;
  color: var(--color-foreground, #2d0f28);
}
.b-note {
  font-family: var(--font-secondary, 'Azeret Mono', monospace);
  font-size: 0.6875rem;
  opacity: 0.7;
}
.b-save {
  font-family: var(--font-secondary, 'Azeret Mono', monospace);
  font-size: 0.6875rem;
  font-weight: 700;
  color: var(--color-accent-green, #036e2c);
}
.b-badge {
  position: absolute;
  top: -10px;
  background-color: var(--color-accent-green, #036e2c);
  color: #ffffff;
  font-family: var(--font-secondary, 'Azeret Mono', monospace);
  font-size: 0.625rem;
  font-weight: 700;
  padding: 0.15rem 0.5rem;
  border-radius: var(--radius-full);
}
.val-badge {
  background-color: var(--color-foreground, #2d0f28);
}
.pdp-subscription-box {
  background-color: var(--color-cream, #fffbf2);
  border: 2px solid var(--color-foreground, #2d0f28);
  border-radius: var(--radius-lg);
  padding: 1.25rem;
  margin-bottom: 2rem;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}
.sub-radio-wrap {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.875rem;
  cursor: pointer;
}
.pdp-cta-btn {
  width: 100%;
  padding: 1.25rem;
  font-size: 1.35rem;
  margin-bottom: 2rem;
}
.pdp-trust-perks {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  padding-bottom: 2rem;
  border-bottom: 2px dashed rgba(45, 15, 40, 0.2);
  margin-bottom: 2rem;
}
.trust-perk-item {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  font-size: 0.875rem;
  font-weight: 600;
}
.pdp-accordions {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}
.accordion-item {
  border: 2px solid var(--color-foreground, #2d0f28);
  border-radius: var(--radius-lg);
  background-color: var(--color-cream, #fffbf2);
  overflow: hidden;
}
.accordion-toggle {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1rem 1.25rem;
  background: none;
  border: none;
  font-family: var(--font-primary, 'Champ Black', serif);
  font-size: 1.125rem;
  color: var(--color-foreground, #2d0f28);
  cursor: pointer;
  text-align: left;
}
.accordion-content {
  padding: 0 1.25rem 1.25rem;
  font-size: 0.875rem;
  line-height: 1.5;
  display: none;
}
.accordion-item.open .accordion-content {
  display: block;
}
.accordion-item.open .accordion-icon {
  transform: rotate(45deg);
}
.accordion-icon {
  font-family: var(--font-secondary, 'Azeret Mono', monospace);
  font-size: 1.25rem;
  transition: transform 0.2s ease;
}
</style>

{% schema %}
{
  "name": "Main Product Buy Box",
  "settings": [],
  "presets": [
    {
      "name": "Main Product Buy Box"
    }
  ]
}
{% endschema %}
