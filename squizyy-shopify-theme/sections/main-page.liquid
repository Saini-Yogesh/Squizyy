<section class="main-page-section">
  <div class="main-page-container">
    <h1 class="main-page-heading">{{ page.title }}</h1>

    <div class="main-page-card rte">
      {%- if page.content != blank -%}
        {{ page.content }}
      {%- else -%}
        <!-- Default Content Placeholder for Fresh Theme Installation -->
        <h2 style="font-family: var(--font-primary, 'Champ Black', serif); font-size: 1.5rem; text-transform: uppercase; color: var(--color-dark-brown, #2b1408); margin: 0 0 1rem 0;">
          {{ page.title }}
        </h2>
        <p>Please edit this page's content in your Shopify Admin (Online Store &gt; Pages).</p>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
.main-page-section {
  width: 100%;
  background-color: var(--color-background, #fffaf3);
  padding: 3rem 1rem 5rem 1rem;
}
@media (min-width: 1024px) {
  .main-page-section {
    padding: 4.5rem 1.5rem 7rem 1.5rem;
  }
}
.main-page-container {
  margin: 0 auto;
  max-width: 56rem;
  box-sizing: border-box;
}
.main-page-heading {
  font-family: var(--font-primary, 'Champ Black', serif);
  font-size: 2.25rem;
  line-height: 1.1;
  text-transform: uppercase;
  color: var(--color-dark-brown, #2b1408);
  margin: 0 0 2rem 0;
  text-align: center;
}
@media (min-width: 640px) {
  .main-page-heading {
    font-size: 3rem;
    text-align: left;
  }
}
@media (min-width: 1024px) {
  .main-page-heading {
    font-size: 3.75rem;
  }
}
.main-page-card {
  background-color: var(--color-cream, #fffbf2);
  border: 4px solid var(--color-dark-brown, #2b1408);
  border-bottom-width: 8px;
  border-radius: var(--radius-2xl, 32px);
  padding: 1.5rem;
  box-shadow: 0 20px 40px rgba(43, 20, 8, 0.12);
  color: var(--color-dark-brown, #2b1408);
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
  font-size: 0.95rem;
  line-height: 1.6;
  box-sizing: border-box;
}
@media (min-width: 640px) {
  .main-page-card {
    padding: 3rem;
  }
}
.main-page-card h2,
.main-page-card h3 {
  font-family: var(--font-primary, 'Champ Black', serif);
  text-transform: uppercase;
  color: var(--color-dark-brown, #2b1408);
  margin: 1.5rem 0 0.5rem 0;
}
.main-page-card h2 {
  font-size: 1.5rem;
}
.main-page-card h3 {
  font-size: 1.25rem;
}
.main-page-card p {
  margin: 0 0 0.75rem 0;
}
.main-page-card ul,
.main-page-card ol {
  padding-left: 1.5rem;
  margin: 0.5rem 0 1rem 0;
}
.main-page-card li {
  margin-bottom: 0.5rem;
}
.main-page-card a {
  color: var(--color-dark-brown, #2b1408);
  text-decoration: underline;
  font-weight: 700;
}
</style>

{% schema %}
{
  "name": "Main Page",
  "settings": [
    {
      "type": "paragraph",
      "content": "Renders the standard page content configured in Shopify Admin > Pages."
    }
  ],
  "presets": [
    {
      "name": "Main Page"
    }
  ]
}
{% endschema %}
