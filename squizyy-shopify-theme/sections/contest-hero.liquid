<section class="contest-hero-section" id="promotion-hero">
  <div class="contest-hero-container">
    <!-- Text & CTAs -->
    <div class="contest-hero-text-col">
      <div class="contest-launch-badge">
        <span class="contest-badge-flag">🇮🇳</span>
        <span class="contest-badge-text">SQUIZYY INDIA GRAND LAUNCH GIVEAWAY</span>
      </div>

      <h1 class="contest-hero-title">{{ section.settings.heading | default: 'Win a Luxury Vacation + ₹1,00,000' }}</h1>
      <p class="contest-hero-desc">{{ section.settings.description | default: 'Celebrate our Grand India Launch! Enter for a chance to win an all-expenses-paid luxury holiday for two + ₹1,00,000 cash spending money + 1-year free supply of Squizyy.' }}</p>

      <a href="#instructions" class="button-primary contest-enter-btn">ENTER TO WIN</a>

      <div class="contest-hero-legal">
        <p>
          <strong>NO PURCHASE NECESSARY; </strong>void where prohibited. Open to all legal residents of India, 18+. Ends 31/12/2026.
          <strong>Limit one (1) entry per person total. </strong>Two entry methods: (i) Purchase any bottle of Squizyy Peanut Butter online or at partner stores, or (ii) free online entry. See Rules at
          <a href="{{ routes.root_url }}pages/rules">Rules</a> for full details. Sponsor: Squizyy Foods India Private Limited.
        </p>
      </div>
    </div>

    <!-- Media Side -->
    <div class="contest-hero-media-col">
      <div class="contest-australia-sticker">
        <img src="{{ 'sticker.png' | asset_url }}" alt="Squizyy Holographic Drip Sticker" width="500" height="500" loading="eager">
      </div>

      <div class="contest-video-frame">
        {%- assign contest_video_url = section.settings.video_url | default: 'https://squizyy.co/cdn/shop/videos/c/vp/3bf20797693b4279ad33d2af5e4962c2/3bf20797693b4279ad33d2af5e4962c2.HD-1080p-7.2Mbps-92269433.mp4' -%}
        <video
          playsinline
          muted
          autoplay
          loop
          poster="{{ 'Screenshot_2026-08-21_at_10.32.56_am.png' | asset_url }}"
          class="contest-video"
          aria-label="Squizyy Peanut Butter"
        >
          <source src="{{ contest_video_url }}" type="video/mp4">
          <img src="{{ 'Screenshot_2026-08-21_at_10.32.56_am.png' | asset_url }}" alt="Squizyy Peanut Butter" width="1100" height="615">
        </video>
      </div>
    </div>
  </div>
</section>

<style>
.contest-hero-section {
  background-color: var(--color-background, #fffaf3);
  color: var(--color-foreground, #2b1408);
  padding: 4rem 1rem 2rem 1rem;
}
@media (min-width: 1024px) {
  .contest-hero-section {
    padding: 3rem 1.5rem;
  }
}
.contest-hero-container {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 2rem;
  margin: 0 auto;
  max-width: 87.5rem;
}
@media (min-width: 1024px) {
  .contest-hero-container {
    flex-direction: row;
    align-items: center;
    gap: 4rem;
  }
}
.contest-hero-text-col {
  width: 100%;
  position: relative;
}
@media (min-width: 1024px) {
  .contest-hero-text-col {
    width: 50%;
  }
}
.contest-hero-title {
  font-family: var(--font-primary, 'Champ Black', serif);
  font-size: 2.5rem;
  line-height: 0.95;
  text-transform: uppercase;
  color: var(--color-dark-brown, #2b1408);
  margin: 0;
  text-align: center;
}
@media (min-width: 640px) {
  .contest-hero-title {
    font-size: 3.5rem;
  }
}
@media (min-width: 1024px) {
  .contest-hero-title {
    font-size: 5rem;
    text-align: left;
  }
}
.contest-hero-desc {
  font-size: 1rem;
  line-height: 1.6;
  color: var(--color-dark-brown, #2b1408);
  margin-top: 1rem;
  text-align: center;
}
@media (min-width: 1024px) {
  .contest-hero-desc {
    font-size: 1.125rem;
    max-width: 35ch;
    text-align: left;
  }
}
.contest-launch-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  background-color: var(--color-accent-purple, #ca9af1);
  border: 2px solid var(--color-dark-brown, #2b1408);
  border-radius: var(--radius-full, 9999px);
  padding: 0.5rem 1rem;
  font-family: var(--font-secondary, 'Azeret Mono', monospace);
  font-size: 0.75rem;
  font-weight: 800;
  letter-spacing: 0.05em;
  color: var(--color-dark-brown, #2b1408);
  box-shadow: 0 4px 12px rgba(43, 20, 8, 0.1);
  margin-bottom: 1.25rem;
}
@media (min-width: 1024px) {
  .contest-launch-badge {
    font-size: 0.8125rem;
    padding: 0.5rem 1.25rem;
  }
}
.contest-enter-btn {
  display: block;
  width: 100%;
  max-width: 320px;
  margin: 2rem auto 1.5rem auto;
  padding: 1rem;
  font-size: 1.25rem;
  letter-spacing: 0.05em;
  text-align: center;
}
@media (min-width: 1024px) {
  .contest-enter-btn {
    margin: 2rem 0 1.5rem 0;
  }
}
.contest-hero-legal {
  font-size: 11px;
  font-family: var(--font-secondary, 'Azeret Mono', monospace);
  color: rgba(43, 20, 8, 0.7);
  line-height: 1.5;
  margin-top: 1.5rem;
}
.contest-hero-legal a {
  text-decoration: underline;
  font-weight: 700;
  color: var(--color-dark-brown, #2b1408);
}
.contest-hero-media-col {
  width: 100%;
  position: relative;
}
@media (min-width: 1024px) {
  .contest-hero-media-col {
    width: 50%;
  }
}
.contest-australia-sticker {
  position: absolute;
  top: -2.5rem;
  right: 0.5rem;
  width: 5.5rem;
  height: auto;
  z-index: 2;
  transform: rotate(8deg);
}
@media (min-width: 1024px) {
  .contest-australia-sticker {
    top: -3.5rem;
    right: 2rem;
    width: 8rem;
  }
}
.contest-australia-sticker img {
  width: 100%;
  height: auto;
  display: block;
}
.contest-video-frame {
  position: relative;
  width: 100%;
  aspect-ratio: 4 / 3;
  border-radius: var(--radius-2xl, 32px);
  border: 4px solid var(--color-dark-brown, #2b1408);
  border-bottom-width: 8px;
  overflow: hidden;
  box-shadow: 0 20px 40px rgba(43, 20, 8, 0.12);
}
.contest-video {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
</style>

{% schema %}
{
  "name": "Contest Hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Win a Luxury Vacation + ₹1,00,000"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Celebrate our Grand India Launch! Enter for a chance to win an all-expenses-paid luxury holiday for two + ₹1,00,000 cash spending money + 1-year free supply of Squizyy."
    },
    {
      "type": "url",
      "id": "video_url",
      "label": "Video URL"
    }
  ],
  "presets": [
    {
      "name": "Contest Hero"
    }
  ]
}
{% endschema %}
