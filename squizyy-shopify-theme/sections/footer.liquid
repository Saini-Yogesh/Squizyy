{%- comment -%}
  Global Brand Footer with Pastel Background, Dripping Graphic, Newsletter, & Nav Cards
  Faithfully ported from client/src/components/layout/Footer.jsx & Footer.module.css
{%- endcomment -%}

{%- assign main_product = nil -%}
{%- if all_products['drizzy-squeezy-peanut-butter-19-4-oz'].title != blank -%}
  {%- assign main_product = all_products['drizzy-squeezy-peanut-butter-19-4-oz'] -%}
{%- elsif all_products['drizzy-peanut-butter'].title != blank -%}
  {%- assign main_product = all_products['drizzy-peanut-butter'] -%}
{%- elsif collections.all.products.first != blank -%}
  {%- assign main_product = collections.all.products.first -%}
{%- endif -%}

{%- if main_product != blank and main_product.url != blank -%}
  {%- assign buy_now_url = main_product.url -%}
{%- else -%}
  {%- assign buy_now_url = routes.all_products_collection_url -%}
{%- endif -%}

{%- assign our_story_url = '/pages/our-story' -%}
{%- if pages['our-story'].title != blank -%}
  {%- assign our_story_url = pages['our-story'].url -%}
{%- elsif pages['about-us'].title != blank -%}
  {%- assign our_story_url = pages['about-us'].url -%}
{%- elsif pages['about'].title != blank -%}
  {%- assign our_story_url = pages['about'].url -%}
{%- endif -%}

{%- assign store_locator_url = '/pages/store-locator' -%}
{%- if pages['store-locator'].title != blank -%}
  {%- assign store_locator_url = pages['store-locator'].url -%}
{%- elsif pages['stockists'].title != blank -%}
  {%- assign store_locator_url = pages['stockists'].url -%}
{%- elsif pages['find-in-store'].title != blank -%}
  {%- assign store_locator_url = pages['find-in-store'].url -%}
{%- endif -%}

{%- assign wholesale_url = '/pages/wholesale' -%}
{%- if pages['wholesale'].title != blank -%}
  {%- assign wholesale_url = pages['wholesale'].url -%}
{%- endif -%}

{%- assign contest_url = nil -%}
{%- if pages['sproutslaunchwinflightstoaustralia'].title != blank -%}
  {%- assign contest_url = pages['sproutslaunchwinflightstoaustralia'].url -%}
{%- elsif pages['sprouts-launch-win-flights-to-australia'].title != blank -%}
  {%- assign contest_url = pages['sprouts-launch-win-flights-to-australia'].url -%}
{%- elsif pages['contest'].title != blank -%}
  {%- assign contest_url = pages['contest'].url -%}
{%- elsif pages['win-flights-to-australia'].title != blank -%}
  {%- assign contest_url = pages['win-flights-to-australia'].url -%}
{%- endif -%}

{%- assign rules_url = nil -%}
{%- if pages['rules'].title != blank -%}
  {%- assign rules_url = pages['rules'].url -%}
{%- elsif pages['official-rules'].title != blank -%}
  {%- assign rules_url = pages['official-rules'].url -%}
{%- elsif pages['sweepstakes-rules'].title != blank -%}
  {%- assign rules_url = pages['sweepstakes-rules'].url -%}
{%- endif -%}

{%- assign privacy_url = shop.privacy_policy.url | default: '/policies/privacy-policy' -%}
{%- assign terms_url = shop.terms_of_service.url | default: '/policies/terms-of-service' -%}

<footer class="footer-wrapper" role="contentinfo">
  <section class="footer-section">
    <!-- Pastel Colorful Gradient Background -->
    <div class="footer-bg-wrapper">
      <img
        src="{{ 'footer-bg.png' | asset_url }}"
        alt=""
        class="footer-bg-image"
        width="512"
        height="475"
        loading="lazy"
      >
    </div>

    <!-- Dripping Graphic at top of footer -->
    <div class="footer-drip-wrapper">
      <img
        src="{{ 'footer-drip.svg' | asset_url }}"
        alt=""
        class="footer-drip-desktop"
        width="1440"
        height="420"
        loading="lazy"
      >
      <img
        src="{{ 'timeline-drip-mobile.svg' | asset_url }}"
        alt=""
        class="footer-drip-mobile"
        width="336"
        height="109"
        loading="lazy"
      >
    </div>

    <!-- Main Footer Cards Container -->
    <div class="footer-container">
      <div class="footer-cards-row">
        <!-- Card 1: Sign up & save 10% -->
        <div class="footer-newsletter-card" id="contact_form">
          <h2 class="footer-card-title">
            Sign up &amp; save 10%
          </h2>
          <p class="footer-card-subtitle">
            Subscribe to our newsletter and get first access to new releases &amp; exclusive deals.
          </p>

          {% form 'customer', class: 'footer-form' %}
            <input type="hidden" name="contact[tags]" value="newsletter,footer">
            {%- if form.posted_successfully? -%}
              <div class="footer-success-box">
                <p class="footer-status-success">🎉 Sweet! Check your email for your 10% discount code.</p>
                <div class="footer-discount-pill">
                  <span class="footer-discount-label">USE CODE:</span>
                  <strong class="footer-discount-code">WELCOME10</strong>
                  <button type="button" class="footer-copy-code-btn" onclick="navigator.clipboard.writeText('WELCOME10'); this.innerText='COPIED!';" aria-label="Copy discount code">COPY</button>
                </div>
              </div>
            {%- else -%}
              {%- if form.errors -%}
                <p class="footer-status-error">{{ form.errors.messages['email'] }}</p>
              {%- endif -%}
              <input
                type="email"
                name="contact[email]"
                placeholder="Enter email address"
                required
                class="footer-input"
                aria-label="Email address for newsletter"
              >
              <button
                type="submit"
                class="footer-submit-btn button-primary"
              >
                GET MY 10% OFF
              </button>
            {%- endif -%}
          {% endform %}
        </div>

        <!-- Card 2: Get Drizzy with it -->
        <div class="footer-links-card">
          <h2 class="footer-links-title">
            Get Drizzy with it
          </h2>
          <div class="footer-links-grid">
            <!-- Col 1: Shop & About -->
            <div class="footer-nav-col">
              <ul class="footer-nav-list">
                <li>
                  <a href="{{ buy_now_url }}" class="footer-nav-link">Shop Drizzy</a>
                </li>
                <li>
                  <a href="{{ our_story_url }}" class="footer-nav-link">Our Story</a>
                </li>
                <li>
                  <a href="{{ wholesale_url }}" class="footer-nav-link">Wholesale</a>
                </li>
                {%- if contest_url != blank -%}
                <li>
                  <a href="{{ contest_url }}" class="footer-nav-link">Win Flights</a>
                </li>
                {%- endif -%}
              </ul>
            </div>

            <!-- Col 2: Legal & Rules -->
            <div class="footer-nav-col">
              <ul class="footer-nav-list">
                <li>
                  <a href="{{ privacy_url }}" class="footer-nav-link">Privacy Policy</a>
                </li>
                <li>
                  <a href="{{ terms_url }}" class="footer-nav-link">Terms of Service</a>
                </li>
                {%- if rules_url != blank -%}
                <li>
                  <a href="{{ rules_url }}" class="footer-nav-link">Sweepstakes Rules</a>
                </li>
                {%- endif -%}
                <li>
                  <a href="{{ store_locator_url }}" class="footer-nav-link">Store Locator</a>
                </li>
              </ul>
            </div>

            <!-- Col 3: Social Links -->
            <div class="footer-nav-col">
              <h3 class="footer-social-heading">Follow Us On</h3>
              <ul class="footer-social-list">
                <li>
                  <a
                    target="_blank"
                    rel="noopener noreferrer"
                    href="https://www.instagram.com/getdrizzy/"
                    class="footer-social-icon-link"
                    aria-label="Instagram"
                  >
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M7.8 2H16.2C19.4 2 22 4.6 22 7.8V16.2C22 17.7383 21.3889 19.2135 20.3012 20.3012C19.2135 21.3889 17.7383 22 16.2 22H7.8C4.6 22 2 19.4 2 16.2V7.8C2 6.26174 2.61107 4.78649 3.69878 3.69878C4.78649 2.61107 6.26174 2 7.8 2ZM7.6 4C6.64522 4 5.72955 4.37928 5.05442 5.05442C4.37928 5.72955 4 6.64522 4 7.6V16.4C4 18.39 5.61 20 7.6 20H16.4C17.3548 20 18.2705 19.6207 18.9456 18.9456C19.6207 18.2705 20 17.3548 20 16.4V7.6C20 5.61 18.39 4 16.4 4H7.6ZM17.25 5.5C17.5815 5.5 17.8995 5.6317 18.1339 5.86612C18.3683 6.10054 18.5 6.41848 18.5 6.75C18.5 7.08152 18.3683 7.39946 18.1339 7.63388C17.8995 7.8683 17.5815 8 17.25 8C16.9185 8 16.6005 7.8683 16.3661 7.63388C16.1317 7.39946 16 7.08152 16 6.75C16 6.41848 16.1317 6.10054 16.3661 5.86612C16.6005 5.6317 16.9185 5.5 17.25 5.5ZM12 7C13.3261 7 14.5979 7.52678 15.5355 8.46447C16.4732 9.40215 17 10.6739 17 12C17 13.3261 16.4732 14.5979 15.5355 15.5355C14.5979 16.4732 13.3261 17 12 17C10.6739 17 9.40215 16.4732 8.46447 15.5355C7.52678 14.5979 7 13.3261 7 12C7 10.6739 7.52678 9.40215 8.46447 8.46447C9.40215 7.52678 10.6739 7 12 7ZM12 9C11.2044 9 10.4413 9.31607 9.87868 9.87868C9.31607 10.4413 9 11.2044 9 12C9 12.7956 9.31607 13.5587 9.87868 14.1213C10.4413 14.6839 11.2044 15 12 15C12.7956 15 13.5587 14.6839 14.1213 14.1213C14.6839 13.5587 15 12.7956 15 12C15 11.2044 14.6839 10.4413 14.1213 9.87868C13.5587 9.31607 12.7956 9 12 9Z" fill="#2D0F28"/>
                    </svg>
                  </a>
                </li>
                <li>
                  <a
                    target="_blank"
                    rel="noopener noreferrer"
                    href="https://www.linkedin.com/company/drizzypeanuts/"
                    class="footer-social-icon-link"
                    aria-label="LinkedIn"
                  >
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M22.5 0H1.5C0.67 0 0 0.67 0 1.5V22.5C0 23.33 0.67 24 1.5 24H22.5C23.33 24 24 23.33 24 22.5V1.5C24 0.67 23.33 0 22.5 0ZM7.73 20.39H4.61V9.37H7.73V20.39ZM6.17 8.01C5.17 8.01 4.36 7.2 4.36 6.2C4.36 5.2 5.17 4.39 6.17 4.39C7.17 4.39 7.98 5.2 7.98 6.2C7.98 7.2 7.17 8.01 6.17 8.01ZM20.39 20.39H17.28V14.25C17.28 12.75 16.74 11.73 15.39 11.73C14.36 11.73 13.75 12.42 13.48 13.09C13.38 13.33 13.36 13.67 13.36 14.01V20.39H10.25V9.37H13.24V10.74C13.64 10.12 14.36 9.24 15.96 9.24C17.98 9.24 19.5 10.56 19.5 13.4V20.39H20.39Z" fill="#2D0F28"/>
                    </svg>
                  </a>
                </li>
                <li>
                  <a
                    target="_blank"
                    rel="noopener noreferrer"
                    href="https://www.tiktok.com/@getdrizzypeanuts"
                    class="footer-social-icon-link"
                    aria-label="TikTok"
                  >
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path
                        d="M10.6785 9.57C7.73422 9.428 5.68755 10.4777 4.53855 12.719C2.81555 16.0815 4.23955 21.5835 9.98855 21.5835C15.7386 21.5835 15.9045 16.0275 15.9045 15.4455V8.9375C17.1345 9.71617 18.1712 10.185 19.0145 10.344C19.8589 10.5027 20.3955 10.573 20.6245 10.555V7.317C19.8439 7.223 19.1689 7.04367 18.5996 6.779C17.7451 6.382 16.0515 5.2805 16.0515 3.666C16.0525 3.674 16.0525 3.2575 16.0515 2.4165H12.4925C12.4822 10.3245 12.4822 14.6675 12.4925 15.4455C12.508 16.6125 11.6025 18.2455 9.76755 18.2455C7.93155 18.2455 7.02605 16.614 7.02605 15.562C7.02605 14.918 7.24755 13.9845 8.16205 13.293C8.70455 12.883 9.45705 12.719 10.6785 12.719V9.57Z"
                        fill="#2D0F28"
                      />
                    </svg>
                  </a>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>

      <!-- Giant Centered Logo & Copyright -->
      <div class="footer-bottom-section">
        <div class="footer-logo-box">
          <img
            src="{{ 'drizzy-dark-logo.svg' | asset_url }}"
            alt="DRIZZY"
            class="footer-brand-logo-img"
            width="242"
            height="37"
            loading="lazy"
          >
        </div>
        <div class="footer-copyright">
          &copy; {{ 'now' | date: '%Y' }} Drizzy Pty Limited. All Rights Reserved.
        </div>
      </div>
    </div>
  </section>
</footer>

<style>
.footer-wrapper {
  position: relative;
  overflow: hidden;
  width: 100%;
}
.footer-section {
  position: relative;
  width: 100%;
  color: var(--color-foreground, #2d0f28);
  padding: 0 0 2.5rem;
  margin: 0;
  overflow: hidden;
}
@media (min-width: 1024px) {
  .footer-section {
    padding-bottom: 3.5rem;
  }
}
.footer-bg-wrapper {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
  overflow: hidden;
}
.footer-bg-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.footer-drip-wrapper {
  position: relative;
  z-index: 1;
  width: 100%;
  line-height: 0;
}
.footer-drip-desktop {
  display: none;
  width: 100%;
  height: auto;
  object-fit: cover;
}
@media (min-width: 1024px) {
  .footer-drip-desktop {
    display: block;
  }
}
.footer-drip-mobile {
  display: block;
  width: 100%;
  height: auto;
  object-fit: cover;
}
@media (min-width: 1024px) {
  .footer-drip-mobile {
    display: none;
  }
}
.footer-container {
  position: relative;
  z-index: 1;
  width: 100%;
  max-width: var(--page-max-width, var(--container-max-width, 1400px));
  margin-left: auto;
  margin-right: auto;
  padding: 1rem 1rem 0;
  box-sizing: border-box;
}
@media (min-width: 1024px) {
  .footer-container {
    padding: 2rem 1.5rem 0;
  }
}
.footer-cards-row {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  width: 100%;
}
@media (min-width: 1024px) {
  .footer-cards-row {
    flex-direction: row;
    gap: 2rem;
  }
}
.footer-newsletter-card {
  background-color: var(--color-cream, #fffbf2);
  border: 2px solid var(--border-color, #2d0f28);
  border-radius: var(--radius-2xl, 32px);
  padding: 2rem 1.5rem;
  box-shadow: var(--shadow-sm, 0 1px 3px rgba(45, 15, 40, 0.08));
  display: flex;
  flex-direction: column;
  justify-content: center;
  box-sizing: border-box;
}
@media (min-width: 1024px) {
  .footer-newsletter-card {
    width: 36%;
    padding: 2.5rem 2rem;
  }
}
.footer-card-title {
  font-family: var(--font-champ, var(--font-primary, 'Champ Black', serif));
  font-size: 1.5rem;
  line-height: 1.1;
  text-transform: uppercase;
  color: var(--color-dark-brown, #2d0f28);
  margin: 0;
}
@media (min-width: 640px) {
  .footer-card-title {
    font-size: 1.875rem;
  }
}
@media (min-width: 1024px) {
  .footer-card-title {
    font-size: 2.25rem;
  }
}
.footer-card-subtitle {
  font-family: var(--font-mono, var(--font-secondary, 'Azeret Mono', monospace));
  font-size: 0.75rem;
  line-height: 1.6;
  color: rgba(45, 15, 40, 0.9);
  margin-top: 0.75rem;
  margin-bottom: 0;
}
@media (min-width: 1024px) {
  .footer-card-subtitle {
    font-size: 0.875rem;
  }
}
.footer-form {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  margin-top: 1.5rem;
}
.footer-input {
  height: 49px;
  border: 2px solid var(--border-color, #2d0f28);
  background-color: var(--color-cream, #fffbf2);
  padding: 1rem;
  border-radius: var(--radius-sm, 6px);
  color: var(--color-dark-brown, #2d0f28);
  font-family: var(--font-mono, var(--font-secondary, 'Azeret Mono', monospace));
  font-size: 0.875rem;
  outline: none;
  box-sizing: border-box;
  width: 100%;
}
.footer-input::placeholder {
  color: rgba(45, 15, 40, 0.6);
}
.footer-input:focus {
  border-color: var(--color-dark-brown, #2d0f28);
  background-color: #fff;
}
.footer-submit-btn {
  width: 100%;
  padding: 1rem;
  font-size: 0.875rem;
  text-transform: uppercase;
  box-sizing: border-box;
}
@media (min-width: 1024px) {
  .footer-submit-btn {
    font-size: 1rem;
  }
}
.footer-status-success {
  font-family: var(--font-mono, var(--font-secondary, 'Azeret Mono', monospace));
  font-size: 0.75rem;
  color: var(--color-accent-green, #036e2c);
  font-weight: 700;
  margin: 0;
}
.footer-success-box {
  margin-top: 1.25rem;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}
.footer-discount-pill {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: #ffffff;
  border: 2px dashed var(--border-color, #2d0f28);
  border-radius: var(--radius-sm, 6px);
  padding: 0.625rem 0.875rem;
  gap: 0.5rem;
  box-sizing: border-box;
  width: 100%;
}
.footer-discount-label {
  font-family: var(--font-mono, var(--font-secondary, 'Azeret Mono', monospace));
  font-size: 0.6875rem;
  font-weight: 700;
  color: rgba(45, 15, 40, 0.7);
  letter-spacing: 0.05em;
}
.footer-discount-code {
  font-family: var(--font-champ, var(--font-primary, 'Champ Black', serif));
  font-size: 1.125rem;
  color: var(--color-dark-brown, #2d0f28);
  letter-spacing: 0.05em;
}
.footer-copy-code-btn {
  background-color: var(--color-accent-purple, #ca9af1);
  color: var(--color-foreground, #2d0f28);
  border: 1.5px solid var(--border-color, #2d0f28);
  border-radius: 4px;
  padding: 0.25rem 0.625rem;
  font-family: var(--font-mono, var(--font-secondary, 'Azeret Mono', monospace));
  font-size: 0.6875rem;
  font-weight: 800;
  cursor: pointer;
  transition: transform 0.15s ease, background-color 0.15s ease;
}
.footer-copy-code-btn:hover {
  background-color: #be84ec;
  transform: scale(1.05);
}
.footer-status-error {
  font-family: var(--font-mono, var(--font-secondary, 'Azeret Mono', monospace));
  font-size: 0.75rem;
  color: #c53030;
  font-weight: 700;
  margin-top: 0.5rem;
  margin-bottom: 0;
}
.footer-links-card {
  flex-grow: 1;
  background-color: var(--color-cream, #fffbf2);
  border: 2px solid var(--border-color, #2d0f28);
  border-radius: var(--radius-2xl, 32px);
  padding: 2rem 1.5rem;
  box-shadow: var(--shadow-sm, 0 1px 3px rgba(45, 15, 40, 0.08));
  box-sizing: border-box;
}
@media (min-width: 1024px) {
  .footer-links-card {
    padding: 2.5rem;
  }
}
.footer-links-title {
  font-family: var(--font-champ, var(--font-primary, 'Champ Black', serif));
  font-size: 1.875rem;
  line-height: 1.1;
  text-transform: uppercase;
  color: var(--color-dark-brown, #2d0f28);
  margin: 0;
}
@media (min-width: 640px) {
  .footer-links-title {
    font-size: 2.25rem;
  }
}
@media (min-width: 1024px) {
  .footer-links-title {
    font-size: 3rem;
  }
}
.footer-links-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1.5rem;
  margin-top: 2rem;
}
@media (min-width: 768px) {
  .footer-links-grid {
    grid-template-columns: repeat(3, 1fr);
    margin-top: 2.5rem;
  }
}
.footer-nav-col {
  display: flex;
  flex-direction: column;
}
.footer-nav-list {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 1rem;
  font-family: var(--font-mono, var(--font-secondary, 'Azeret Mono', monospace));
  font-size: 0.75rem;
  margin: 0;
  padding: 0;
}
@media (min-width: 1024px) {
  .footer-nav-list {
    gap: 1.5rem;
    font-size: 0.875rem;
  }
}
.footer-nav-link {
  color: var(--color-dark-brown, #2d0f28);
  text-decoration: none;
  display: block;
  width: fit-content;
  transition: opacity var(--transition-fast, 0.15s ease);
}
.footer-nav-link:hover {
  opacity: 0.8;
  text-decoration: underline;
}
.footer-social-heading {
  font-family: var(--font-mono, var(--font-secondary, 'Azeret Mono', monospace));
  font-size: 0.75rem;
  margin-bottom: 1rem;
  margin-top: 0;
  color: var(--color-dark-brown, #2d0f28);
  font-weight: 700;
  text-transform: uppercase;
}
@media (min-width: 1024px) {
  .footer-social-heading {
    font-size: 0.875rem;
  }
}
.footer-social-list {
  list-style: none;
  display: flex;
  gap: 1.5rem;
  align-items: center;
  margin: 0;
  padding: 0;
}
.footer-social-icon-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 1.5rem;
  height: 1.5rem;
  color: var(--color-dark-brown, #2d0f28);
  transition: opacity var(--transition-fast, 0.15s ease);
}
.footer-social-icon-link:hover {
  opacity: 0.7;
