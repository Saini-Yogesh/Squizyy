{%- comment -%}
  Our Story Milestone Timeline with Top Drip
{%- endcomment -%}

<section class="story-timeline-section">
  <!-- Drip Transition -->
  <div class="timeline-drip-top">
    <img src="{{ 'timeline-drip.svg' | asset_url }}" alt="" class="timeline-drip-img" aria-hidden="true">
  </div>

  <div class="timeline-container container">
    <h2 class="timeline-main-title">THE DRIZZY TIMELINE</h2>

    <div class="timeline-steps">
      <!-- Step 1 -->
      <div class="timeline-step">
        <div class="step-image-wrap">
          <img src="{{ 'timeline-1.jpg' | asset_url }}" alt="2024 Beginnings" class="step-img">
        </div>
        <div class="step-content">
          <span class="step-year">2024</span>
          <h3 class="step-title">The Kitchen Experiment</h3>
          <p class="step-desc">Tired of cleaning butter knives and tearing bread, the initial squeeze prototypes were created in a home kitchen using Aussie peanuts.</p>
        </div>
      </div>

      <!-- Step 2 -->
      <div class="timeline-step">
        <div class="step-image-wrap">
          <img src="{{ 'timeline-2.png' | asset_url }}" alt="2025 Sourcing Trip" class="step-img">
        </div>
        <div class="step-content">
          <span class="step-year">2025</span>
          <h3 class="step-title">Kingaroy High-Oleic Partnership</h3>
          <p class="step-desc">Direct partnership signed with Queensland farmers to exclusively harvest high-oleic peanuts with optimal oleic acid profiles.</p>
        </div>
      </div>

      <!-- Step 3 -->
      <div class="timeline-step">
        <div class="step-image-wrap">
          <img src="{{ 'timeline-3.jpg' | asset_url }}" alt="2026 USA Launch" class="step-img">
        </div>
        <div class="step-content">
          <span class="step-year">2026</span>
          <h3 class="step-title">USA & Sprouts Launch</h3>
          <p class="step-desc">Drizzy lands in America! Stocked nationwide across Sprouts Farmers Markets and delivered fresh directly to your front porch.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
.story-timeline-section {
  position: relative;
  background-color: var(--color-foreground, #2d0f28);
  color: #ffffff;
  padding-bottom: 6rem;
}
.timeline-drip-top {
  width: 100%;
  line-height: 0;
  margin-bottom: 4rem;
}
.timeline-drip-img {
  width: 100%;
  height: auto;
  display: block;
}
.timeline-main-title {
  font-family: var(--font-primary, 'Champ Black', serif);
  font-size: clamp(2.25rem, 4.5vw, 3.5rem);
  text-align: center;
  margin: 0 0 4rem 0;
  text-transform: uppercase;
}
.timeline-steps {
  display: flex;
  flex-direction: column;
  gap: 4rem;
  max-width: 860px;
  margin: 0 auto;
}
.timeline-step {
  display: grid;
  grid-template-columns: 1fr;
  gap: 2rem;
  align-items: center;
  background-color: var(--color-cream, #fffbf2);
  color: var(--color-foreground, #2d0f28);
  border-radius: var(--radius-2xl, 32px);
  padding: 2.5rem;
  border: 4px solid var(--color-accent-purple, #ca9af1);
  box-shadow: 0 10px 0 var(--color-accent-purple, #ca9af1);
}
@media (min-width: 768px) {
  .timeline-step {
    grid-template-columns: 1fr 1.3fr;
  }
}
.step-image-wrap {
  aspect-ratio: 4 / 3;
  border-radius: var(--radius-xl);
  overflow: hidden;
  border: 2px solid var(--color-foreground, #2d0f28);
}
.step-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.step-year {
  font-family: var(--font-primary, 'Champ Black', serif);
  font-size: 2rem;
  color: var(--color-accent-purple, #ca9af1);
  display: block;
  margin-bottom: 0.25rem;
}
.step-title {
  font-family: var(--font-primary, 'Champ Black', serif);
  font-size: 1.5rem;
  margin: 0 0 0.75rem 0;
}
.step-desc {
  font-size: 0.95rem;
  line-height: 1.6;
  opacity: 0.85;
  margin: 0;
}
</style>

{% schema %}
{
  "name": "Story Timeline",
  "settings": [],
  "presets": [
    {
      "name": "Story Timeline"
    }
  ]
}
{% endschema %}
