<section class="contest-trip-section" id="trip-details">
  <div class="contest-trip-card">
    <!-- Dripping Graphic Divider -->
    <div class="contest-trip-drip">
      <img src="{{ 'cream-dripping-graphic.png' | asset_url }}" alt="" aria-hidden="true">
    </div>

    <div class="contest-trip-content">
      <h2 class="contest-trip-title">{{ section.settings.heading | default: "Here's What You're Playing For" }}</h2>

      <div class="contest-prizes-row">
        <!-- Prize 1 -->
        <div class="contest-prize-item">
          <img src="{{ 'flight-icon.png' | asset_url }}" alt="Round-trip flights" class="contest-prize-icon">
          <h3 class="contest-prize-heading">Round-trip flights</h3>
          <p class="contest-prize-desc">Round-trip economy flights to Sydney, Australia for you and a guest.</p>
        </div>

        <!-- Prize 2 -->
        <div class="contest-prize-item">
          <img src="{{ 'cash-icon.png' | asset_url }}" alt="$2,000 spending money" class="contest-prize-icon">
          <h3 class="contest-prize-heading">$2,000 spending money</h3>
          <p class="contest-prize-desc">To spend on your hotel accommodations, food, and other expenses while in Australia.</p>
        </div>

        <!-- Prize 3 -->
        <div class="contest-prize-item">
          <img src="{{ 'cam-icon.png' | asset_url }}" alt="An unforgettable trip" class="contest-prize-icon">
          <h3 class="contest-prize-heading">An unforgettable trip</h3>
          <p class="contest-prize-desc">One winner + one guest are heading Down Under.</p>
        </div>
      </div>

      <div class="contest-trip-cta">
        <a href="#instructions" class="button-primary contest-trip-btn">ENTER</a>
      </div>
    </div>
  </div>
</section>

<style>
.contest-trip-section {
  background-color: var(--color-background, #fffaf3);
  padding: 2rem 1rem 4rem 1rem;
}
@media (min-width: 1024px) {
  .contest-trip-section {
    padding: 3rem 1.5rem 5rem 1.5rem;
  }
}
.contest-trip-card {
  position: relative;
  background-color: var(--color-accent-purple, #ca9af1);
  border: 4px solid var(--color-dark-brown, #2b1408);
  border-bottom-width: 8px;
  border-radius: var(--radius-2xl, 32px);
  margin: 0 auto;
  max-width: 87.5rem;
  overflow: hidden;
  box-shadow: 0 20px 40px rgba(43, 20, 8, 0.12);
  color: var(--color-dark-brown, #2b1408);
  box-sizing: border-box;
}
.contest-trip-drip {
  width: 100%;
}
.contest-trip-drip img {
  width: 100%;
  display: block;
}
.contest-trip-content {
  padding: 2.5rem 1.5rem 3.5rem 1.5rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
@media (min-width: 768px) {
  .contest-trip-content {
    padding: 3.5rem 3rem 4.5rem 3rem;
  }
}
.contest-trip-title {
  font-family: var(--font-primary, 'Champ Black', serif);
  font-size: 2.25rem;
  line-height: 1.05;
  text-transform: uppercase;
  color: var(--color-dark-brown, #2b1408);
  margin: 0 0 3rem 0;
  max-width: 25ch;
}
@media (min-width: 640px) {
  .contest-trip-title {
    font-size: 3rem;
  }
}
@media (min-width: 1024px) {
  .contest-trip-title {
    font-size: 3.75rem;
  }
}
.contest-prizes-row {
  display: grid;
  grid-template-columns: 1fr;
  gap: 2.5rem;
  width: 100%;
  max-width: 68rem;
  margin: 0 auto;
}
@media (min-width: 768px) {
  .contest-prizes-row {
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }
}
.contest-prize-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.contest-prize-icon {
  width: 5.5rem;
  height: 5.5rem;
  object-fit: contain;
  margin-bottom: 1.25rem;
}
.contest-prize-heading {
  font-family: var(--font-primary, 'Champ Black', serif);
  font-size: 1.5rem;
  text-transform: uppercase;
  color: var(--color-dark-brown, #2b1408);
  margin: 0 0 0.75rem 0;
}
.contest-prize-desc {
  font-size: 0.95rem;
  line-height: 1.5;
  color: var(--color-dark-brown, #2b1408);
  margin: 0;
  max-width: 28ch;
}
.contest-trip-cta {
  margin-top: 3.5rem;
  width: 100%;
  display: flex;
  justify-content: center;
}
.contest-trip-btn {
  background-color: var(--color-cream, #fffbf2) !important;
  color: var(--color-dark-brown, #2b1408) !important;
  width: 100%;
  max-width: 320px;
  padding: 1rem;
  font-size: 1.25rem;
  letter-spacing: 0.05em;
  text-align: center;
}
</style>

{% schema %}
{
  "name": "Contest Prizes",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Here's What You're Playing For"
    }
  ],
  "presets": [
    {
      "name": "Contest Prizes"
    }
  ]
}
{% endschema %}
