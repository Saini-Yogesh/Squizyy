{%- comment -%}
  Main Collection Grid (PLP) — "Shop All Squizyy"
  Faithfully ported from client/src/pages/Products.jsx, Products.module.css & ProductCard.module.css
{%- endcomment -%}

<section class="collection-section" aria-label="All Products">
  <div class="collection-container">
    <!-- Header Area -->
    <div class="collection-header-area">
      <h1 class="collection-page-title">
        {{ collection.title | default: 'Shop All Squizyy' }}
      </h1>
      <p class="collection-page-subtitle">
        {{ collection.description | default: '100% natural squeezy peanut butter, crafted from high-oleic roasted Indian runner peanuts.' }}
      </p>
    </div>

    <!-- Product Grid: 100% Dynamic from Shopify Admin -->
    {%- paginate collection.products by 12 -%}
      {%- if collection.products.size > 0 -%}
        <div class="collection-products-grid">
          {%- for product in collection.products -%}
            {% render 'product-card', product: product %}
          {%- endfor -%}
        </div>
      {%- elsif collections.all.products.size > 0 -%}
        <div class="collection-products-grid">
          {%- for product in collections.all.products -%}
            {% render 'product-card', product: product %}
          {%- endfor -%}
        </div>
      {%- else -%}
        <div class="collection-empty-box">
          <div class="empty-icon">🥜</div>
          <h2 class="empty-title">Products will appear here once added in Shopify</h2>
          <p class="empty-desc">
            Go to <strong>Shopify Admin &rarr; Products &rarr; Import</strong> and upload your <code>squizyy-products-import.csv</code> file.<br>
            All products, prices, images, and inventory will automatically show up here in real time!
          </p>
          <a href="{{ routes.root_url }}" class="button-primary empty-btn">Back to Home</a>
        </div>
      {%- endif -%}

      {%- if paginate.pages > 1 -%}
        <div class="collection-pagination">
          {{ paginate | default_pagination }}
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

<style>
.collection-section {
  position: relative;
  background-color: var(--color-cream, #fffbf2);
  color: var(--color-dark-brown, #2b1408);
  padding: 2.5rem 1rem 5rem;
}
@media (min-width: 640px) {
  .collection-section {
    padding: 3.5rem 1.5rem 6rem;
  }
}
@media (min-width: 1024px) {
  .collection-section {
    padding: 4.5rem 2rem 7rem;
  }
}
.collection-container {
  margin: 0 auto;
  max-width: var(--page-max-width, 87.5rem);
  width: 100%;
  box-sizing: border-box;
}
.collection-header-area {
  margin-bottom: 2.5rem;
}
.collection-page-title {
  font-family: var(--font-primary, 'Champ Black', serif);
  font-size: 2.25rem;
  line-height: 1.1;
  text-transform: uppercase;
  color: var(--color-dark-brown, #2d0f28);
  margin: 0 0 0.5rem 0;
}
@media (min-width: 640px) {
  .collection-page-title {
    font-size: 3rem;
  }
}
.collection-page-subtitle {
  font-family: var(--font-secondary, 'Azeret Mono', monospace);
  font-size: 0.875rem;
  color: rgba(43, 20, 8, 0.75);
  margin: 0;
}
.collection-products-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1.5rem;
  width: 100%;
}
@media (min-width: 640px) {
  .collection-products-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}
@media (min-width: 1024px) {
  .collection-products-grid {
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }
}
.product-card {
  height: 100%;
  width: 100%;
  position: relative;
  box-sizing: border-box;
}
.product-card-inner {
  display: flex;
  height: 100%;
  width: 100%;
  flex-direction: column;
  gap: 0.75rem;
}
.product-card-image-link {
  width: 100%;
  aspect-ratio: 3 / 4;
  overflow: hidden;
  position: relative;
  z-index: 0;
  border: 2px solid var(--border-color, #2d0f28);
  border-radius: var(--radius-lg, 16px);
  background-color: #ffffff;
  box-shadow: var(--shadow-sm, 0 1px 3px rgba(45, 15, 40, 0.08));
  display: block;
  text-decoration: none;
  box-sizing: border-box;
}
@media (min-width: 640px) {
  .product-card-image-link {
    border-width: 3px;
    border-radius: 22px;
  }
}
.product-card-image-container {
  height: 100%;
  width: 100%;
  position: relative;
}
.product-card-primary-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  position: absolute;
  inset: 0;
  z-index: 2;
  transition: opacity 0.25s ease-in-out;
  opacity: 1;
  display: block;
}
.product-card-hover-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  position: absolute;
  inset: 0;
  z-index: 1;
  transition: opacity 0.25s ease-in-out;
  opacity: 0;
  display: block;
}
.product-card-image-link:hover .product-card-primary-img {
  opacity: 0;
}
.product-card-image-link:hover .product-card-hover-img {
  opacity: 1;
}
.product-card-info {
  display: flex;
  flex-direction: column;
  gap: 0.375rem;
  z-index: 2;
  margin-top: 0.25rem;
}
.product-card-title {
  font-family: var(--font-mono, var(--font-secondary, 'Azeret Mono', monospace));
  font-size: 0.875rem;
  font-weight: 700;
  color: var(--color-dark-brown, #2d0f28);
  text-decoration: none;
  line-height: 1.3;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
@media (min-width: 640px) {
  .product-card-title {
    font-size: 1rem;
  }
}
.product-card-title:hover {
  text-decoration: underline;
}
.product-card-price {
  font-family: var(--font-mono, var(--font-secondary, 'Azeret Mono', monospace));
  font-size: 0.875rem;
  font-weight: 700;
  color: var(--color-dark-brown, #2d0f28);
}
@media (min-width: 640px) {
  .product-card-price {
    font-size: 1rem;
  }
}
.product-card-actions {
  width: 100%;
  margin-top: auto;
  padding-top: 0.5rem;
}
.product-card-btn {
  width: 100%;
  padding: 0.75rem 1.25rem;
  font-size: 1rem;
  text-transform: uppercase;
  box-sizing: border-box;
}
@media (min-width: 640px) {
  .product-card-btn {
    padding: 0.875rem 1.5rem;
    font-size: 1.125rem;
  }
}
.collection-pagination {
  margin-top: 3rem;
  text-align: center;
}
.collection-empty-box {
  grid-column: 1 / -1;
  text-align: center;
  padding: 4rem 1.5rem;
  background-color: #ffffff;
  border: 3px solid var(--color-foreground, #2d0f28);
  border-radius: var(--radius-xl, 24px);
  max-width: 600px;
  margin: 2rem auto;
  box-shadow: 0 4px 12px rgba(45, 15, 40, 0.08);
}
.empty-icon {
  font-size: 3rem;
  margin-bottom: 1rem;
}
.empty-title {
  font-family: var(--font-primary, 'Champ Black', serif);
  font-size: 1.5rem;
  color: var(--color-foreground, #2d0f28);
  margin-bottom: 0.75rem;
  text-transform: uppercase;
}
.empty-desc {
  font-family: var(--font-secondary, 'Azeret Mono', monospace);
  font-size: 0.875rem;
  color: rgba(45, 15, 40, 0.75);
  line-height: 1.6;
  margin-bottom: 1.5rem;
}
.empty-desc code {
  background-color: var(--color-accent-purple, #ca9af1);
  color: var(--color-foreground, #2d0f28);
  padding: 2px 6px;
  border-radius: 4px;
  font-weight: 700;
}
.empty-btn {
  display: inline-block;
  padding: 0.75rem 1.75rem;
  text-decoration: none;
}
</style>

{% schema %}
{
  "name": "Collection Grid",
  "settings": [],
  "presets": [
    {
      "name": "Collection Grid"
    }
  ]
}
{% endschema %}
