</style>

{% schema %}
{
  "name": "Wholesale Form",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Be one of the first to stock Drizzy."
    },
    {
      "type": "image_picker",
      "id": "side_image",
      "label": "Side Image"
    }
  ],
  "presets": [
    {
      "name": "Wholesale Form"
    }
  ]
}
{% endschema %}
