<section class="wholesale-form-section">
  <div class="wholesale-form-container">
    <!-- Left Column: Image with Mascot -->
    <div class="wholesale-form-img-col">
      <div class="wholesale-form-img-frame">
        {%- if section.settings.side_image != blank -%}
          {{ section.settings.side_image | image_url: width: 1000 | image_tag: alt: 'Wholesale Drizzy', class: 'wholesale-form-img' }}
        {%- else -%}
          <img src="{{ 'wholesale-form.png' | asset_url }}" alt="Wholesale Drizzy bottles" class="wholesale-form-img">
        {%- endif -%}
      </div>
      <div class="wholesale-form-mascot">
        <img src="{{ 'peanut-man.png' | asset_url }}" alt="" aria-hidden="true">
      </div>
    </div>

    <!-- Right Column: Form Card -->
    <div class="wholesale-form-card">
      <h2 class="wholesale-form-heading">{{ section.settings.heading | default: 'Be one of the first to stock Drizzy.' }}</h2>
      <div class="wholesale-form-subtext">
        <p>We're partnering with select stores who care about quality, natural products and seriously smooth peanut butter.</p>
        <p>Tell us where you're from and we'll be in touch.</p>
      </div>

      {%- form 'contact', id: 'contact_form', class: 'wholesale-form-inner' -%}
        {%- if form.posted_successfully? -%}
          <div class="wholesale-form-success">
            <p class="wholesale-success-title">🎉 Application Sent!</p>
            <p class="wholesale-success-desc">Thank you! Your wholesale application has been submitted. Our team will review it within 1-2 business days.</p>
          </div>
        {%- else -%}
          {%- if form.errors -%}
            <div class="wholesale-form-errors" role="alert">
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}

          <div class="wholesale-form-grid">
            <div class="wholesale-field-group">
              <label for="WholesaleForm-name" class="wholesale-field-label">Name *</label>
              <input
                type="text"
                id="WholesaleForm-name"
                name="contact[name]"
                value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                placeholder="your name"
                required
                class="wholesale-input"
              >
            </div>

            <div class="wholesale-field-group">
              <label for="WholesaleForm-email" class="wholesale-field-label">Email *</label>
              <input
                type="email"
                id="WholesaleForm-email"
                name="contact[email]"
                value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                placeholder="you@somemail.com"
                required
                class="wholesale-input"
              >
            </div>

            <div class="wholesale-field-group">
              <label for="WholesaleForm-company" class="wholesale-field-label">Company *</label>
              <input
                type="text"
                id="WholesaleForm-company"
                name="contact[company]"
                placeholder="your company"
                required
                class="wholesale-input"
              >
            </div>

            <div class="wholesale-field-group">
              <label for="WholesaleForm-phone" class="wholesale-field-label">Phone Number</label>
              <input
                type="tel"
                id="WholesaleForm-phone"
                name="contact[phone]"
                placeholder="your contact"
                class="wholesale-input"
              >
            </div>

            <div class="wholesale-field-group wholesale-field-full">
              <label for="WholesaleForm-body" class="wholesale-field-label">Message</label>
              <textarea
                rows="5"
                id="WholesaleForm-body"
                name="contact[body]"
                placeholder="tell us about your business"
                class="wholesale-input wholesale-textarea"
              >{{ form.body }}</textarea>
            </div>
          </div>

          <div class="wholesale-submit-wrap">
            <button type="submit" class="button-primary wholesale-submit-btn">
              Submit form
            </button>
            <p class="wholesale-submit-note">Applications are reviewed within 1-2 business days.</p>
          </div>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

<!-- Sprouts Nationwide Banner -->
<section class="wholesale-sprouts-section">
  <div class="wholesale-sprouts-container">
    <h2 class="wholesale-sprouts-title">Aug 24, stocked nation-wide at</h2>
    <div class="wholesale-sprouts-logo">
      <img src="{{ 'sprouts-market.png' | asset_url }}" alt="Sprouts Farmers Market">
    </div>
  </div>
</section>

<style>
