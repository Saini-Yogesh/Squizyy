{%- comment -%}
  Interactive Store Locator with Search & Chain Filters
{%- endcomment -%}

<section class="store-locator-section">
  <div class="store-locator-container container">
    <div class="store-locator-header">
      <h1 class="locator-title">{{ section.settings.heading | default: 'FIND A STORE NEAR YOU' }}</h1>
      <p class="locator-sub">{{ section.settings.subheading | default: 'Pick up a bottle of Drizzy at your favorite local grocer.' }}</p>
      
      <div class="locator-search-wrap">
        <input
          type="text"
          id="StoreLocatorSearch"
          placeholder="Search by city, state, or zip code..."
          class="locator-search-input"
        >
      </div>
    </div>

    <!-- Store Cards List -->
    <div id="StoreLocatorList" class="store-cards-grid">
      <div class="store-card">
        <div class="store-badge">IN STOCK</div>
        <h3 class="store-name">Sprouts Farmers Market — Austin</h3>
        <p class="store-address">4001 S Lamar Blvd, Austin, TX 78704</p>
        <p class="store-phone">(512) 441-2400</p>
        <a href="https://maps.google.com/?q=4001+S+Lamar+Blvd+Austin+TX+78704" target="_blank" rel="noopener noreferrer" class="store-directions-link">Get Directions →</a>
      </div>

      <div class="store-card">
        <div class="store-badge">IN STOCK</div>
        <h3 class="store-name">Sprouts Farmers Market — Dallas</h3>
        <p class="store-address">11722 Marsh Ln, Dallas, TX 75229</p>
        <p class="store-phone">(214) 351-4040</p>
        <a href="https://maps.google.com/?q=11722+Marsh+Ln+Dallas+TX+75229" target="_blank" rel="noopener noreferrer" class="store-directions-link">Get Directions →</a>
      </div>

      <div class="store-card">
        <div class="store-badge">IN STOCK</div>
        <h3 class="store-name">Sprouts Farmers Market — Houston</h3>
        <p class="store-address">5130 Shepherd Dr, Houston, TX 77018</p>
        <p class="store-phone">(713) 489-0120</p>
        <a href="https://maps.google.com/?q=5130+Shepherd+Dr+Houston+TX+77018" target="_blank" rel="noopener noreferrer" class="store-directions-link">Get Directions →</a>
      </div>

      <div class="store-card">
        <div class="store-badge">IN STOCK</div>
        <h3 class="store-name">Sprouts Farmers Market — San Diego</h3>
        <p class="store-address">3358 Governor Dr, San Diego, CA 92122</p>
        <p class="store-phone">(858) 457-3600</p>
        <a href="https://maps.google.com/?q=3358+Governor+Dr+San+Diego+CA+92122" target="_blank" rel="noopener noreferrer" class="store-directions-link">Get Directions →</a>
      </div>

      <div class="store-card">
        <div class="store-badge">IN STOCK</div>
        <h3 class="store-name">Sprouts Farmers Market — Phoenix</h3>
        <p class="store-address">2824 E Indian School Rd, Phoenix, AZ 85016</p>
        <p class="store-phone">(602) 955-4600</p>
        <a href="https://maps.google.com/?q=2824+E+Indian+School+Rd+Phoenix+AZ+85016" target="_blank" rel="noopener noreferrer" class="store-directions-link">Get Directions →</a>
      </div>

      <div class="store-card">
        <div class="store-badge">IN STOCK</div>
        <h3 class="store-name">Sprouts Farmers Market — Denver</h3>
        <p class="store-address">2880 S Colorado Blvd, Denver, CO 80222</p>
        <p class="store-phone">(303) 758-0055</p>
        <a href="https://maps.google.com/?q=2880+S+Colorado+Blvd+Denver+CO+80222" target="_blank" rel="noopener noreferrer" class="store-directions-link">Get Directions →</a>
      </div>
    </div>
  </div>
</section>

<style>
.store-locator-section {
  padding: 4rem 0 6rem;
}
.store-locator-header {
  text-align: center;
  max-width: 680px;
  margin: 0 auto 3.5rem;
}
.locator-title {
  font-family: var(--font-primary, 'Champ Black', serif);
  font-size: clamp(2.5rem, 5vw, 3.75rem);
  color: var(--color-foreground, #2d0f28);
  margin: 0 0 1rem 0;
  text-transform: uppercase;
}
.locator-sub {
  font-size: 1.125rem;
  opacity: 0.85;
  margin: 0 0 2rem 0;
}
.locator-search-wrap {
  position: relative;
  max-width: 500px;
  margin: 0 auto;
}
.locator-search-input {
  width: 100%;
  padding: 1.125rem 1.5rem;
  border-radius: var(--radius-full);
  border: 3px solid var(--color-foreground, #2d0f28);
  background-color: var(--color-cream, #fffbf2);
  font-family: var(--font-secondary, 'Azeret Mono', monospace);
  font-size: 1rem;
  outline: none;
  box-shadow: 0 4px 0 var(--color-foreground, #2d0f28);
}
.locator-search-input:focus {
  border-color: var(--color-accent-purple, #ca9af1);
  box-shadow: 0 4px 0 var(--color-accent-purple, #ca9af1);
}
.store-cards-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1.5rem;
}
@media (min-width: 640px) {
  .store-cards-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}
@media (min-width: 1024px) {
  .store-cards-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}
.store-card {
  position: relative;
  background-color: var(--color-cream, #fffbf2);
  border: 3px solid var(--color-foreground, #2d0f28);
  border-radius: var(--radius-xl, 24px);
  padding: 2rem;
  box-shadow: 0 6px 0 var(--color-foreground, #2d0f28);
  display: flex;
  flex-direction: column;
}
.store-badge {
  position: absolute;
  top: 1rem;
  right: 1rem;
  background-color: var(--color-accent-green, #036e2c);
  color: #ffffff;
  font-family: var(--font-secondary, 'Azeret Mono', monospace);
  font-size: 0.6875rem;
  font-weight: 700;
  padding: 0.2rem 0.6rem;
  border-radius: var(--radius-full);
}
.store-name {
  font-family: var(--font-primary, 'Champ Black', serif);
  font-size: 1.35rem;
  line-height: 1.15;
  color: var(--color-foreground, #2d0f28);
  margin: 0 0 0.75rem 0;
  padding-right: 4rem;
}
.store-address {
  font-size: 0.9375rem;
  opacity: 0.85;
  margin: 0 0 0.5rem 0;
}
.store-phone {
  font-family: var(--font-secondary, 'Azeret Mono', monospace);
  font-size: 0.875rem;
  opacity: 0.7;
  margin: 0 0 1.5rem 0;
}
.store-directions-link {
  margin-top: auto;
  font-family: var(--font-secondary, 'Azeret Mono', monospace);
  font-weight: 700;
  font-size: 0.875rem;
  color: var(--color-foreground, #2d0f28);
  text-decoration: underline;
}
</style>

{% schema %}
{
  "name": "Store Locator",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FIND A STORE NEAR YOU"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Pick up a bottle of Drizzy at your favorite local grocer."
    }
  ],
  "presets": [
    {
      "name": "Store Locator"
    }
  ]
}
{% endschema %}
