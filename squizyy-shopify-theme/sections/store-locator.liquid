{%- comment -%}
  Store Locator — "Physical Stores Available Soon"
  Clean, authentic announcement with online store & wholesale CTAs.
{%- endcomment -%}

{%- assign main_product = nil -%}
{%- if all_products['drizzy-squeezy-peanut-butter-19-4-oz'].title != blank -%}
  {%- assign main_product = all_products['drizzy-squeezy-peanut-butter-19-4-oz'] -%}
{%- elsif all_products['drizzy-peanut-butter'].title != blank -%}
  {%- assign main_product = all_products['drizzy-peanut-butter'] -%}
{%- elsif collections.all.products.first != blank -%}
  {%- assign main_product = collections.all.products.first -%}
{%- endif -%}

{%- if main_product != blank and main_product.url != blank -%}
  {%- assign buy_now_url = main_product.url -%}
{%- else -%}
  {%- assign buy_now_url = routes.all_products_collection_url -%}
{%- endif -%}

{%- assign wholesale_url = '/pages/wholesale' -%}
{%- if pages['wholesale'].title != blank -%}
  {%- assign wholesale_url = pages['wholesale'].url -%}
{%- endif -%}

<section class="store-locator-section">
  <div class="store-locator-container container">
    <div class="store-locator-header">
      <h1 class="locator-title">{{ section.settings.heading | default: 'FIND IN STORE' }}</h1>
      <p class="locator-sub">{{ section.settings.subheading | default: 'Our retail launch is on the way.' }}</p>
    </div>

    <!-- Available Soon Center Card -->
    <div class="store-available-soon-card">
      <div class="store-badge-pill">AVAILABLE SOON</div>

      <div class="store-mascot-wrapper">
        <img
          src="{{ 'mascot-tiny_aecd74eb-a0fc-47ff-bf37-7ce347d869a5.svg' | asset_url }}"
          alt=""
          width="50"
          height="70"
          class="store-mascot-img"
          loading="lazy"
        >
      </div>

      <h2 class="store-card-heading">Stores Will Be Available Soon!</h2>
      <p class="store-card-text">
        We're currently gearing up and partnering with quality grocers, cafes, and supermarkets across the country. In the meantime, you don't have to wait — grab your favorite squeezy peanut butter directly from our online store with fast doorstep delivery!
      </p>

      <div class="store-actions-row">
        <a href="{{ buy_now_url }}" class="button-primary store-btn-primary">
          <span>BUY DRIZZY ONLINE</span>
        </a>
        <a href="{{ wholesale_url }}" class="store-btn-secondary">
          <span>WHOLESALE INQUIRIES</span>
        </a>
      </div>

      <div class="store-grocer-note">
        <p>Are you a retail buyer, grocer, or cafe owner? <a href="{{ wholesale_url }}">Contact our wholesale team</a> to stock Drizzy early.</p>
      </div>
    </div>
  </div>
</section>

<style>
.store-locator-section {
  padding: 4rem 1rem 6rem;
  background-color: var(--color-background, #f8ebd7);
  color: var(--color-foreground, #2d0f28);
}
.store-locator-container {
  max-width: 800px;
  margin: 0 auto;
}
.store-locator-header {
  text-align: center;
  margin-bottom: 2.5rem;
}
.locator-title {
  font-family: var(--font-primary, 'Champ Black', serif);
  font-size: clamp(2.25rem, 4.5vw, 3.5rem);
  color: var(--color-foreground, #2d0f28);
  margin: 0 0 0.75rem;
  text-transform: uppercase;
  line-height: 1.1;
}
.locator-sub {
  font-family: var(--font-body, 'Inter', sans-serif);
  font-size: 1.125rem;
  opacity: 0.85;
  margin: 0;
}
.store-available-soon-card {
  background-color: var(--color-cream, #fffbf2);
  border: 3px solid var(--color-foreground, #2d0f28);
  border-bottom-width: 6px;
  border-radius: var(--radius-2xl, 32px);
  padding: 3rem 2rem;
  text-align: center;
  box-shadow: 0 12px 30px rgba(45, 15, 40, 0.08);
  display: flex;
  flex-direction: column;
  align-items: center;
}
.store-badge-pill {
  display: inline-block;
  background-color: var(--color-accent-purple, #ca9af1);
  color: var(--color-foreground, #2d0f28);
  border: 2px solid var(--color-foreground, #2d0f28);
  border-radius: var(--radius-pill, 9999px);
  padding: 0.35rem 1rem;
  font-family: var(--font-primary, 'Champ Black', serif);
  font-size: 0.8125rem;
  letter-spacing: 0.05em;
  margin-bottom: 1.5rem;
}
.store-mascot-wrapper {
  margin-bottom: 1rem;
}
.store-mascot-img {
  width: 50px;
  height: auto;
}
.store-card-heading {
  font-family: var(--font-primary, 'Champ Black', serif);
  font-size: clamp(1.5rem, 3vw, 2rem);
  color: var(--color-foreground, #2d0f28);
  margin: 0 0 1rem;
  line-height: 1.2;
}
.store-card-text {
  font-family: var(--font-body, 'Inter', sans-serif);
  font-size: 1rem;
  line-height: 1.6;
  opacity: 0.9;
  max-width: 580px;
  margin: 0 0 2rem;
}
.store-actions-row {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  justify-content: center;
  width: 100%;
  margin-bottom: 2rem;
}
.store-btn-primary {
  padding: 0.875rem 2rem;
  font-size: 0.9375rem;
}
.store-btn-secondary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background-color: transparent;
  color: var(--color-foreground, #2d0f28);
  border: 2px solid var(--color-foreground, #2d0f28);
  border-radius: var(--radius-pill, 9999px);
  padding: 0.875rem 1.75rem;
  font-family: var(--font-primary, 'Champ Black', serif);
  font-size: 0.9375rem;
  text-decoration: none;
  transition: all 0.2s ease;
}
.store-btn-secondary:hover {
  background-color: var(--color-accent-yellow, #ffe8b3);
  transform: translateY(-2px);
}
.store-grocer-note {
  font-family: var(--font-secondary, 'Azeret Mono', monospace);
  font-size: 0.8125rem;
  opacity: 0.75;
  border-top: 1px dashed rgba(45, 15, 40, 0.25);
  padding-top: 1.5rem;
  width: 100%;
  max-width: 560px;
}
.store-grocer-note a {
  color: var(--color-foreground, #2d0f28);
  font-weight: 700;
  text-decoration: underline;
}
</style>

{% schema %}
{
  "name": "Store Locator",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FIND IN STORE"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Our retail launch is on the way."
    }
  ],
  "presets": [
    {
      "name": "Store Locator"
    }
  ]
}
{% endschema %}
