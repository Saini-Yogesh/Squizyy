{%- comment -%}
  Announcement Bar — Purple Rounded Pill Infinite Marquee
  Faithfully ported from client/src/components/layout/AnnouncementBar.jsx & AnnouncementBar.module.css
{%- endcomment -%}

{%- assign main_product = nil -%}
{%- if all_products['drizzy-squeezy-peanut-butter-19-4-oz'].title != blank -%}
  {%- assign main_product = all_products['drizzy-squeezy-peanut-butter-19-4-oz'] -%}
{%- elsif all_products['drizzy-peanut-butter'].title != blank -%}
  {%- assign main_product = all_products['drizzy-peanut-butter'] -%}
{%- elsif collections.all.products.first != blank -%}
  {%- assign main_product = collections.all.products.first -%}
{%- endif -%}

{%- if main_product != blank and main_product.url != blank -%}
  {%- assign buy_now_url = main_product.url -%}
{%- else -%}
  {%- assign buy_now_url = routes.all_products_collection_url -%}
{%- endif -%}

<div class="announcement-wrapper">
  <section class="announcement-section" aria-label="Announcement">
    <div class="announcement-container">
      <!-- Mobile View Marquee Pill -->
      <div class="announcement-mobile-marquee">
        <div class="announcement-track-wrapper">
          <div class="announcement-track">
            {%- for i in (1..3) -%}
              <a href="{{ buy_now_url }}" class="announcement-track-item">
                <span class="announcement-item-icon">
                  {%- if forloop.index == 2 -%}
                    <img src="{{ 'peanut-tiny_edb0d5dd-b629-429d-a3b9-ec4c93589cbb.png' | asset_url }}" alt="" width="80" height="73" loading="eager">
                  {%- else -%}
                    <img src="{{ 'Union.svg' | asset_url }}" alt="" width="80" height="80" loading="eager">
                  {%- endif -%}
                </span>
                <div class="announcement-item-text">
                  <span>{{ section.settings.text | default: 'FREE SHIPPING ON ORDERS $49.99+' }}</span>
                  <span class="announcement-buy-now">{{ section.settings.link_text | default: 'BUY NOW' }}</span>
                </div>
              </a>
            {%- endfor -%}
          </div>
          <div class="announcement-track" aria-hidden="true">
            {%- for i in (1..3) -%}
              <a href="{{ buy_now_url }}" class="announcement-track-item">
                <span class="announcement-item-icon">
                  {%- if forloop.index == 2 -%}
                    <img src="{{ 'peanut-tiny_edb0d5dd-b629-429d-a3b9-ec4c93589cbb.png' | asset_url }}" alt="" width="80" height="73" loading="eager">
                  {%- else -%}
                    <img src="{{ 'Union.svg' | asset_url }}" alt="" width="80" height="80" loading="eager">
                  {%- endif -%}
                </span>
                <div class="announcement-item-text">
                  <span>{{ section.settings.text | default: 'FREE SHIPPING ON ORDERS $49.99+' }}</span>
                  <span class="announcement-buy-now">{{ section.settings.link_text | default: 'BUY NOW' }}</span>
                </div>
              </a>
            {%- endfor -%}
          </div>
        </div>
      </div>

      <!-- Desktop View Marquee Pill -->
      <div class="announcement-desktop-marquee">
        <div class="announcement-track-wrapper">
          <div class="announcement-track">
            {%- for i in (1..6) -%}
              <a href="{{ buy_now_url }}" class="announcement-track-item">
                <span class="announcement-item-icon announcement-desktop-icon">
                  {%- assign mod = i | modulo: 2 -%}
                  {%- if mod == 0 -%}
                    <img src="{{ 'peanut-tiny_edb0d5dd-b629-429d-a3b9-ec4c93589cbb.png' | asset_url }}" alt="" width="80" height="73" loading="eager">
                  {%- else -%}
                    <img src="{{ 'Union.svg' | asset_url }}" alt="" width="80" height="80" loading="eager">
                  {%- endif -%}
                </span>
                <div class="announcement-item-text">
                  <span>{{ section.settings.text | default: 'FREE SHIPPING ON ORDERS $49.99+' }}</span>
                  <span class="announcement-buy-now">{{ section.settings.link_text | default: 'BUY NOW' }}</span>
                </div>
              </a>
            {%- endfor -%}
          </div>
          <div class="announcement-track" aria-hidden="true">
            {%- for i in (1..6) -%}
              <a href="{{ buy_now_url }}" class="announcement-track-item">
                <span class="announcement-item-icon announcement-desktop-icon">
                  {%- assign mod = i | modulo: 2 -%}
                  {%- if mod == 0 -%}
                    <img src="{{ 'peanut-tiny_edb0d5dd-b629-429d-a3b9-ec4c93589cbb.png' | asset_url }}" alt="" width="80" height="73" loading="eager">
                  {%- else -%}
                    <img src="{{ 'Union.svg' | asset_url }}" alt="" width="80" height="80" loading="eager">
                  {%- endif -%}
                </span>
                <div class="announcement-item-text">
                  <span>{{ section.settings.text | default: 'FREE SHIPPING ON ORDERS $49.99+' }}</span>
                  <span class="announcement-buy-now">{{ section.settings.link_text | default: 'BUY NOW' }}</span>
                </div>
              </a>
            {%- endfor -%}
          </div>
        </div>
      </div>
    </div>
  </section>
</div>

<style>
.announcement-wrapper {
  position: relative;
  width: 100%;
  z-index: 25;
}
.announcement-section {
  position: relative;
  display: flex;
  justify-content: center;
  background-color: var(--color-background, #f8ebd7);
  color: var(--color-foreground, #2d0f28);
  padding: 1rem 0 0 0;
}
.announcement-container {
  position: relative;
  width: 100%;
  max-width: var(--container-max-width, 1440px);
  padding: 0 1rem;
}
@media (min-width: 1024px) {
  .announcement-container {
    padding: 0 1.5rem;
  }
}
.announcement-mobile-marquee {
  display: block;
  text-transform: uppercase;
  padding: 0.375rem 0;
  background-color: var(--color-accent-purple, #ca9af1);
  border-radius: var(--radius-pill, 9999px);
  overflow: hidden;
}
@media (min-width: 1024px) {
  .announcement-mobile-marquee {
    display: none;
  }
}
.announcement-desktop-marquee {
  display: none;
  overflow: hidden;
  user-select: none;
  width: 100%;
  text-transform: uppercase;
  padding: 0.75rem 0;
  border-radius: var(--radius-pill, 9999px);
  background-color: var(--color-accent-purple, #ca9af1);
}
@media (min-width: 1024px) {
  .announcement-desktop-marquee {
    display: block;
  }
}
.announcement-track-wrapper {
  display: flex;
  white-space: nowrap;
}
.announcement-track {
  display: flex;
  align-items: center;
  justify-content: space-around;
  flex-shrink: 0;
  min-width: 100%;
  gap: 1rem;
  animation: announcement-marquee 44s linear infinite;
}
.announcement-track-item {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  padding: 0 1rem;
  text-decoration: none;
  color: var(--color-foreground, #2d0f28);
}
.announcement-item-icon {
  display: flex;
  align-items: center;
  width: 18px;
  height: auto;
  flex-shrink: 0;
}
.announcement-item-icon img {
  width: 100%;
  height: auto;
  display: block;
}
.announcement-desktop-icon {
  width: 23px;
  height: auto;
  flex-shrink: 0;
}
.announcement-item-text {
  display: flex;
  gap: 0.5rem;
  font-family: var(--font-secondary, 'Azeret Mono', monospace);
  font-size: 0.625rem;
  line-height: 1;
  font-weight: 500;
}
@media (min-width: 1024px) {
  .announcement-item-text {
    font-size: 0.75rem;
  }
}
.announcement-buy-now {
  text-decoration: underline;
  font-weight: 700;
}
@keyframes announcement-marquee {
  0% { transform: translateX(0); }
  100% { transform: translateX(-100%); }
}
</style>

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Announcement Text",
      "default": "FREE SHIPPING ON ORDERS $49.99+"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link Text",
      "default": "BUY NOW"
    }
  ]
}
{% endschema %}
