{%- comment -%}
  Main Blog Listing Section — Squizyy Brand Aesthetic (Enhanced & User-Friendly)
  Renders paginated grid of blog stories with natural casing, retro cream cards, and Champ Black typography.
{%- endcomment -%}

{%- paginate blog.articles by section.settings.posts_per_page -%}
<section class="blog-section">
  <div class="blog-container">
    <!-- Blog Header Banner -->
    <header class="blog-header">
      <span class="blog-pill-tag">The Squizyy Squeeze</span>
      <h1 class="blog-title">{{ blog.title | default: 'Stories & Recipes' }}</h1>
      <p class="blog-subtitle">All-natural peanut butter hacks, healthy drops, and news from behind the squeeze bottle.</p>
    </header>

    <!-- Articles Grid -->
    {%- if blog.articles.size > 0 -%}
      <div class="blog-grid">
        {%- for article in blog.articles -%}
          <article class="blog-card">
            <!-- Article Image Link -->
            <a href="{{ article.url }}" class="blog-card-image-link" aria-label="{{ article.title | escape }}">
              {%- if article.image != blank -%}
                <img
                  src="{{ article.image | image_url: width: 800 }}"
                  alt="{{ article.image.alt | default: article.title | escape }}"
                  class="blog-card-image"
                  width="{{ article.image.width }}"
                  height="{{ article.image.height }}"
                  loading="lazy"
                >
              {%- else -%}
                <div class="blog-card-image-placeholder">
                  <span class="blog-placeholder-logo">Squizyy™</span>
                </div>
              {%- endif -%}
            </a>

            <!-- Card Content -->
            <div class="blog-card-body">
              <div class="blog-card-meta">
                {%- if section.settings.show_date -%}
                  <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}" class="blog-card-date">
                    {{ article.published_at | date: "%B %d, %Y" }}
                  </time>
                {%- endif -%}

                {%- if section.settings.show_author and article.author != blank -%}
                  <span class="blog-meta-dot">•</span>
                  <span class="blog-card-author">By {{ article.author }}</span>
                {%- endif -%}
              </div>

              <h2 class="blog-card-title">
                <a href="{{ article.url }}">{{ article.title }}</a>
              </h2>

              <p class="blog-card-excerpt">
                {{ article.excerpt_or_content | strip_html | truncatewords: 24 }}
              </p>

              <div class="blog-card-footer">
                <a href="{{ article.url }}" class="blog-card-read-more">
                  <span>Read story</span>
                  <span class="read-more-arrow">→</span>
                </a>
              </div>
            </div>
          </article>
        {%- endfor -%}
      </div>

      <!-- Pagination -->
      {%- if paginate.pages > 1 -%}
        <div class="blog-pagination">
          {%- if paginate.previous -%}
            <a href="{{ paginate.previous.url }}" class="blog-page-btn prev">← Previous</a>
          {%- endif -%}

          <div class="blog-page-numbers">
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}
                <a href="{{ part.url }}" class="blog-page-num">{{ part.title }}</a>
              {%- else -%}
                <span class="blog-page-num active">{{ part.title }}</span>
              {%- endif -%}
            {%- endfor -%}
          </div>

          {%- if paginate.next -%}
            <a href="{{ paginate.next.url }}" class="blog-page-btn next">Next →</a>
          {%- endif -%}
        </div>
      {%- endif -%}

    {%- else -%}
      <!-- Empty Blog State -->
      <div class="blog-empty-card">
        <h2 class="blog-empty-title">No stories published yet</h2>
        <p class="blog-empty-desc">Check back soon for delicious peanut butter recipes, behind-the-scenes drops, and Squizyy announcements!</p>
        <a href="{{ routes.root_url }}" class="blog-empty-btn">Back to Home</a>
      </div>
    {%- endif -%}
  </div>
</section>
{%- endpaginate -%}

<style>
.blog-section {
  width: 100%;
  background-color: var(--color-background, #f8ebd7);
  padding: 3rem 1rem 7rem 1rem;
}
@media (min-width: 1024px) {
  .blog-section {
    padding: 4.5rem 1.5rem 8rem 1.5rem;
  }
}
.blog-container {
  margin: 0 auto;
  max-width: 76rem; /* ~1216px */
  box-sizing: border-box;
}

/* Header */
.blog-header {
  text-align: center;
  max-width: 48rem;
  margin: 0 auto 3.5rem auto;
}
.blog-pill-tag {
  display: inline-block;
  padding: 0.4rem 1.25rem;
  background-color: var(--color-accent-purple, #ca9af1);
  color: var(--color-foreground, #2d0f28);
  border: 2px solid var(--color-foreground, #2d0f28);
  border-radius: var(--radius-pill, 9999px);
  font-family: var(--font-secondary, 'Azeret Mono', monospace);
  font-size: 0.775rem;
  font-weight: 700;
  letter-spacing: 0.02em;
  margin-bottom: 1.25rem;
}
.blog-title {
  font-family: var(--font-primary, 'Champ Black', sans-serif);
  font-size: 2.75rem;
  line-height: 1.15;
  color: var(--color-foreground, #2d0f28);
  margin: 0 0 1rem 0;
  letter-spacing: -0.015em;
}
@media (min-width: 768px) {
  .blog-title {
    font-size: 3.75rem;
  }
}
.blog-subtitle {
  font-size: 1.15rem;
  line-height: 1.6;
  color: rgba(45, 15, 40, 0.8);
  margin: 0;
}

/* Grid */
.blog-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 2rem;
}
@media (min-width: 640px) {
  .blog-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}
@media (min-width: 1024px) {
  .blog-grid {
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
  }
}

/* Card */
.blog-card {
  background-color: var(--color-cream, #fffbf2);
  border: 4px solid var(--color-foreground, #2d0f28);
  border-bottom-width: 8px;
  border-radius: var(--radius-2xl, 32px);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
  box-shadow: 0 8px 24px rgba(45, 15, 40, 0.08);
}
.blog-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 16px 36px rgba(45, 15, 40, 0.14);
}

.blog-card-image-link {
  display: block;
  width: 100%;
  aspect-ratio: 16 / 10;
  overflow: hidden;
  border-bottom: 4px solid var(--color-foreground, #2d0f28);
  background-color: var(--color-accent-purple-light, #f4eaff);
}
.blog-card-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.3s ease;
  display: block;
}
.blog-card:hover .blog-card-image {
  transform: scale(1.04);
}
.blog-card-image-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--color-accent-purple, #ca9af1);
}
.blog-placeholder-logo {
  font-family: var(--font-primary, 'Champ Black', sans-serif);
  font-size: 2rem;
  font-weight: 900;
  color: var(--color-foreground, #2d0f28);
}

/* Card Body */
.blog-card-body {
  padding: 1.75rem 1.5rem;
  display: flex;
  flex-direction: column;
  flex: 1 1 0%;
}
.blog-card-meta {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-family: var(--font-secondary, 'Azeret Mono', monospace);
  font-size: 0.775rem;
  font-weight: 700;
  color: rgba(45, 15, 40, 0.7);
  margin-bottom: 0.75rem;
}
.blog-meta-dot {
  opacity: 0.4;
}
.blog-card-title {
  font-family: var(--font-primary, 'Champ Black', sans-serif);
  font-size: 1.45rem;
  line-height: 1.25;
  margin: 0 0 0.85rem 0;
  letter-spacing: -0.01em;
}
.blog-card-title a {
  color: var(--color-foreground, #2d0f28);
  text-decoration: none;
  transition: color 0.15s ease;
}
.blog-card-title a:hover {
  color: var(--color-brown, #894031);
}
.blog-card-excerpt {
  font-size: 0.975rem;
  line-height: 1.6;
  color: rgba(45, 15, 40, 0.85);
  margin: 0 0 1.5rem 0;
  flex: 1 1 0%;
}

.blog-card-footer {
  margin-top: auto;
  padding-top: 1rem;
  border-top: 1.5px dashed rgba(45, 15, 40, 0.18);
}
.blog-card-read-more {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  font-family: var(--font-primary, 'Champ Black', sans-serif);
  font-size: 1rem;
  font-weight: 900;
  color: var(--color-foreground, #2d0f28);
  text-decoration: none;
  transition: transform 0.15s ease;
}
.blog-card-read-more:hover {
  transform: translateX(4px);
  color: var(--color-brown, #894031);
}
.read-more-arrow {
  font-size: 1.15rem;
  transition: transform 0.15s ease;
}
.blog-card-read-more:hover .read-more-arrow {
  transform: translateX(2px);
}

/* Pagination */
.blog-pagination {
  margin-top: 4.5rem;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 1rem;
  flex-wrap: wrap;
}
.blog-page-btn {
  display: inline-flex;
  align-items: center;
  padding: 0.65rem 1.4rem;
  background-color: var(--color-cream, #fffbf2);
  border: 2px solid var(--color-foreground, #2d0f28);
  border-bottom: 4px solid var(--color-foreground, #2d0f28);
  border-radius: var(--radius-pill, 9999px);
  font-family: var(--font-primary, 'Champ Black', sans-serif);
  font-size: 0.95rem;
  font-weight: 900;
  color: var(--color-foreground, #2d0f28);
  text-decoration: none;
  transition: all 0.15s ease;
}
.blog-page-btn:hover {
  background-color: var(--color-accent-purple, #ca9af1);
  transform: translateY(-2px);
}
.blog-page-numbers {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}
.blog-page-num {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 2.4rem;
  height: 2.4rem;
  border-radius: 50%;
  border: 2px solid var(--color-foreground, #2d0f28);
  font-family: var(--font-primary, 'Champ Black', sans-serif);
  font-size: 0.95rem;
  font-weight: 900;
  color: var(--color-foreground, #2d0f28);
  text-decoration: none;
  background-color: var(--color-cream, #fffbf2);
  transition: all 0.15s ease;
}
.blog-page-num:hover {
  background-color: var(--color-accent-purple, #ca9af1);
}
.blog-page-num.active {
  background-color: var(--color-accent-purple, #ca9af1);
  box-shadow: 0 2px 0 var(--color-foreground, #2d0f28);
}

/* Empty State */
.blog-empty-card {
  max-width: 36rem;
  margin: 3rem auto;
  background-color: var(--color-cream, #fffbf2);
  border: 4px solid var(--color-foreground, #2d0f28);
  border-bottom-width: 8px;
  border-radius: var(--radius-2xl, 32px);
  padding: 3.5rem 2rem;
  text-align: center;
}
.blog-empty-title {
  font-family: var(--font-primary, 'Champ Black', sans-serif);
  font-size: 2rem;
  color: var(--color-foreground, #2d0f28);
  margin: 0 0 1rem 0;
}
.blog-empty-desc {
  font-size: 1rem;
  line-height: 1.6;
  color: rgba(45, 15, 40, 0.8);
  margin: 0 0 2rem 0;
}
.blog-empty-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0.85rem 2rem;
  background-color: var(--color-accent-purple, #ca9af1);
  color: var(--color-foreground, #2d0f28);
  border: 2px solid var(--color-foreground, #2d0f28);
  border-bottom: 4px solid var(--color-foreground, #2d0f28);
  border-radius: var(--radius-pill, 9999px);
  font-family: var(--font-primary, 'Champ Black', sans-serif);
  font-size: 1rem;
  font-weight: 900;
  text-decoration: none;
  transition: all 0.15s ease;
}
.blog-empty-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(45, 15, 40, 0.15);
}
</style>

{% schema %}
{
  "name": "Blog Listing",
  "settings": [
    {
      "type": "range",
      "id": "posts_per_page",
      "min": 3,
      "max": 18,
      "step": 3,
      "default": 9,
      "label": "Posts Per Page"
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show Date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show Author",
      "default": true
    }
  ]
}
{% endschema %}
