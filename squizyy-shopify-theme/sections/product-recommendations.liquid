<section
  class="product-recommendations-section"
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit=4"
>
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div class="product-recommendations-container">
      <h2 class="product-recommendations-title">
        {{ section.settings.heading | default: 'You May Also Like' }}
      </h2>

      <div class="product-recommendations-grid">
        {%- for recommendation in recommendations.products -%}
          {% render 'product-card', product: recommendation %}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</section>

<script>
document.addEventListener('DOMContentLoaded', function() {
  var section = document.querySelector('.product-recommendations-section');
  if (section && section.dataset.url) {
    fetch(section.dataset.url)
      .then(function(res) { return res.text(); })
      .then(function(html) {
        var div = document.createElement('div');
        div.innerHTML = html;
        var recommendations = div.querySelector('.product-recommendations-section');
        if (recommendations && recommendations.innerHTML.trim().length) {
          section.innerHTML = recommendations.innerHTML;
        }
      })
      .catch(function(err) { console.error('Failed to load recommendations', err); });
  }
});
</script>

<style>
.product-recommendations-section {
  background-color: var(--color-background, #fffaf3);
  padding: 4rem 1rem 6rem 1rem;
}
@media (min-width: 1024px) {
  .product-recommendations-section {
    padding: 5rem 1.5rem 8rem 1.5rem;
  }
}
.product-recommendations-container {
  max-width: 87.5rem;
  margin: 0 auto;
}
.product-recommendations-title {
  font-family: var(--font-primary, 'Champ Black', serif);
  font-size: 2.25rem;
  line-height: 1.1;
  text-transform: uppercase;
  color: var(--color-dark-brown, #2b1408);
  margin: 0 0 2.5rem 0;
  text-align: center;
}
@media (min-width: 640px) {
  .product-recommendations-title {
    font-size: 3rem;
  }
}
.product-recommendations-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1.5rem;
}
@media (min-width: 640px) {
  .product-recommendations-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }
}
@media (min-width: 1024px) {
  .product-recommendations-grid {
    grid-template-columns: repeat(4, 1fr);
  }
}
</style>

{% schema %}
{
  "name": "Product Recommendations",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You May Also Like"
    }
  ],
  "presets": [
    {
      "name": "Product Recommendations"
    }
  ]
}
{% endschema %}
