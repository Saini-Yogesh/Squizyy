<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_bg | default: '#f8ebd7' }}">

    {%- comment -%} Instant redirect from /products/all and /products to collections/all {%- endcomment -%}
    <script>
      (function() {
        var p = window.location.pathname.toLowerCase().replace(/\/+$/, '');
        if (p === '/products/all' || p === '/products' || p.indexOf('/products/all') === 0) {
          window.location.replace('/collections/all');
        }
      })();
    </script>
    {%- if request.path == '/products/all' or request.path == '/products/all/' or request.path == '/products' or request.path == '/products/' -%}
      <meta http-equiv="refresh" content="0;url={{ routes.all_products_collection_url }}">
    {%- endif -%}

    {% render 'seo-meta' %}

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
      <link rel="shortcut icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {%- else -%}
      <link rel="icon" type="image/png" href="{{ 'sticker.png' | asset_url }}">
      <link rel="shortcut icon" type="image/png" href="{{ 'sticker.png' | asset_url }}">
      <link rel="apple-touch-icon" href="{{ 'sticker.png' | asset_url }}">
    {%- endif -%}

    <!-- Brand Typography Assets (Shopify CDN Hosted) -->
    <style>
      @font-face {
        font-family: 'Champ Black';
        src: url("{{ 'Champ-Black.otf' | asset_url }}") format('opentype');
        font-weight: 900;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Champ Black';
        src: url("{{ 'Champ-Black.otf' | asset_url }}") format('opentype');
        font-weight: 700;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Champ Black';
        src: url("{{ 'Champ-Black.otf' | asset_url }}") format('opentype');
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Champ Black';
        src: url("{{ 'Champ-Black.otf' | asset_url }}") format('opentype');
        font-weight: normal;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Azeret Mono';
        src: url("{{ 'AzeretMono-VariableFont.ttf' | asset_url }}") format('truetype');
        font-weight: 500;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Azeret Mono';
        src: url("{{ 'AzeretMono-VariableFont.ttf' | asset_url }}") format('truetype');
        font-weight: 700;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Azeret Mono';
        src: url("{{ 'AzeretMono-VariableFont.ttf' | asset_url }}") format('truetype');
        font-weight: 100 900;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Inter';
        src: url("{{ 'inter_n4.b2a3f24c19b4de56e8871f609e73ca7f6d2e2bb9.woff2' | asset_url }}") format('woff2');
        font-weight: 400 500;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Inter';
        src: url("{{ 'inter_n7.02711e6b374660cfc7915d1afc1c204e633421e4.woff2' | asset_url }}") format('woff2');
        font-weight: 600 900;
        font-style: normal;
        font-display: swap;
      }
    </style>

    <!-- CSS Bundles -->
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ 'animations.css' | asset_url | stylesheet_tag }}
    {{ 'responsive.css' | asset_url | stylesheet_tag }}

    <script>
      window.themeSettings = {
        freeShippingThreshold: {{ settings.free_shipping_threshold | default: 49900 }},
        moneyFormat: {{ shop.money_format | json }}
      };
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');

      // Strip any unwanted #contact_form hash from URL to prevent automatic page jump/scroll
      if (window.location.hash === '#contact_form' || window.location.hash === '#ContactForm') {
        if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
        history.replaceState(null, null, window.location.pathname + window.location.search);
        window.scrollTo(0, 0);
      }
    </script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name }} page-{{ page.handle | default: 'home' }}">
    <a class="skip-to-content-link button" href="#MainContent">
      {{ 'general.skip_to_content' | t | default: 'Skip to content' }}
    </a>

    <div class="page-wrapper">
      {% section 'announcement-bar' %}
      {% section 'header' %}

      <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
        {{ content_for_layout }}
      </main>

      {% section 'footer' %}
    </div>

    <!-- Modals & Drawers -->
    {% render 'cart-drawer' %}
    {% render 'newsletter-modal' %}

    <!-- Theme Scripts -->
    <script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'product.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'custom.js' | asset_url }}" defer="defer"></script>
  </body>
</html>
