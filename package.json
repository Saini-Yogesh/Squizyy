{
  "name": "drizzy",
  "version": "1.0.0",
  "private": true,
  "description": "Drizzy 1:1 Full-Stack Application (Client + Server)",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"yellow.bold,magenta.bold\" \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "start": "concurrently -n \"SERVER,CLIENT\" -c \"yellow.bold,magenta.bold\" \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "client": "npm run dev --prefix client",
    "client:build": "npm run build --prefix client",
    "server": "npm run dev --prefix server",
    "server:start": "npm start --prefix server",
    "install:all": "npm install && npm install --prefix server && npm install --prefix client",
    "theme:check": "shopify theme check --path squizyy-shopify-theme",
    "theme:push": "shopify theme push --path squizyy-shopify-theme --store=squizyy-store.myshopify.com --theme=144876961855 --allow-live --nodelete",
    "theme:dev": "shopify theme dev --path squizyy-shopify-theme --store=squizyy-store.myshopify.com",
    "theme:test": "node scripts/test-live-store.js",
    "theme:audit": "node scripts/test-theme-links.js",
    "doc:verify": "node scripts/verify-ai-docs.js"
  },
  "devDependencies": {
    "@shopify/cli": "^4.9.4",
    "concurrently": "^9.1.0"
  }
}
